{
  "manifest_version": 2,
  "name": "FrameOS live camera",
  "version": "1.0.3",
  "browser_specific_settings": { "gecko": { "id": "frame-live-camera@wyattfleming.com" } },
  "permissions": ["nativeMessaging", "geckoViewAddons", "https://*/*", "http://*/*"],
  "content_security_policy": "script-src 'self'; object-src 'self'; connect-src https: wss:"
}
