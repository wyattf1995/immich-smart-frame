+// offlineScopeMu prevents a request from observing the old pool while a
+// changed origin/user/device/profile is replacing it. The manifest is private
+// metadata and deliberately contains no API key.
+var offlineScopeMu sync.Mutex
+
+type offlineCacheScopeToken struct {
+	generation uint64
+	manifest   string
+}
+
+func offlineCacheScope(requestConfig config.Config, deviceID string) string {
+	return offlineCacheScopeAtGeneration(requestConfig, deviceID, cache.CurrentGeneration())
+}
+
+func offlineCacheScopeAtGeneration(requestConfig config.Config, deviceID string, generation uint64) string {
+	configHash := sha256.Sum256([]byte(requestConfig.SanitizedYaml()))
+	scope := strings.Join([]string{
+		fmt.Sprintf("generation=%s:%d", KioskVersion, generation),
+		"origin=" + requestConfig.ImmichURL,
+		"user=" + requestConfig.SelectedUser,
+		"device=" + deviceID,
+		"profile=" + requestConfig.CurationProfile,
+		"config_sha256=" + hex.EncodeToString(configHash[:]),
+	}, "\x00")
+	scopeHash := sha256.Sum256([]byte(scope))
+	return "schema=1\nscope_sha256=" + hex.EncodeToString(scopeHash[:]) + "\n"
+}
+
+func newOfflineCacheScopeToken(requestConfig config.Config, deviceID string) offlineCacheScopeToken {
+	generation := cache.CurrentGeneration()
+	return offlineCacheScopeToken{
+		generation: generation,
+		manifest:   offlineCacheScopeAtGeneration(requestConfig, deviceID, generation),
+	}
+}
+
+func offlineCacheScopeCurrentLocked(token offlineCacheScopeToken) bool {
+	if cache.CurrentGeneration() != token.generation {
+		return false
+	}
+	current, err := os.ReadFile(filepath.Join(OfflineAssetsPath, OfflineManifestFilename))
+	return err == nil && string(current) == token.manifest
+}
+
+func offlineCacheScopeCurrent(token offlineCacheScopeToken) bool {
+	offlineScopeMu.Lock()
+	current := offlineCacheScopeCurrentLocked(token)
+	offlineScopeMu.Unlock()
+	return current
+}
+
+// ensureOfflineCacheScope removes a pool created for another origin, user,
+// device, profile, config, or kiosk generation before it can be served.
+func ensureOfflineCacheScope(requestConfig config.Config, deviceID string) error {
+	return ensureOfflineCacheScopeExpected(offlineCacheScope(requestConfig, deviceID))
+}
+
+func ensureOfflineCacheScopeExpected(expected string) error {
+	manifestPath := filepath.Join(OfflineAssetsPath, OfflineManifestFilename)
+	if current, err := os.ReadFile(manifestPath); err == nil && string(current) == expected {
+		return nil
+	}
+	if err := utils.CleanDirectory(OfflineAssetsPath); err != nil {
+		return err
+	}
+	tmpPath := manifestPath + ".tmp"
+	if err := os.WriteFile(tmpPath, []byte(expected), 0o600); err != nil {
+		return err
+	}
+	return os.Rename(tmpPath, manifestPath)
+}
+
+func writeOfflineExpirationIfScope(token offlineCacheScopeToken, expiration time.Time) error {
+	offlineScopeMu.Lock()
+	if !offlineCacheScopeCurrentLocked(token) {
+		offlineScopeMu.Unlock()
+		return ErrOfflineScopeInvalidated
+	}
+	err := os.WriteFile(
+		filepath.Join(OfflineAssetsPath, OfflineExpirationFilename),
+		[]byte(expiration.Format(time.RFC3339)),
+		0o600,
+	)
+	offlineScopeMu.Unlock()
+	return err
+}
+
+// InvalidateOfflineAssets is called after a successful curation mutation or
+// explicit cache flush. The next request rebuilds the pool under its scope.
+func InvalidateOfflineAssets() {
+	offlineScopeMu.Lock()
+	err := utils.CleanDirectory(OfflineAssetsPath)
+	offlineScopeMu.Unlock()
+	if err != nil {
+		log.Warn("failed to invalidate offline assets", "err", err)
+	}
+}
