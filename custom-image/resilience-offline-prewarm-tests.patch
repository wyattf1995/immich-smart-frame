+
+func TestOfflinePrewarmIsDeduplicatedShutdownBoundedAndDrained(t *testing.T) {
+	oldAssetScheduler := assetPrefetchScheduler
+	oldOfflineScheduler := offlinePrefetchScheduler
+	assetPrefetchScheduler = newPrefetchScheduler(1, time.Second)
+	offlinePrefetchScheduler = newPrefetchScheduler(1, offlinePrefetchDeadline)
+	t.Cleanup(func() {
+		assetPrefetchScheduler = oldAssetScheduler
+		offlinePrefetchScheduler = oldOfflineScheduler
+	})
+
+	parent, cancel := context.WithCancel(context.Background())
+	var scheduled atomic.Int32
+	var workers atomic.Int32
+	started := make(chan struct{})
+	for range 50 {
+		if offlinePrefetchScheduler.scheduleWithContext(parent, offlinePrewarmKey, func(ctx context.Context) {
+			workers.Add(1)
+			close(started)
+			<-ctx.Done()
+		}) {
+			scheduled.Add(1)
+		}
+	}
+	<-started
+	require.EqualValues(t, 1, scheduled.Load(), "only one worker is created; repeated slides are deduplicated")
+	require.EqualValues(t, 1, workers.Load())
+
+	assetStarted := make(chan struct{})
+	require.True(t, assetPrefetchScheduler.scheduleWithContext(parent, "asset", func(ctx context.Context) {
+		close(assetStarted)
+		<-ctx.Done()
+	}))
+	<-assetStarted
+	cancel()
+	drainCtx, drainCancel := context.WithTimeout(context.Background(), time.Second)
+	defer drainCancel()
+	require.True(t, DrainAssetPrefetch(drainCtx))
+}

