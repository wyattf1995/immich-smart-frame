+package cache
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+
+	"github.com/damongolding/immich-kiosk/internal/config"
+)
+
+func TestAssetToCacheHonorsCacheDisabled(t *testing.T) {
+	Flush()
+	AssetToCache("sensitive", &config.Config{Kiosk: config.KioskSettings{Cache: false}}, "device", "url")
+	if ItemCount() != 0 {
+		t.Fatal("view data was cached while caching was disabled")
+	}
+}
+
+func TestGenerationInvalidatesOldNamespace(t *testing.T) {
+	Flush()
+	oldKey := APICacheKey("https://immich.example", "device", "user")
+	Set(oldKey, []byte("old"), 60, 60)
+	InvalidateAll()
+	newKey := APICacheKey("https://immich.example", "device", "user")
+	if oldKey == newKey {
+		t.Fatal("cache generation did not change the API namespace")
+	}
+	if _, found := Get(oldKey); found {
+		t.Fatal("old-generation cache entry remained reachable")
+	}
+}
+
+func TestViewCacheKeySeparatesSelectedUsers(t *testing.T) {
+	if ViewCacheKey("/asset", "device", "alice") == ViewCacheKey("/asset", "device", "bob") {
+		t.Fatal("view cache key does not isolate selected users")
+	}
+}
+
+func TestOldGenerationCannotRefillAfterInvalidation(t *testing.T) {
+	Flush()
+	oldGeneration := CurrentGeneration()
+	key := APICacheKey("https://immich.example", "device", "user")
+	InvalidateAll()
+	if SetIfGeneration(oldGeneration, key, []byte("stale"), 60, 60) {
+		t.Fatal("stale generation write was accepted")
+	}
+	if _, found := Get(key); found {
+		t.Fatal("stale response repopulated the cache")
+	}
+}
+
+func TestUpdateAppendsWithoutLostConcurrentWrites(t *testing.T) {
+	Flush()
+	key := "atomic-append"
+	const writers = 100
+	var wg sync.WaitGroup
+	for i := range writers {
+		wg.Add(1)
+		go func(value int) {
+			defer wg.Done()
+			Update(key, func(values []int) []int { return append(values, value) }, 60, 60)
+		}(i)
+	}
+	wg.Wait()
+	cached, found := Get(key)
+	if !found {
+		t.Fatal("atomic queue was not stored")
+	}
+	values, ok := cached.([]int)
+	if !ok || len(values) != writers {
+		t.Fatalf("got %T with %d values, want %d", cached, len(values), writers)
+	}
+}
+
+func TestPopConsumesEachQueueItemOnce(t *testing.T) {
+	Flush()
+	key := "atomic-pop"
+	items := make([]int, 50)
+	for i := range items {
+		items[i] = i
+	}
+	Set(key, items, 60, 60)
+	seen := make(chan int, len(items))
+	var wg sync.WaitGroup
+	for range items {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if item, ok := Pop[int](key, 60, 60); ok {
+				seen <- item
+			}
+		}()
+	}
+	wg.Wait()
+	close(seen)
+	got := make(map[int]struct{}, len(items))
+	for item := range seen {
+		got[item] = struct{}{}
+	}
+	if len(got) != len(items) {
+		t.Fatalf("consumed %d unique items, want %d", len(got), len(items))
+	}
+}
+
+func TestCacheBoundsValueAndCardinality(t *testing.T) {
+	Flush()
+	Set("oversized", make([]byte, maxCacheValueSize+1), 60, 60)
+	if _, found := Get("oversized"); found {
+		t.Fatal("oversized value was admitted")
+	}
+	for i := range maxCacheEntries + 10 {
+		Set(fmt.Sprintf("bounded-%d", i), i, 60, 60)
+	}
+	if count := ItemCount(); count > maxCacheEntries {
+		t.Fatalf("cache grew to %d entries, limit is %d", count, maxCacheEntries)
+	}
+}
