@@ -0,0 +1,15 @@
+package config
+
+import (
+	"sync/atomic"
+	"testing"
+)
+
+func TestReloadHooksAreNotified(t *testing.T) {
+	var calls atomic.Int32
+	RegisterReloadHook(func() { calls.Add(1) })
+	notifyReloadHooks()
+	if calls.Load() != 1 {
+		t.Fatalf("reload hook called %d times, want once", calls.Load())
+	}
+}
