+package immich
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/damongolding/immich-kiosk/internal/cache"
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAlbumRestrictionKeyUsesConfigurationContent(t *testing.T) {
+	left := config.Config{
+		CurationProfile: "Home",
+		ExcludedAlbums:  []string{"album-b", "album-a"},
+		Curation: config.CurationSettings{Profiles: map[string]config.CurationProfile{
+			"Home": {AlbumPenalties: []config.AlbumPenalty{{Album: "album-c", Factor: .5}}},
+		}},
+	}
+	right := config.Config{
+		CurationProfile: " home ",
+		ExcludedAlbums:  []string{"album-a", "album-b"},
+		Curation: config.CurationSettings{Profiles: map[string]config.CurationProfile{
+			"Home": {AlbumPenalties: []config.AlbumPenalty{{Album: "album-c", Factor: .5}}},
+		}},
+	}
+	require.Equal(t, albumRestrictionKey(left), albumRestrictionKey(right))
+}
+
+func TestMemoriesPastDaysDoesNotPopulateCacheWhenDisabled(t *testing.T) {
+	cache.Flush()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte("[]"))
+	}))
+	defer server.Close()
+
+	asset := New(context.Background(), config.Config{
+		ImmichURL: server.URL,
+		Kiosk:     config.KioskSettings{Cache: false},
+	})
+	_, _, err := asset.MemoriesWithPastDays("request", "device", 1)
+	require.NoError(t, err)
+	require.Zero(t, cache.ItemCount())
+}
+
+func TestCacheInvalidationClearsDateCandidatePools(t *testing.T) {
+	dateCandidatePools = newDatePoolRegistry(4)
+	_, _, err := dateCandidatePools.take(context.Background(), "date-key", 0, func(context.Context) ([]Asset, error) {
+		return []Asset{{ID: "asset"}}, nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, 1, dateCandidatePools.size())
+	cache.InvalidateAll()
+	require.Zero(t, dateCandidatePools.size())
+}
