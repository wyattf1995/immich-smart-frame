+package video
+
+import (
+	"testing"
+	"time"
+)
+
+func TestGetVideoPersistsLastAccessed(t *testing.T) {
+	manager := &Manager{Videos: []Video{{ID: "video", LastAccessed: time.Time{}}}}
+	got, err := manager.GetVideo("video")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.LastAccessed.IsZero() || manager.Videos[0].LastAccessed.IsZero() {
+		t.Fatal("GetVideo did not persist LastAccessed on the manager entry")
+	}
+}
