diff --git a/internal/routes/routes_render_memory.go b/internal/routes/routes_render_memory.go
new file mode 100644
index 0000000..229892f
--- /dev/null
+++ b/internal/routes/routes_render_memory.go
@@ -0,0 +1,79 @@
+package routes
+
+import (
+	"context"
+	"sync/atomic"
+	"time"
+
+	"charm.land/log/v2"
+	"github.com/damongolding/immich-kiosk/internal/cache"
+	"github.com/damongolding/immich-kiosk/internal/immich"
+)
+
+// RenderMemoryMetrics is intentionally aggregate-only: it exposes no asset,
+// user, or device identifiers while making cgroup tuning observable.
+func RenderMemoryMetrics() map[string]int64 {
+	return map[string]int64{
+		"cache_bytes":                         cache.ByteSize(),
+		"cache_evictions_total":               cache.Evictions(),
+		"image_work_admissions_total":         imageWorkAdmissions.Load(),
+		"image_work_wait_nanoseconds_total":   imageWorkWaitNanos.Load(),
+		"image_work_render_nanoseconds_total": imageWorkRenderNanos.Load(),
+	}
+}
+
+// A decoded camera original can be hundreds of MiB before it is resized. Keep
+// one complete decode/render pipeline in flight in a 1 GiB kiosk container.
+// Foreground, prefetch, and offline generation all share this gate.
+const maxOriginalDecodePixels int64 = 16_000_000
+
+type imageWorkGate struct {
+	tokens chan struct{}
+}
+
+func newImageWorkGate(concurrency int) *imageWorkGate {
+	return &imageWorkGate{tokens: make(chan struct{}, concurrency)}
+}
+
+func (g *imageWorkGate) withWork(ctx context.Context, work func() error) error {
+	started := time.Now()
+	select {
+	case g.tokens <- struct{}{}:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	imageWorkWaitNanos.Add(time.Since(started).Nanoseconds())
+	imageWorkAdmissions.Add(1)
+	defer func() { <-g.tokens }()
+
+	renderStarted := time.Now()
+	err := work()
+	imageWorkRenderNanos.Add(time.Since(renderStarted).Nanoseconds())
+	return err
+}
+
+var (
+	imageWorkGateGlobal  = newImageWorkGate(1)
+	imageWorkAdmissions  atomic.Int64
+	imageWorkWaitNanos   atomic.Int64
+	imageWorkRenderNanos atomic.Int64
+)
+
+// shouldFetchOriginal keeps quality for ordinary originals, but requests
+// Immich's preview derivative before a source can exceed the renderer budget.
+// Unknown dimensions are untrusted, so they also use the derivative.
+func shouldFetchOriginal(asset *immich.Asset) bool {
+	if asset == nil {
+		return false
+	}
+	width := int64(asset.ExifInfo.ExifImageWidth)
+	height := int64(asset.ExifInfo.ExifImageHeight)
+	if width <= 0 || height <= 0 {
+		return false
+	}
+	if width > maxOriginalDecodePixels/height {
+		log.Warn("using Immich preview for oversized original", "asset", asset.ID, "width", width, "height", height)
+		return false
+	}
+	return width*height < maxOriginalDecodePixels
+}
