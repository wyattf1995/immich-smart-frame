+)
+
+func TestDatePoolShuffleBagServesEveryAssetOncePerPass(t *testing.T) {
+	now := time.Unix(1_000, 0)
+	registry := newDatePoolRegistryWithClock(4, func() time.Time { return now })
+
+	population := make([]Asset, 10)
+	for index := range population {
+		population[index] = Asset{ID: fmt.Sprintf("asset-%d", index)}
+	}
+	fetch := func(context.Context) ([]Asset, error) { return slices.Clone(population), nil }
+
+	counts := map[string]int{}
+	for cycle := 1; cycle <= 3; cycle++ {
+		for range population {
+			asset, ok, err := registry.take(context.Background(), "key", time.Minute, false, fetch)
+			require.NoError(t, err)
+			require.True(t, ok)
+			counts[asset.ID]++
+			require.Equal(t, cycle, counts[asset.ID], "asset %q repeated before pass %d finished", asset.ID, cycle)
+			now = now.Add(2 * time.Minute) // expire the TTL between every take
+		}
+		require.Len(t, counts, len(population))
+	}
+}
+
+func TestDatePoolFailedRefreshPreservesUnservedCandidates(t *testing.T) {
+	now := time.Unix(1_000, 0)
+	clock := func() time.Time { return now }
+	pool := &dateCandidatePool{}
+
+	first, ok, err := pool.takeOrRefill(context.Background(), time.Minute, clock, false, func(context.Context) ([]Asset, error) {
+		return []Asset{{ID: "one"}, {ID: "two"}, {ID: "three"}}, nil
+	})
+	require.NoError(t, err)
+	require.True(t, ok)
+
+	now = now.Add(2 * time.Minute) // TTL expires with two unserved candidates left
+	fetchFailure := errors.New("immich unavailable")
+	_, ok, err = pool.takeOrRefill(context.Background(), time.Minute, clock, false, func(context.Context) ([]Asset, error) {
+		return nil, fetchFailure
+	})
+	require.ErrorIs(t, err, fetchFailure)
+	require.False(t, ok)
+
+	served := map[string]bool{first.ID: true}
+	for range 2 {
+		asset, takeOK, takeErr := pool.takeOrRefill(context.Background(), time.Minute, clock, false, func(context.Context) ([]Asset, error) {
+			return nil, nil
+		})
+		require.NoError(t, takeErr)
+		require.True(t, takeOK, "candidates surviving a failed refresh must still be served")
+		require.False(t, served[asset.ID], "candidate %q was served twice", asset.ID)
+		served[asset.ID] = true
+	}
+	require.Len(t, served, 3)
+}
+
+func TestRandomAssetInDateRangeWidensWindowBelowMinimum(t *testing.T) {
+	cache.Initialize()
+	dateCandidatePools = newDatePoolRegistry(defaultDatePoolRegistrySize)
+	var searchCalls atomic.Int32
+	server := wideningDateAssetServer(t, &searchCalls)
+	defer server.Close()
+
+	requestConfig := config.Config{ImmichURL: server.URL, Kiosk: config.KioskSettings{Cache: true, FetchedAssetsSize: 100, DatePoolMinimum: 50}}
+	asset := New(context.Background(), requestConfig)
+	require.NoError(t, asset.RandomAssetInDateRange("last-30", "request", "device", false))
+	require.EqualValues(t, 2, searchCalls.Load(), "a below-minimum fetch must trigger exactly one widened refetch")
+	require.True(t, strings.HasPrefix(asset.ID, "wide-"), "asset %q must come from the widened window", asset.ID)
+}
+
+func TestRandomAssetInDateRangeNoWideningWhenDisabled(t *testing.T) {
+	cache.Initialize()
+	dateCandidatePools = newDatePoolRegistry(defaultDatePoolRegistrySize)
+	var searchCalls atomic.Int32
+	server := wideningDateAssetServer(t, &searchCalls)
+	defer server.Close()
+
+	requestConfig := config.Config{ImmichURL: server.URL, Kiosk: config.KioskSettings{Cache: true, FetchedAssetsSize: 100}}
+	asset := New(context.Background(), requestConfig)
+	require.NoError(t, asset.RandomAssetInDateRange("last-30", "request", "device", false))
+	require.EqualValues(t, 1, searchCalls.Load(), "date_pool_minimum=0 must never widen")
+	require.True(t, strings.HasPrefix(asset.ID, "narrow-"), "asset %q must come from the original window", asset.ID)
+}
+
+func TestSessionSpreadPickWeighsCaptureHoursEqually(t *testing.T) {
+	singletonFirst := 0
+	for range 400 {
+		candidates := sessionSpreadCandidates()
+		if pickDateCandidate(&candidates, true).ID == "singleton" {
+			singletonFirst++
+		}
+	}
+	require.GreaterOrEqual(t, singletonFirst, 120, "singleton hour picked first too rarely")
+	require.LessOrEqual(t, singletonFirst, 280, "singleton hour picked first too often")
+}
+
+func TestSessionSpreadPickDrainsEveryCandidateOnce(t *testing.T) {
+	candidates := sessionSpreadCandidates()
+	total := len(candidates)
+	seen := map[string]bool{}
+	for range total {
+		asset := pickDateCandidate(&candidates, true)
+		require.False(t, seen[asset.ID], "candidate %q was drawn twice", asset.ID)
+		seen[asset.ID] = true
+	}
+	require.Empty(t, candidates)
+	require.Len(t, seen, total)
+}
+
+func TestSessionSpreadDisabledPreservesPopOrder(t *testing.T) {
+	candidates := []Asset{{ID: "one"}, {ID: "two"}, {ID: "three"}}
+	require.Equal(t, "three", pickDateCandidate(&candidates, false).ID)
+	require.Equal(t, "two", pickDateCandidate(&candidates, false).ID)
+	require.Equal(t, "one", pickDateCandidate(&candidates, false).ID)
+	require.Empty(t, candidates)
+}
+
+// sessionSpreadCandidates builds one lone photo in one capture hour and a
+// 99-photo burst in another.
+func sessionSpreadCandidates() []Asset {
+	base := time.Date(2026, 3, 1, 10, 0, 0, 0, time.UTC)
+	candidates := make([]Asset, 0, 100)
+	candidates = append(candidates, Asset{ID: "singleton", LocalDateTime: base})
+	burst := base.Add(6 * time.Hour)
+	for index := range 99 {
+		candidates = append(candidates, Asset{ID: fmt.Sprintf("burst-%d", index), LocalDateTime: burst.Add(time.Duration(index) * time.Second)})
+	}
+	return candidates
+}
+
+// wideningDateAssetServer returns 5 assets for a window of roughly 30 days and
+// 80 assets for anything wider.
+func wideningDateAssetServer(t *testing.T, searchCalls *atomic.Int32) *httptest.Server {
+	t.Helper()
+	buildAssets := func(prefix string, count int) []Asset {
+		assets := make([]Asset, count)
+		for index := range assets {
+			assets[index] = Asset{ID: fmt.Sprintf("%s-%d", prefix, index), Type: ImageType, ExifInfo: ExifInfo{ExifImageHeight: 1080, ExifImageWidth: 1920}}
+		}
+		return assets
+	}
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/api/search/random" {
+			asset := Asset{ID: path.Base(r.URL.Path), Type: ImageType, ExifInfo: ExifInfo{ExifImageHeight: 1080, ExifImageWidth: 1920}}
+			require.NoError(t, json.NewEncoder(w).Encode(asset))
+			return
+		}
+		searchCalls.Add(1)
+		var body SearchRandomBody
+		require.NoError(t, json.NewDecoder(r.Body).Decode(&body))
+		takenAfter, err := time.Parse(time.RFC3339, body.TakenAfter)
+		require.NoError(t, err)
+		takenBefore, err := time.Parse(time.RFC3339, body.TakenBefore)
+		require.NoError(t, err)
+		w.Header().Set("Content-Type", "application/json")
+		if takenBefore.Sub(takenAfter) > 40*24*time.Hour {
+			require.NoError(t, json.NewEncoder(w).Encode(buildAssets("wide", 80)))
+			return
+		}
+		require.NoError(t, json.NewEncoder(w).Encode(buildAssets("narrow", 5)))
+	}))
+}
