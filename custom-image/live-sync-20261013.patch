+	}
+	if workers > config.MaxOfflineParallelDownloads {
+		workers = config.MaxOfflineParallelDownloads
+	}
+	if numberOfAssets > 0 && workers > numberOfAssets {
+		workers = numberOfAssets
+	}
+	return workers
+}
