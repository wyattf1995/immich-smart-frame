+// offlineWorkerLimit is a runtime backstop for configurations that bypass
+// validation. The offline batch already serializes rendering globally; one worker
+// prevents completed images from accumulating while compression and disk writes run.
+func offlineWorkerLimit(parallelDownloads, numberOfAssets int) int {
+	workers := parallelDownloads
