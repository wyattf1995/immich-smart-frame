+func newHardExclusionPolicy(assets []string) *HardExclusionPolicy {
+	ids := append([]string(nil), assets...)
+	slices.Sort(ids)
+	digest := sha256.Sum256([]byte(strings.Join(ids, "\x00")))
+	set := make(map[string]struct{}, len(ids))
+	for _, id := range ids {
