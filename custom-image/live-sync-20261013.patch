+++ b/internal/immich/immich_album_cursor.go
@@ -0,0 +1,250 @@
+package immich
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"slices"
+	"sync"
+	"time"
+
+	"github.com/damongolding/immich-kiosk/internal/cache"
+	"github.com/damongolding/immich-kiosk/internal/config"
+)
+
+const (
+	defaultAlbumPageCursorRegistrySize = 256
+	// A fixed stripe count bounds gate state while allowing unrelated album
+	// selections to proceed independently.
+	albumSelectionGateStripes = 64
+	// MetadataSearchDto documents Page as a page number. The prior aggregate
+	// loop omitted zero, then continued with 1..100. Start explicitly at one so
+	// every cursor request has an unambiguous cache key and fixture contract.
+	metadataFirstPage = 1
+)
+
+type albumPageCursorKey string
+
+type albumPageCursorEntry struct {
+	page       int
+	offset     int
+	version    uint64
+	lastAccess time.Time
+}
+
+// albumPageCursorLease identifies the exact cursor state used to fetch a page.
+// A later selection must not update a cursor that another selection has moved.
+type albumPageCursorLease struct {
+	page    int
+	offset  int
+	version uint64
+}
+
+// albumSelectionGates serializes each selection key through a bounded set of
+// cancellation-aware stripes. The gate covers fetch, candidate choice, residual
+// cache replacement, and cursor movement so same-key callers cannot consume the
+// same residual concurrently.
+type albumSelectionGates struct {
+	stripes [albumSelectionGateStripes]chan struct{}
+}
+
+func newAlbumSelectionGates() *albumSelectionGates {
+	gates := &albumSelectionGates{}
+	for index := range gates.stripes {
+		gates.stripes[index] = make(chan struct{}, 1)
+	}
+	return gates
+}
+
+func (g *albumSelectionGates) acquire(ctx context.Context, key albumPageCursorKey) (func(), error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	var hash uint32 = 2166136261
+	for _, value := range key {
+		hash ^= uint32(value)
+		hash *= 16777619
+	}
+	slot := g.stripes[hash%albumSelectionGateStripes]
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case slot <- struct{}{}:
+	}
+	if err := ctx.Err(); err != nil {
+		<-slot
+		return nil, err
+	}
+	return func() { <-slot }, nil
+}
+
+// albumPageCursorRegistry retains only page positions, never assets, URLs, or
+// device identifiers. Cache invalidation starts a fresh coverage pass.
+type albumPageCursorRegistry struct {
+	mu          sync.Mutex
+	entries     map[albumPageCursorKey]albumPageCursorEntry
+	maxEntries  int
+	nextVersion uint64
+	now         func() time.Time
+}
+
+var (
+	albumPageCursors = newAlbumPageCursorRegistry(defaultAlbumPageCursorRegistrySize, time.Now)
+	albumSelections  = newAlbumSelectionGates()
+)
+
+func init() {
+	cache.RegisterInvalidationHook(func() { albumPageCursors.clear() })
+}
+
+func newAlbumPageCursorRegistry(maxEntries int, now func() time.Time) *albumPageCursorRegistry {
+	if maxEntries < 1 {
+		maxEntries = 1
+	}
+	return &albumPageCursorRegistry{entries: make(map[albumPageCursorKey]albumPageCursorEntry, maxEntries), maxEntries: maxEntries, now: now}
+}
+
+// albumSelectionGateKey intentionally groups all presentation variants of one
+// endpoint, device, user, and album. Some variants (for example random and
+// ascending) share the same upstream metadata cache entry, so a narrower cursor
+// key would allow a lost residual update across those variants.
+func albumSelectionGateKey(requestConfig config.Config, albumID, deviceID string) albumPageCursorKey {
+	material := struct {
+		ImmichURL    string `json:"immich_url"`
+		AlbumID      string `json:"album_id"`
+		DeviceID     string `json:"device_id"`
+		SelectedUser string `json:"selected_user"`
+	}{
+		ImmichURL: requestConfig.ImmichURL, AlbumID: albumID,
+		DeviceID: deviceID, SelectedUser: requestConfig.SelectedUser,
+	}
+	encoded, _ := json.Marshal(material)
+	digest := sha256.Sum256(encoded)
+	return albumPageCursorKey(hex.EncodeToString(digest[:]))
+}
+
+func albumPageKey(requestConfig config.Config, albumID string, favoritesOnly bool, selectionIdentity string) albumPageCursorKey {
+	// All fields affect the metadata result. The hard-policy generation avoids
+	// retaining a private asset list in the key while still isolating reloads.
+	excludedAlbums := append([]string(nil), requestConfig.ExcludedAlbums...)
+	// Album deny policy is request-specific, unlike the loaded hard asset
+	// policy. Normalize it before hashing so order does not fragment cursors.
+	slices.Sort(excludedAlbums)
+	material := struct {
+		ImmichURL         string   `json:"immich_url"`
+		AlbumID           string   `json:"album_id"`
+		SelectedUser      string   `json:"selected_user"`
+		CurationProfile   string   `json:"curation_profile"`
+		ExcludedAlbums    []string `json:"excluded_albums"`
+		Order             string   `json:"order"`
+		FilterDate        string   `json:"filter_date"`
+		FavoritesOnly     bool     `json:"favorites_only"`
+		ShowArchived      bool     `json:"show_archived"`
+		ShowVideos        bool     `json:"show_videos"`
+		FetchedSize       int      `json:"fetched_size"`
+		HardGeneration    string   `json:"hard_generation"`
+		SelectionIdentity string   `json:"selection_identity"`
+	}{
+		ImmichURL: requestConfig.ImmichURL, AlbumID: albumID, SelectedUser: requestConfig.SelectedUser,
+		CurationProfile: requestConfig.CurationProfile, ExcludedAlbums: excludedAlbums, Order: requestConfig.AlbumOrder,
+		FilterDate: requestConfig.FilterDate, FavoritesOnly: favoritesOnly,
+		ShowArchived: requestConfig.ShowArchived, ShowVideos: requestConfig.ShowVideos,
+		FetchedSize: requestConfig.Kiosk.FetchedAssetsSize, HardGeneration: requestConfig.HardExclusions().Generation(),
+		SelectionIdentity: selectionIdentity,
+	}
+	encoded, _ := json.Marshal(material)
+	digest := sha256.Sum256(encoded)
+	return albumPageCursorKey(hex.EncodeToString(digest[:]))
+}
+
+func (r *albumPageCursorRegistry) nextLeaseVersion() uint64 {
+	r.nextVersion++
+	return r.nextVersion
+}
+
+func (r *albumPageCursorRegistry) position(key albumPageCursorKey) albumPageCursorLease {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	now := r.now()
+	if entry, ok := r.entries[key]; ok {
+		entry.lastAccess = now
+		r.entries[key] = entry
+		return albumPageCursorLease{page: entry.page, offset: entry.offset, version: entry.version}
+	}
+	if len(r.entries) >= r.maxEntries {
+		var oldestKey albumPageCursorKey
+		var oldest time.Time
+		for candidate, entry := range r.entries {
+			if oldestKey == "" || entry.lastAccess.Before(oldest) {
+				oldestKey, oldest = candidate, entry.lastAccess
+			}
+		}
+		delete(r.entries, oldestKey)
+	}
+	version := r.nextLeaseVersion()
+	r.entries[key] = albumPageCursorEntry{page: metadataFirstPage, version: version, lastAccess: now}
+	return albumPageCursorLease{page: metadataFirstPage, version: version}
+}
+
+func (r *albumPageCursorRegistry) page(key albumPageCursorKey) int {
+	return r.position(key).page
+}
+
+// advance moves only after the current page's cached candidates are exhausted.
+// A terminal response wraps to the explicit first page, preserving eventual
+// coverage without unbounded pagination work in one foreground request.
+func (r *albumPageCursorRegistry) advanceIfCurrent(key albumPageCursorKey, expected albumPageCursorLease, hasNextPage bool) bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	entry, ok := r.entries[key]
+	if !ok || entry.page != expected.page || entry.offset != expected.offset || entry.version != expected.version {
+		return false
+	}
+	// A foreground request fetches exactly one page, so the former aggregate
+	// MaxPages limit is no longer a latency bound. Trust the server's nextPage
+	// signal to wrap; this is what lets older album pages eventually surface.
+	if !hasNextPage {
+		entry.page, entry.offset = metadataFirstPage, 0
+	} else {
+		entry.page, entry.offset = entry.page+1, 0
+	}
+	entry.version = r.nextLeaseVersion()
+	entry.lastAccess = r.now()
+	r.entries[key] = entry
+	return true
+}
+
+// advanceCandidate preserves the remainder of a deterministically sorted page
+// when response caching is disabled. It records only an index, never assets.
+func (r *albumPageCursorRegistry) advanceCandidateIfCurrent(key albumPageCursorKey, expected albumPageCursorLease, consumed, pageSize int, hasNextPage bool) bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	entry, ok := r.entries[key]
+	if !ok || entry.page != expected.page || entry.offset != expected.offset || entry.version != expected.version {
+		return false
+	}
+	if consumed < pageSize {
+		entry.offset = consumed
+	} else if !hasNextPage {
+		entry.page, entry.offset = metadataFirstPage, 0
+	} else {
+		entry.page, entry.offset = entry.page+1, 0
+	}
+	entry.version = r.nextLeaseVersion()
+	entry.lastAccess = r.now()
+	r.entries[key] = entry
+	return true
+}
+
+func (r *albumPageCursorRegistry) clear() {
+	r.mu.Lock()
+	r.entries = make(map[albumPageCursorKey]albumPageCursorEntry, r.maxEntries)
+	r.mu.Unlock()
+}
+
+func (r *albumPageCursorRegistry) size() int {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return len(r.entries)
+}
