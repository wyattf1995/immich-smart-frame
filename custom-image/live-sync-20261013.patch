new file mode 100644
index 0000000..d96933e
--- /dev/null
+++ b/frontend/src/ts/decode-frame.ts
@@ -0,0 +1,112 @@
+function abortError(): DOMException {
+    return new DOMException("aborted", "AbortError");
+}
+
+async function waitForDecode(image: HTMLImageElement, signal: AbortSignal, timeoutMs: number): Promise<boolean> {
+    if (signal.aborted) throw abortError();
+
+    let decoded: Promise<void>;
+    try {
+        decoded = image.decode();
+    } catch {
+        decoded = Promise.reject(new Error("image decode invocation failed"));
+    }
+    // A rejected decode can arrive after an abort has already won the race.
+    void decoded.catch(() => undefined);
+
+    return new Promise<boolean>((resolve, reject) => {
+        const finish = () => {
+            signal.removeEventListener("abort", abort);
+            clearTimeout(timeout);
+        };
+        const abort = () => {
+            finish();
+            reject(abortError());
+        };
+        const timeout = window.setTimeout(() => {
+            finish();
+            reject(new Error("image decode timed out"));
+        }, timeoutMs);
+
+        decoded.then(
+            () => {
+                finish();
+                resolve(image.naturalWidth > 0);
+            },
+            () => {
+                finish();
+                resolve(false);
+            },
+        );
+        signal.addEventListener("abort", abort, { once: true });
+        if (signal.aborted) abort();
+    });
+}
+
+async function waitForLoad(image: HTMLImageElement, signal: AbortSignal, timeoutMs: number): Promise<void> {
+    if (signal.aborted) throw abortError();
+
+    await new Promise<void>((resolve, reject) => {
+        const finish = () => {
+            signal.removeEventListener("abort", abort);
+            image.removeEventListener("load", load);
+            image.removeEventListener("error", error);
+            clearTimeout(timeout);
+        };
+        const abort = () => {
+            finish();
+            reject(abortError());
+        };
+        const load = () => {
+            finish();
+            image.naturalWidth > 0 ? resolve() : reject(new Error("image decode failed"));
+        };
+        const error = () => {
+            finish();
+            reject(new Error("image decode failed"));
+        };
+        const timeout = window.setTimeout(() => {
+            finish();
+            reject(new Error("image decode timed out"));
+        }, timeoutMs);
+
+        image.addEventListener("load", load, { once: true });
+        image.addEventListener("error", error, { once: true });
+        signal.addEventListener("abort", abort, { once: true });
+        if (signal.aborted) abort();
+    });
+}
+
+export async function decodeFrame(frame: HTMLElement, signal: AbortSignal, timeoutMs: number): Promise<void> {
+    const siblings = new AbortController();
+    const abortSiblings = () => siblings.abort();
+    if (signal.aborted) abortSiblings();
+    else signal.addEventListener("abort", abortSiblings, { once: true });
+
+    try {
+        await Promise.all(Array.from(frame.querySelectorAll("img")).map(async (image) => {
+            if (siblings.signal.aborted) throw abortError();
+            const started = performance.now();
+            // A completed image will not deliver another load/error event. Avoid a
+            // non-settling decode promise for valid images and reject broken ones.
+            if (image.complete) {
+                if (image.naturalWidth > 0) return;
+                throw new Error("image decode failed");
+            }
+            if (typeof image.decode === "function" && await waitForDecode(image, siblings.signal, timeoutMs)) return;
+            if (siblings.signal.aborted) throw abortError();
+            if (image.complete) {
+                if (image.naturalWidth > 0) return;
+                throw new Error("image decode failed");
+            }
+            const remaining = timeoutMs - (performance.now() - started);
+            if (remaining <= 0) throw new Error("image decode timed out");
+            await waitForLoad(image, siblings.signal, remaining);
+        }));
+    } catch (error) {
+        abortSiblings();
+        throw error;
+    } finally {
+        signal.removeEventListener("abort", abortSiblings);
+    }
+}
