+package immich
+
+import (
+	"context"
+	"testing"
+
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+func TestClassificationGateRequiresAICaptionAndRejectsStrongScreenshotNames(t *testing.T) {
+	cfg := config.Config{Kiosk: config.KioskSettings{RequireAICaption: true}}
+	for _, testCase := range []struct {
+		name        string
+		description string
+		filename    string
+		want        bool
+	}{
+		{name: "classified photograph", description: "[AI] A family at the beach [/AI]", filename: "IMG_1001.jpg", want: true},
+		{name: "missing caption", filename: "IMG_1001.jpg", want: false},
+		{name: "human caption does not satisfy AI gate", description: "Family at the beach", filename: "IMG_1001.jpg", want: false},
+		{name: "screenshot underscore date", description: "[AI] A screenshot [/AI]", filename: "Screenshot_2026-09-05.png", want: false},
+		{name: "screen shot spaced date", description: "[AI] A screenshot [/AI]", filename: "Screen Shot 2026-09-05 at 10.22.13.png", want: false},
+		{name: "screen capture compact date", description: "[AI] A screenshot [/AI]", filename: "ScreenCapture 20260905-151144.jpg", want: false},
+		{name: "timestamp-prefixed screenshot", description: "[AI] A screenshot [/AI]", filename: "2026-09-05_10-22-13 Screenshot.png", want: false},
+		{name: "natural language screenshot name is not inferred", description: "[AI] Photograph [/AI]", filename: "Screenshot of birthday.jpg", want: true},
+		{name: "embedded screenshot term is not inferred", description: "[AI] Photograph [/AI]", filename: "vacation_screenshot_reference.jpg", want: true},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			asset := New(context.Background(), cfg)
+			asset.ExifInfo.Description = testCase.description
+			asset.OriginalFileName = testCase.filename
+			require.Equal(t, testCase.want, asset.hasValidClassification())
+		})
+	}
+}
+
+func TestHasValidTagsFailsClosedWhenAssetMetadataCannotBeRead(t *testing.T) {
+	asset := New(context.Background(), config.Config{ImmichURL: "://invalid"})
+	asset.ID = "asset"
+	require.False(t, asset.hasValidTags("request", "device"))
+}
