+package config
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/labstack/echo/v5"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRequireAICaptionDefaultsOffAndCannotBeURLOverridden(t *testing.T) {
+	cfg := New()
+	require.False(t, cfg.Kiosk.RequireAICaption)
+
+	req := httptest.NewRequest(http.MethodGet, "/?require_ai_caption=true", nil)
+	rec := httptest.NewRecorder()
+	echoContext := echo.New().NewContext(req, rec)
+	require.NoError(t, cfg.ConfigWithOverrides(echoContext.QueryParams(), echoContext))
+	require.False(t, cfg.Kiosk.RequireAICaption)
+}
