+package routes
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	"github.com/damongolding/immich-kiosk/internal/cache"
+	"github.com/damongolding/immich-kiosk/internal/common"
+	"github.com/damongolding/immich-kiosk/internal/immich"
+	"github.com/labstack/echo/v5"
+	"github.com/stretchr/testify/require"
+)
+
+func TestHistoryRejectsFreshlySkippedAssetInsteadOfCachedMetadata(t *testing.T) {
+	cached := testImageAsset("history-asset")
+	cached.ExifInfo.Description = "[AI] A classified photo [/AI]"
+	fresh := cached
+	fresh.Tags = []immich.Tag{{Value: "Skip/Screenshot"}}
+
+	var metadataRequests atomic.Int32
+	var previewRequests atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/api/assets/history-asset":
+			metadataRequests.Add(1)
+			w.Header().Set("Content-Type", echo.MIMEApplicationJSON)
+			require.NoError(t, json.NewEncoder(w).Encode(fresh))
+		case "/api/assets/history-asset/thumbnail", "/api/assets/history-asset/original":
+			previewRequests.Add(1)
+			http.Error(w, "history must reject before preview", http.StatusInternalServerError)
+		default:
+			t.Fatalf("unexpected classification history route %q", r.URL.Path)
+		}
+	}))
+	defer server.Close()
+
+	cfg := newHistoryRenderTestConfig(server.URL)
+	cfg.Kiosk.Cache = true
+	cfg.Kiosk.RequireAICaption = true
+	cfg.ExcludedTags = []string{"Skip/**"}
+
+	cache.Initialize()
+	cache.Flush()
+	cachedBody, err := json.Marshal(cached)
+	require.NoError(t, err)
+	cache.Set(cache.APICacheKey(server.URL+"/api/assets/history-asset", "classification-history", cfg.SelectedUser), cachedBody, cfg.Duration, cfg.CacheDuration)
+
+	req := httptest.NewRequest(http.MethodPost, "/asset/previous?history=history-asset:&history=*current:", nil).WithContext(context.Background())
+	req.Header.Set("kiosk-device-id", "classification-history")
+	rec := httptest.NewRecorder()
+	err = PreviousHistoryAsset(cfg, common.New())(echo.New().NewContext(req, rec))
+	require.NoError(t, err)
+	require.Equal(t, http.StatusOK, rec.Code)
+	require.Positive(t, metadataRequests.Load(), "history must bypass cached metadata before rendering")
+	require.Zero(t, previewRequests.Load(), "rejected history target must not fetch another asset or preview")
+	require.NotContains(t, rec.Body.String(), "Main image")
+}
+
+func TestOfflineScopeChangesWhenClassificationGateIsEnabled(t *testing.T) {
+	cfg := *newCancellationTestConfig("http://immich.test")
+	before := offlineCacheScope(cfg, "classification-offline")
+	cfg.Kiosk.RequireAICaption = true
+	after := offlineCacheScope(cfg, "classification-offline")
+	require.NotEqual(t, before, after, "enabling the gate must invalidate an offline pool created without it")
+}
