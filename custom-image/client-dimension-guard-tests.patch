+func TestDimensionGuardPrecedesMemoryHeavyAssetWork(t *testing.T) {
+	assertGuardBefore := func(filename, functionStart, functionEnd, heavyCall string) {
+		t.Helper()
+		source, err := os.ReadFile(filename)
+		require.NoError(t, err)
+		body := string(source)
+		start := strings.Index(body, functionStart)
+		require.NotEqual(t, -1, start)
+		body = body[start:]
+		end := strings.Index(body, functionEnd)
+		require.NotEqual(t, -1, end)
+		body = body[:end]
+		guard := strings.Index(body, "validateOptimizedClientDimensions(requestConfig)")
+		heavy := strings.Index(body, heavyCall)
+		require.NotEqual(t, -1, guard)
+		require.NotEqual(t, -1, heavy)
+		require.Less(t, guard, heavy)
+	}
+
+	assertGuardBefore("routes_asset.go", "func NewAsset", "func Image(", "generateViewData(")
+	assertGuardBefore("routes_asset.go", "func Image(", "func ImageWithReload", "processAsset(")
+	assertGuardBefore("routes_offline.go", "func OfflineMode", "// downloadOfflineAssets", "ensureOfflineCacheScope(")
+}
