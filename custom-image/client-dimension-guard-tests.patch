+func TestOptimizedAssetRequestsRequireClientDimensions(t *testing.T) {
+	tests := []struct {
+		name    string
+		config  config.Config
+		wantErr bool
+	}{
+		{name: "optimization disabled", config: config.Config{}},
+		{name: "bounded dimensions", config: config.Config{OptimizeImages: true, ClientData: config.ClientData{Width: 1920, Height: 1080}}},
+		{name: "missing dimensions", config: config.Config{OptimizeImages: true}, wantErr: true},
+		{name: "missing height", config: config.Config{OptimizeImages: true, ClientData: config.ClientData{Width: 1920}}, wantErr: true},
+		{name: "missing width", config: config.Config{OptimizeImages: true, ClientData: config.ClientData{Height: 1080}}, wantErr: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := validateOptimizedClientDimensions(tt.config)
+			if tt.wantErr {
+				require.ErrorIs(t, err, ErrClientDimensionsRequired)
+				return
+			}
+			require.NoError(t, err)
+		})
+	}
+}
