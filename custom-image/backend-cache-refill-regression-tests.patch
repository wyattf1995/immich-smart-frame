diff --git a/internal/immich/immich_cache_backend_regression_test.go b/internal/immich/immich_cache_backend_regression_test.go
index b7ae8b4..d65d865 100644
--- a/internal/immich/immich_cache_backend_regression_test.go
+++ b/internal/immich/immich_cache_backend_regression_test.go
@@ -6,0 +7 @@ import (
+	"net/url"
@@ -32,0 +34 @@ func TestMemoriesPastDaysDoesNotPopulateCacheWhenDisabled(t *testing.T) {
+	cache.Initialize()
@@ -48,0 +51,31 @@ func TestMemoriesPastDaysDoesNotPopulateCacheWhenDisabled(t *testing.T) {
+func TestPaginatedFetchDoesNotRefillAfterInvalidation(t *testing.T) {
+	cache.Initialize()
+	cache.Flush()
+	started := make(chan struct{})
+	release := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		close(started)
+		<-release
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"assets":{"items":[],"nextPage":""}}`))
+	}))
+	defer server.Close()
+
+	asset := New(context.Background(), config.Config{
+		ImmichURL: server.URL,
+		Kiosk:     config.KioskSettings{Cache: true},
+	})
+	u, err := url.Parse(server.URL)
+	require.NoError(t, err)
+	result := make(chan error, 1)
+	go func() {
+		_, callErr := asset.fetchPaginatedMetadataWithCache(u, SearchRandomBody{Page: 1, Size: 1}, "request", "device")
+		result <- callErr
+	}()
+	<-started
+	cache.InvalidateAll()
+	close(release)
+	require.NoError(t, <-result)
+	require.Zero(t, cache.ItemCount(), "pre-invalidation aggregate response was cached")
+}
