--- a/internal/cache/cache_backend_regression_test.go
+++ b/internal/cache/cache_backend_regression_test.go
@@ -51,0 +52,23 @@ func TestOldGenerationCannotRefillAfterInvalidation(t *testing.T) {
+func TestConditionalUpdateRejectsOldGeneration(t *testing.T) {
+	Flush()
+	oldGeneration := CurrentGeneration()
+	InvalidateAll()
+	if UpdateIfGeneration(oldGeneration, "stale-view", func(values []string) []string {
+		return append(values, "stale")
+	}, 60, 60) {
+		t.Fatal("stale generation view append was accepted")
+	}
+	if _, found := Get("stale-view"); found {
+		t.Fatal("stale view append repopulated the cache")
+	}
+}
+
+func TestConditionalVideoPrependRejectsOldGeneration(t *testing.T) {
+	Flush()
+	oldGeneration := CurrentGeneration()
+	InvalidateAll()
+	if AssetToCacheWithPositionIfGeneration(oldGeneration, "stale-video", &config.Config{Kiosk: config.KioskSettings{Cache: true}}, "device", "url", PREPEND) {
+		t.Fatal("stale generation video prepend was accepted")
+	}
+}
