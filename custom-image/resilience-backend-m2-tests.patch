+func TestRequestTimeMiddlewareConfigReadsAreSnapshotGuarded(t *testing.T) {
+	source, err := os.ReadFile("main.go")
+	require.NoError(t, err)
+	mainSource := string(source)
+	start := strings.Index(mainSource, "func addMiddleware")
+	end := strings.Index(mainSource, "func setLogLevel")
+	require.NotEqual(t, -1, start)
+	require.NotEqual(t, -1, end)
+	middlewareSource := mainSource[start:end]
+	for _, directRead := range []string{
+		"baseConfig.Kiosk.Password",
+		"baseConfig.Kiosk.Debug",
+		"baseConfig.Kiosk.DebugVerbose",
+		"baseConfig.Kiosk.AllowedOrigins",
+	} {
+		require.NotContains(t, middlewareSource, directRead)
+	}
+	require.Contains(t, middlewareSource, "baseConfig.Snapshot()")
+
+	for _, functionName := range []string{"func StaticCacheMiddlewareWithConfig", "func AssetCacheMiddlewareWithConfig"} {
+		functionStart := strings.Index(mainSource, functionName)
+		require.NotEqual(t, -1, functionStart)
+		functionEnd := strings.Index(mainSource[functionStart:], "\nfunc ")
+		require.NotEqual(t, -1, functionEnd)
+		functionSource := mainSource[functionStart : functionStart+functionEnd]
+		require.NotContains(t, functionSource, "baseConfig.Kiosk.Debug")
+		require.Contains(t, functionSource, "baseConfig.Snapshot()")
+	}
+}
