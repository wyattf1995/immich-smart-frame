+func TestReadinessCoalescesConcurrentInitialProbes(t *testing.T) {
+	original := HTTPClient
+	t.Cleanup(func() { HTTPClient = original })
+	var calls int
+	var mu sync.Mutex
+	start := make(chan struct{})
+	HTTPClient = &http.Client{Transport: roundTripFunc(func(*http.Request) (*http.Response, error) {
+		mu.Lock()
+		calls++
+		mu.Unlock()
+		time.Sleep(50 * time.Millisecond)
+		return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"total":1}`))}, nil
+	})}
+	cfg := config.Config{ImmichURL: "http://readiness-singleflight.test", ImmichAPIKey: "key", Kiosk: config.KioskSettings{Cache: false}}
+	var wg sync.WaitGroup
+	for range 12 {
+		wg.Go(func() {
+			<-start
+			require.NoError(t, Ready(context.Background(), cfg))
+		})
+	}
+	close(start)
+	wg.Wait()
+	mu.Lock()
+	defer mu.Unlock()
+	require.Equal(t, 1, calls)
+}

