new file mode 100644
index 0000000..b577553
--- /dev/null
+++ b/internal/routes/routes_shared_playback_assets.go
@@ -0,0 +1,94 @@
+package routes
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"strings"
+
+	"github.com/damongolding/immich-kiosk/internal/common"
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/damongolding/immich-kiosk/internal/immich"
+	"github.com/damongolding/immich-kiosk/internal/playback"
+	imageComponent "github.com/damongolding/immich-kiosk/internal/templates/components/image"
+	"github.com/damongolding/immich-kiosk/internal/utils"
+	"github.com/labstack/echo/v5"
+)
+
+// Shared selection uses the configured group profile, never the first viewer's
+// physical-device preferences. Existing buckets and Immich classification gates
+// remain authoritative. Only identifiers leave this function; no image is decoded.
+func loadSharedPhoto(ctx context.Context, base config.Config, request playback.LoadRequest) (playback.Asset, error) {
+	cfg := base.Snapshot()
+	cfg.CurationProfile = request.Group.SelectionKey
+	cfg.ShowVideos = false
+	cfg.LivePhotos = false
+	cfg.ShowAnimatedGifs = false
+	identity := "sync:" + request.Group.ID
+	asset := immich.New(ctx, cfg)
+	buckets, err := gatherAssetBuckets(&asset, cfg, identity, identity)
+	if err != nil {
+		return playback.Asset{}, err
+	}
+	excluded := make(map[string]bool, len(request.ExcludeAssetIDs))
+	for _, id := range request.ExcludeAssetIDs {
+		excluded[id] = true
+	}
+	for attempt := range maxProcessAssetRetries {
+		if err := ctx.Err(); err != nil {
+			return playback.Asset{}, err
+		}
+		candidate := utils.PickRandomImageType(cfg.Kiosk.AssetWeighting || cfg.CurationProfile != "", buckets)
+		candidate.ID, _ = asset.ApplyUserFromAssetID(candidate.ID)
+		if err = retrieveImage(&asset, candidate, cfg.ExcludedAlbums, identity, identity, false); err != nil {
+			continue
+		}
+		if asset.Type != immich.ImageType {
+			continue
+		}
+		// A small library may repeat only after the bounded attempt budget.
+		if excluded[asset.ID] && attempt < finalSelectionAttempt {
+			continue
+		}
+		return playback.NewAsset(asset.ID, asset.SelectedUser()), nil
+	}
+	return playback.Asset{}, fmt.Errorf("shared photo selection exhausted its bounded candidate attempts")
+}
+
+// Render a known group slide at the requesting display's bounded dimensions.
+// Revalidation prevents an asset newly excluded by classification from leaking
+// back through prepared/history state. Rendering never selects another photo.
+func renderSharedPhoto(c *echo.Context, base *config.Config, com *common.Common, group string, asset playback.Asset) error {
+	request, err := InitializeRequestData(c, base)
+	if err != nil || request == nil {
+		return err
+	}
+	cfg := request.RequestConfig
+	cfg.SelectedUser = asset.SelectedUser()
+	cfg.ShowVideos = false
+	cfg.LivePhotos = false
+	cfg.ShowAnimatedGifs = false
+	cfg.UseOriginalImage = false
+	cfg.OptimizeImages = true
+	cfg.History = nil
+	// Shared images are still JPEGs, including GIF source assets. This keeps
+	// native offline capture and scheduled image decoding deterministic.
+	cfg.ShowMoreInfo = false
+	if err := validateOptimizedClientDimensions(cfg); err != nil {
+		return echo.NewHTTPError(http.StatusBadRequest, "valid display dimensions are required")
+	}
+	ctx, cancel := foregroundAssetContext(c.Request().Context(), com.Context(), cfg.Kiosk.HTTPTimeout)
+	defer cancel()
+	view := common.ViewData{Config: cfg, KioskVersion: KioskVersion, RequestID: request.RequestID,
+		DeviceID: framePreferenceDevice(c.QueryParam("frame_id"), request.DeviceID), Assets: make([]common.ViewImageData, 1)}
+	if err := getHistoryAsset(ctx, cfg, request.RequestID, "sync:"+group, asset.SelectedUser(), &view, 0, asset.ID)(); err != nil {
+		return echo.NewHTTPError(http.StatusServiceUnavailable, "shared photo temporarily unavailable")
+	}
+	if view.Assets[0].ImmichAsset.Type != immich.ImageType || !strings.HasPrefix(view.Assets[0].ImageData, "data:image/jpeg;base64,") {
+		return echo.NewHTTPError(http.StatusServiceUnavailable, "shared photo temporarily unavailable")
+	}
+	// Image's upstream GIF branch would turn a JPEG back into a raw-image URL.
+	// Render the admitted, already-decoded still instead.
+	view.Assets[0].ImmichAsset.OriginalMimeType = "image/jpeg"
+	return Render(c, http.StatusOK, imageComponent.Image(view, com.Secret()))
+}
