diff --git a/internal/routes/routes_shared_playback.go b/internal/routes/routes_shared_playback.go
new file mode 100644
index 0000000..5e27d5f
--- /dev/null
+++ b/internal/routes/routes_shared_playback.go
@@ -0,0 +1,168 @@
+package routes
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"mime"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/damongolding/immich-kiosk/internal/common"
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/damongolding/immich-kiosk/internal/playback"
+	"github.com/labstack/echo/v5"
+)
+
+// SharedPlayback owns only configured groups. Selection settings are frozen at
+// startup; changing group membership/profile/duration requires a restart.
+type SharedPlayback struct {
+	coordinator *playback.Coordinator
+	base        *config.Config
+	common      *common.Common
+}
+
+func NewSharedPlayback(base *config.Config, com *common.Common) (*SharedPlayback, error) {
+	frozen := base.Snapshot()
+	if err := frozen.ValidateSyncGroups(); err != nil {
+		return nil, err
+	}
+	groups := make([]playback.GroupConfig, 0, len(frozen.Kiosk.SyncGroups))
+	for id, policy := range frozen.Kiosk.SyncGroups {
+		groups = append(groups, playback.GroupConfig{ID: id, SelectionKey: policy.CurationProfile,
+			Duration: time.Duration(policy.Duration) * time.Second, PreloadLead: 3 * time.Second,
+			IdleTimeout: 2 * time.Duration(policy.Duration) * time.Second, RetryDelay: 5 * time.Second, RetryLimit: 3, HistoryLimit: 12})
+	}
+	coordinator, err := playback.New(groups, func(ctx context.Context, request playback.LoadRequest) (playback.Asset, error) {
+		bounded, cancel := foregroundAssetContext(ctx, com.Context(), frozen.Kiosk.HTTPTimeout)
+		defer cancel()
+		return loadSharedPhoto(bounded, frozen, request)
+	}, playback.Options{MaxConfiguredGroups: 8})
+	if err != nil {
+		return nil, err
+	}
+	return &SharedPlayback{coordinator: coordinator, base: base, common: com}, nil
+}
+
+func (s *SharedPlayback) Close() { s.coordinator.Close() }
+
+func (s *SharedPlayback) Register(e *echo.Echo) {
+	e.GET("/api/playback/:group", s.State)
+	e.POST("/api/playback/:group/control", s.Control)
+	e.GET("/api/playback/:group/slide/:slide", s.Slide)
+}
+
+type sharedSlideResponse struct {
+	ID       string `json:"id"`
+	AssetID  string `json:"assetId"`
+	StartsAt int64  `json:"startsAt"`
+	URL      string `json:"url"`
+}
+type sharedStateResponse struct {
+	SessionID string               `json:"sessionId"`
+	Version   uint64               `json:"version"`
+	ServerNow int64                `json:"serverNow"`
+	Paused    bool                 `json:"paused"`
+	Loading   bool                 `json:"loading"`
+	Current   *sharedSlideResponse `json:"current"`
+	Next      *sharedSlideResponse `json:"next"`
+}
+
+func sharedStateWire(group string, state playback.State) sharedStateResponse {
+	slide := func(value *playback.Slide) *sharedSlideResponse {
+		if value == nil {
+			return nil
+		}
+		return &sharedSlideResponse{ID: value.ID, AssetID: value.AssetID, StartsAt: value.StartsAt.UnixMilli(),
+			URL: "/api/playback/" + url.PathEscape(group) + "/slide/" + url.PathEscape(value.ID)}
+	}
+	return sharedStateResponse{SessionID: state.Epoch, Version: state.Version, ServerNow: state.ServerNow.UnixMilli(),
+		Paused: state.Paused, Loading: state.Loading, Current: slide(state.Current), Next: slide(state.Next)}
+}
+
+func sharedNoStore(c *echo.Context) {
+	c.Response().Header().Set("Cache-Control", "private, no-store")
+	c.Response().Header().Set("X-Content-Type-Options", "nosniff")
+}
+
+func (s *SharedPlayback) State(c *echo.Context) error {
+	sharedNoStore(c)
+	state, err := s.coordinator.State(c.Param("group"))
+	if err != nil {
+		return sharedPlaybackError(err)
+	}
+	return c.JSON(http.StatusOK, sharedStateWire(c.Param("group"), state))
+}
+
+func sameOriginPlaybackControl(r *http.Request) bool {
+	origin, err := url.Parse(r.Header.Get("Origin"))
+	if err != nil || (origin.Scheme != "http" && origin.Scheme != "https") || origin.Host != r.Host ||
+		origin.User != nil || origin.RawQuery != "" || origin.Fragment != "" || (origin.Path != "" && origin.Path != "/") {
+		return false
+	}
+	site := r.Header.Get("Sec-Fetch-Site")
+	return site == "" || site == "same-origin" || site == "none"
+}
+
+func (s *SharedPlayback) Control(c *echo.Context) error {
+	sharedNoStore(c)
+	if !sameOriginPlaybackControl(c.Request()) {
+		return echo.NewHTTPError(http.StatusForbidden, "same-origin playback control required")
+	}
+	media, _, err := mime.ParseMediaType(c.Request().Header.Get("Content-Type"))
+	if err != nil || media != "application/json" {
+		return echo.NewHTTPError(http.StatusUnsupportedMediaType, "JSON control required")
+	}
+	body, err := io.ReadAll(io.LimitReader(c.Request().Body, 1025))
+	if err != nil || len(body) > 1024 {
+		return echo.NewHTTPError(http.StatusBadRequest, "invalid playback command")
+	}
+	var command struct {
+		Action          playback.Action `json:"action"`
+		SessionID       string          `json:"sessionId"`
+		ExpectedVersion uint64          `json:"expectedVersion"`
+	}
+	decoder := json.NewDecoder(strings.NewReader(string(body)))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&command); err != nil {
+		return echo.NewHTTPError(http.StatusBadRequest, "invalid playback command")
+	}
+	if decoder.Decode(new(any)) != io.EOF || command.SessionID == "" {
+		return echo.NewHTTPError(http.StatusBadRequest, "invalid playback command")
+	}
+	switch command.Action {
+	case playback.Next, playback.Previous, playback.Pause, playback.Resume:
+	default:
+		return echo.NewHTTPError(http.StatusBadRequest, "unknown playback action")
+	}
+	state, err := s.coordinator.Command(c.Param("group"), playback.Command{Action: command.Action, ExpectedEpoch: command.SessionID, ExpectedVersion: command.ExpectedVersion})
+	if errors.Is(err, playback.ErrVersionConflict) || errors.Is(err, playback.ErrNotReady) || errors.Is(err, playback.ErrNoPrevious) {
+		return c.JSON(http.StatusConflict, sharedStateWire(c.Param("group"), state))
+	}
+	if err != nil {
+		return sharedPlaybackError(err)
+	}
+	return c.JSON(http.StatusOK, sharedStateWire(c.Param("group"), state))
+}
+
+func (s *SharedPlayback) Slide(c *echo.Context) error {
+	sharedNoStore(c)
+	asset, found, err := s.coordinator.AssetForSlide(c.Param("group"), c.Param("slide"))
+	if err != nil {
+		return sharedPlaybackError(err)
+	}
+	if !found {
+		return echo.NewHTTPError(http.StatusNotFound, "shared slide is no longer available")
+	}
+	return renderSharedPhoto(c, s.base, s.common, c.Param("group"), asset)
+}
+
+func sharedPlaybackError(err error) error {
+	if errors.Is(err, playback.ErrUnknownGroup) {
+		return echo.NewHTTPError(http.StatusNotFound, "shared playback group is not configured")
+	}
+	return echo.NewHTTPError(http.StatusServiceUnavailable, "shared playback temporarily unavailable")
+}
