new file mode 100644
index 0000000..f5d243e
--- /dev/null
+++ b/internal/config/config_shared_playback.go
@@ -0,0 +1,40 @@
+package config
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+var syncGroupID = regexp.MustCompile(`^[a-z0-9][a-z0-9_-]{0,47}$`)
+
+// ValidateSyncGroups fails closed even when general schema validation is off.
+// Groups are server configured, not allocated from arbitrary client input.
+func (c *Config) ValidateSyncGroups() error {
+	if len(c.Kiosk.SyncGroups) > 8 {
+		return fmt.Errorf("kiosk.sync_groups supports at most 8 groups")
+	}
+	for id, group := range c.Kiosk.SyncGroups {
+		if !syncGroupID.MatchString(id) {
+			return fmt.Errorf("invalid shared playback group ID")
+		}
+		if group.Duration < 10 || group.Duration > 3600 {
+			return fmt.Errorf("shared playback duration must be 10..3600 seconds")
+		}
+		profile := strings.TrimSpace(group.CurationProfile)
+		if profile == "" {
+			return fmt.Errorf("shared playback group requires a curation_profile")
+		}
+		found := false
+		for name := range c.Curation.Profiles {
+			if strings.EqualFold(name, profile) {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return fmt.Errorf("shared playback group references an unknown curation_profile")
+		}
+	}
+	return nil
+}
