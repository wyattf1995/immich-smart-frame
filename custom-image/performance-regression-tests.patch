+package immich
+
+import (
+	"testing"
+
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestAlbumPenaltyFactorsResolveOnceAndUseMinimumFactor(t *testing.T) {
+	factors := albumPenaltyFactors([]config.AlbumPenalty{{Album: "Casual", Factor: 0.6}, {Album: "featured", Factor: 0.2}})
+
+	assert.Equal(t, 0.6, factors["casual"])
+	assert.Equal(t, 0.2, factors["featured"])
+	assert.Equal(t, 0.2, albumPenaltyFactorForAlbums(Albums{{ID: "CASUAL"}, {ID: "Featured"}}, factors))
+}
+
+func TestDateCandidatePoolConsumesCandidatesOnlyOnce(t *testing.T) {
+	pool := newDateCandidatePool([]Asset{{ID: "one"}, {ID: "two"}, {ID: "three"}})
+	seen := map[string]bool{}
+	for range 3 {
+		asset, ok := pool.take()
+		assert.True(t, ok)
+		assert.False(t, seen[asset.ID], "candidate %q was evaluated more than once", asset.ID)
+		seen[asset.ID] = true
+	}
+	_, ok := pool.take()
+	assert.False(t, ok)
+	assert.Len(t, seen, 3)
+}
+
+func BenchmarkAlbumPenaltyFactorLookup(b *testing.B) {
+	factors := albumPenaltyFactors([]config.AlbumPenalty{{Album: "target", Factor: 0.2}})
+	albums := Albums{{ID: "one"}, {ID: "two"}, {ID: "target"}}
+	b.ReportAllocs()
+	b.ResetTimer()
+	for range b.N {
+		if albumPenaltyFactorForAlbums(albums, factors) != 0.2 {
+			b.Fatal("unexpected penalty factor")
+		}
+	}
+}
