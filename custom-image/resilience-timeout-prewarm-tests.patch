+func TestPrefetchSchedulerAdmissionRaceDrainsAdmittedWork(t *testing.T) {
+	scheduler := newPrefetchScheduler(1, time.Second)
+	parent, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	started := make(chan struct{})
+	go scheduler.scheduleWithContext(parent, "race", func(ctx context.Context) {
+		close(started)
+		<-ctx.Done()
+	})
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("scheduler did not admit work")
+	}
+	cancel()
+	drainCtx, drainCancel := context.WithTimeout(context.Background(), time.Second)
+	defer drainCancel()
+	require.True(t, scheduler.drain(drainCtx))
+	require.False(t, scheduler.scheduleWithContext(context.Background(), "after-race-drain", func(context.Context) {}))
+}

