@@ -0,0 +1,24 @@
+package webhooks
+
+import (
+	"testing"
+
+	"github.com/damongolding/immich-kiosk/internal/common"
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+// The hard deny-list can hold thousands of private asset IDs (2,935 on 10/24); a webhook receiver needs none of them.
+func TestWebhookPayloadLeavesOutTheHardExclusionList(t *testing.T) {
+	excluded := "11111111-1111-4111-8111-111111111111"
+	requestConfig := config.New()
+	requestConfig.ExcludedAssets = []string{excluded}
+	requestData := &common.RouteRequestData{DeviceID: "frame-1", ClientName: "frame", RequestConfig: *requestConfig}
+
+	payload, err := prepareWebhookPayload(requestData, "test", NewAsset, "event-1", common.ViewData{})
+
+	require.NoError(t, err)
+	require.NotContains(t, string(payload), excluded)
+	require.Contains(t, string(payload), `"deviceID":"frame-1"`)
+	require.Equal(t, []string{excluded}, requestData.RequestConfig.ExcludedAssets, "the request keeps its own policy")
+}
