+// FlushCache drops in-memory video metadata and removes the corresponding
+// temporary files. It is registered with the shared cache generation so the
+// cache flush endpoint cannot leave stale video entries behind.
+func (v *Manager) FlushCache() {
+	v.mu.Lock()
+	videos := append([]Video(nil), v.Videos...)
+	v.Videos = nil
+	v.DownloadQueue = nil
+	v.mu.Unlock()
+
+	for _, video := range videos {
+		if video.FileName == "" {
+			continue
+		}
+		if err := os.Remove(filepath.Join(customTempVideoDir, video.FileName)); err != nil && !os.IsNotExist(err) {
+			log.Error("deleting video during cache flush", "video", video.FileName, "err", err)
+		}
+	}
