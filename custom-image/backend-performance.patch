index 0000000..0acffdb
--- /dev/null
+++ b/internal/routes/routes_prefetch.go
@@ -0,0 +1,43 @@
+package routes
+
+import (
+	"context"
+	"sync"
+	"time"
+)
+
+const (
+	defaultPrefetchConcurrency = 2
+	defaultPrefetchTimeout     = 30 * time.Second
+)
+
+type prefetchScheduler struct {
+	sem      chan struct{}
+	timeout  time.Duration
+	inFlight sync.Map
+}
+
+func newPrefetchScheduler(concurrency int, timeout time.Duration) *prefetchScheduler {
+	return &prefetchScheduler{sem: make(chan struct{}, concurrency), timeout: timeout}
+}
+
+func (s *prefetchScheduler) schedule(key string, work func(context.Context)) bool {
+	if _, loaded := s.inFlight.LoadOrStore(key, struct{}{}); loaded {
+		return false
+	}
+	select {
+	case s.sem <- struct{}{}:
+	default:
+		s.inFlight.Delete(key)
+		return false
+	}
+	go func() {
+		defer func() { <-s.sem; s.inFlight.Delete(key) }()
+		ctx, cancel := context.WithTimeout(context.Background(), s.timeout)
+		defer cancel()
+		work(ctx)
+	}()
+	return true
+}
+
+var assetPrefetchScheduler = newPrefetchScheduler(defaultPrefetchConcurrency, defaultPrefetchTimeout)
