+type dateCandidatePool struct {
+	mu         sync.Mutex
+	candidates []Asset
+}
+
+func newDateCandidatePool(candidates []Asset) *dateCandidatePool {
+	return &dateCandidatePool{candidates: candidates}
+}
+
+// take removes a candidate before validation, so a cached candidate is never
+// decoded or evaluated twice. Removing the last item is O(1).
+func (p *dateCandidatePool) take() (Asset, bool) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if len(p.candidates) == 0 {
+		return Asset{}, false
+	}
+	last := len(p.candidates) - 1
+	asset := p.candidates[last]
+	p.candidates[last] = Asset{}
+	p.candidates = p.candidates[:last]
+	return asset, true
+}
+
+func (p *dateCandidatePool) refill(candidates []Asset) {
+	p.mu.Lock()
+	p.candidates = candidates
+	p.mu.Unlock()
+}
+
+func dateCandidatePoolKey(apiCacheKey string) string { return "date-candidates:" + apiCacheKey }
+
