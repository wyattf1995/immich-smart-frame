diff --git a/internal/routes/routes_context.go b/internal/routes/routes_context.go
new file mode 100644
index 00000000..9d99babc
--- /dev/null
+++ b/internal/routes/routes_context.go
@@ -0,0 +1,98 @@
+package routes
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"charm.land/log/v2"
+	"github.com/labstack/echo/v5"
+)
+
+const defaultRequestTimeout = 20 * time.Second
+
+func boundedRequestTimeout(httpTimeoutSeconds int, ceiling time.Duration) time.Duration {
+	timeout := time.Duration(httpTimeoutSeconds) * time.Second
+	switch {
+	case timeout <= 0:
+		timeout = defaultRequestTimeout
+	case timeout > ceiling:
+		timeout = ceiling
+	}
+	return timeout
+}
+
+func requestContextWithShutdown(request context.Context, shutdown context.Context, httpTimeoutSeconds int, ceiling time.Duration) (context.Context, context.CancelFunc) {
+	ctx, cancel := context.WithCancel(request)
+	stop := context.AfterFunc(shutdown, cancel)
+	timed, timeoutCancel := context.WithTimeout(ctx, boundedRequestTimeout(httpTimeoutSeconds, ceiling))
+	return timed, func() {
+		stop()
+		timeoutCancel()
+		cancel()
+	}
+}
+
+func shutdownContextWithTimeout(shutdown context.Context, httpTimeoutSeconds int, ceiling time.Duration) (context.Context, context.CancelFunc) {
+	return context.WithTimeout(shutdown, boundedRequestTimeout(httpTimeoutSeconds, ceiling))
+}
+
+func logRequestOutcome(message string, err error, attrs ...any) {
+	fields := append([]any{"err", err}, attrs...)
+	switch {
+	case errors.Is(err, context.Canceled):
+		log.Debug(message, fields...)
+	case errors.Is(err, context.DeadlineExceeded):
+		log.Warn(message, fields...)
+	default:
+		log.Error(message, fields...)
+	}
+}
+
+func requestCancellationOutcome(err error) (string, bool) {
+	switch {
+	case errors.Is(err, context.Canceled):
+		return "cancelled", true
+	case errors.Is(err, context.DeadlineExceeded):
+		return "timeout", true
+	default:
+		return "", false
+	}
+}
+
+func RequestCancellationObserver(next echo.HandlerFunc) echo.HandlerFunc {
+	return func(c *echo.Context) error {
+		method := c.Request().Method
+		route := c.Path()
+		if route == "" {
+			route = "unknown"
+		}
+
+		requestCtx := c.Request().Context()
+		started := time.Now()
+		handlerDone := make(chan struct{})
+		stop := context.AfterFunc(requestCtx, func() {
+			outcome, ok := requestCancellationOutcome(requestCtx.Err())
+			if !ok {
+				return
+			}
+			select {
+			case <-handlerDone:
+				return
+			default:
+			}
+			log.Warn("request context ended",
+				"method", method,
+				"route", route,
+				"outcome", outcome,
+				"elapsed", time.Since(started),
+			)
+		})
+		defer func() {
+			close(handlerDone)
+			stop()
+		}()
+
+		return next(c)
+	}
+}
