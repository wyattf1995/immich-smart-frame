diff --git a/internal/webhooks/webhooks_dispatcher.go b/internal/webhooks/webhooks_dispatcher.go
new file mode 100644
index 00000000..98c8d967
--- /dev/null
+++ b/internal/webhooks/webhooks_dispatcher.go
@@ -0,0 +1,239 @@
+package webhooks
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/url"
+	"sync"
+	"time"
+
+	"charm.land/log/v2"
+	"github.com/damongolding/immich-kiosk/internal/common"
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/damongolding/immich-kiosk/internal/immich"
+	"github.com/damongolding/immich-kiosk/internal/utils"
+)
+
+const (
+	defaultWebhookDispatchCapacity = 4
+	defaultWebhookTimeout          = 20 * time.Second
+	maxWebhookTimeout              = 40 * time.Second
+)
+
+type dispatcher struct {
+	sem       chan struct{}
+	timeout   time.Duration
+	inFlight  sync.Map
+	workers   sync.WaitGroup
+	admission sync.Mutex
+	draining  bool
+}
+
+func newDispatcher(capacity int, timeout time.Duration) *dispatcher {
+	if capacity < 1 {
+		capacity = 1
+	}
+	if timeout <= 0 {
+		timeout = defaultWebhookTimeout
+	}
+	return &dispatcher{
+		sem:     make(chan struct{}, capacity),
+		timeout: timeout,
+	}
+}
+
+func (d *dispatcher) scheduleWithContext(parent context.Context, key string, work func(context.Context)) bool {
+	return d.scheduleWithContextAndTimeout(parent, key, d.timeout, work)
+}
+
+func (d *dispatcher) scheduleWithContextAndTimeout(parent context.Context, key string, timeout time.Duration, work func(context.Context)) bool {
+	d.admission.Lock()
+	defer d.admission.Unlock()
+
+	select {
+	case <-parent.Done():
+		return false
+	default:
+	}
+	if d.draining {
+		return false
+	}
+	if _, loaded := d.inFlight.LoadOrStore(key, struct{}{}); loaded {
+		return false
+	}
+	select {
+	case d.sem <- struct{}{}:
+	default:
+		d.inFlight.Delete(key)
+		return false
+	}
+
+	d.workers.Add(1)
+	go func() {
+		defer d.workers.Done()
+		defer func() {
+			<-d.sem
+			d.inFlight.Delete(key)
+		}()
+
+		if timeout <= 0 {
+			timeout = d.timeout
+		}
+		ctx, cancel := context.WithTimeout(parent, timeout)
+		defer cancel()
+		work(ctx)
+	}()
+
+	return true
+}
+
+func (d *dispatcher) drain(ctx context.Context) bool {
+	d.admission.Lock()
+	d.draining = true
+	d.admission.Unlock()
+
+	done := make(chan struct{})
+	go func() {
+		d.workers.Wait()
+		close(done)
+	}()
+
+	select {
+	case <-done:
+		return true
+	case <-ctx.Done():
+		return false
+	}
+}
+
+var webhookDispatcher = newDispatcher(defaultWebhookDispatchCapacity, defaultWebhookTimeout)
+
+func logDispatchOutcome(message string, err error, attrs ...any) {
+	fields := append([]any{"err", err}, attrs...)
+	switch {
+	case errors.Is(err, context.Canceled):
+		log.Debug(message, fields...)
+	case errors.Is(err, context.DeadlineExceeded):
+		log.Warn(message, fields...)
+	default:
+		log.Error(message, fields...)
+	}
+}
+
+func webhookTimeoutSeconds(httpTimeout int) time.Duration {
+	timeout := time.Duration(httpTimeout) * time.Second
+	switch {
+	case timeout <= 0:
+		return defaultWebhookTimeout
+	case timeout > maxWebhookTimeout:
+		return maxWebhookTimeout
+	default:
+		return timeout
+	}
+}
+
+func DrainWebhookDispatch(ctx context.Context) bool {
+	return webhookDispatcher.drain(ctx)
+}
+
+func enqueueWebhook(ctx context.Context, requestData *common.RouteRequestData, kioskVersion string, event WebhookEvent, viewData common.ViewData) {
+	requestConfig := requestData.RequestConfig
+	timeout := webhookTimeoutSeconds(requestConfig.Kiosk.HTTPTimeout)
+	eventID := utils.GenerateUUID()
+
+	for _, userWebhook := range requestConfig.Webhooks {
+		if userWebhook.Event != string(event) {
+			continue
+		}
+
+		parsedURL, err := url.Parse(userWebhook.URL)
+		if err != nil {
+			log.Error("invalid webhook URL", "event", event, "eventID", eventID, "err", err)
+			continue
+		}
+
+		images := make([]immich.Asset, len(viewData.Assets))
+		for i, image := range viewData.Assets {
+			images[i] = image.ImmichAsset
+		}
+
+		payload := Payload{
+			Meta: Meta{
+				Source:  "immich-kiosk",
+				Version: kioskVersion,
+			},
+			EventID:    eventID,
+			Event:      string(event),
+			Timestamp:  time.Now().Format(time.RFC3339),
+			DeviceID:   requestData.DeviceID,
+			ClientName: requestData.ClientName,
+			Assets:     images,
+			Config:     requestConfig,
+			AssetCount: len(images),
+		}
+
+		jsonPayload, err := json.Marshal(payload)
+		if err != nil {
+			log.Error("webhook marshal", "event", event, "eventID", eventID, "err", err)
+			continue
+		}
+
+		key := eventID + "|" + userWebhook.URL
+		log.Debug("webhook dispatch admission",
+			"event", event,
+			"eventID", eventID,
+			"host", parsedURL.Host,
+			"timeout", timeout,
+		)
+		if !webhookDispatcher.scheduleWithContextAndTimeout(ctx, key, timeout, func(workerCtx context.Context) {
+			deliverWebhook(workerCtx, userWebhook, parsedURL, jsonPayload, event, eventID)
+		}) {
+			log.Warn("webhook dispatch rejected",
+				"event", event,
+				"eventID", eventID,
+				"host", parsedURL.Host,
+			)
+		}
+	}
+}
+
+func deliverWebhook(ctx context.Context, webhook config.Webhook, parsedURL *url.URL, payload []byte, event WebhookEvent, eventID string) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, webhook.URL, bytes.NewBuffer(payload))
+	if err != nil {
+		log.Error("webhook request creation", "event", event, "eventID", eventID, "host", parsedURL.Host, "err", err)
+		return
+	}
+
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-Kiosk-Event-ID", eventID)
+	if webhook.Secret != "" {
+		signature := utils.CalculateSignature(webhook.Secret, string(payload))
+		req.Header.Set("X-Kiosk-Signature-256", "sha256="+signature)
+	}
+
+	resp, err := (&http.Client{}).Do(req)
+	if err != nil {
+		logDispatchOutcome("webhook post", err, "event", event, "eventID", eventID, "host", parsedURL.Host)
+		return
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		log.Error("webhook request failed",
+			"event", event,
+			"eventID", eventID,
+			"host", parsedURL.Host,
+			"status", resp.StatusCode,
+		)
+		return
+	}
+
+	log.Debug("webhook dispatched",
+		"event", event,
+		"eventID", eventID,
+		"host", parsedURL.Host,
+	)
+}
