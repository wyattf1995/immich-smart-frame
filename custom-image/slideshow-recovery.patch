@@ -0,0 +1,31 @@
+type HTMXRequestEvent = Event & {
+    detail?: {
+        pathInfo?: {
+            requestPath?: string;
+        };
+    };
+};
+
+const ASSET_REQUEST_PATH = /^\/asset\/(new|offline|previous)$/;
+
+/**
+ * Completes an asset request even when HTMX has no content to swap.
+ *
+ * HTMX emits afterRequest for success, HTTP failure, abort, timeout, and
+ * network-error paths. Releasing the request lock here prevents the next
+ * slideshow tick from being rejected after a response without afterSwap.
+ */
+export function recoverAssetRequest(
+    event: Event,
+    releaseRequestLock: () => void,
+    startPolling: () => void,
+): boolean {
+    const requestEvent = event as HTMXRequestEvent;
+    const path = requestEvent.detail?.pathInfo?.requestPath || "";
+
+    if (!ASSET_REQUEST_PATH.test(path)) return false;
+
+    releaseRequestLock();
+    startPolling();
+    return true;
+}
