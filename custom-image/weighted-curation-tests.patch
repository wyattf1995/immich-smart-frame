@@ -0,0 +1,70 @@
+package immich
+
+import (
+	"testing"
+
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestAlbumPenaltyFactorUsesStrongestMatchingPenalty(t *testing.T) {
+	albums := Albums{{ID: "casual-album"}, {ID: "overrepresented-album"}}
+	penalties := []config.AlbumPenalty{
+		{Album: "casual-album", Factor: 0.6},
+		{Album: "overrepresented-album", Factor: 0.2},
+	}
+
+	factor := albumPenaltyFactor(albums, penalties)
+
+	assert.InDelta(t, 0.2, factor, 0.0001)
+}
+
+func TestAlbumPenaltyFactorDefaultsToOne(t *testing.T) {
+	albums := Albums{{ID: "unmatched-album"}}
+	penalties := []config.AlbumPenalty{{Album: "other-album", Factor: 0.2}}
+
+	factor := albumPenaltyFactor(albums, penalties)
+
+	assert.InDelta(t, 1.0, factor, 0.0001)
+}
+
+func TestAcceptsAlbumPenaltyAtConfiguredRateBoundary(t *testing.T) {
+	albums := Albums{{ID: "overrepresented-album"}}
+	penalties := []config.AlbumPenalty{{Album: "overrepresented-album", Factor: 0.2}}
+
+	assert.True(t, acceptsAlbumPenalty(albums, penalties, 0.1999))
+	assert.False(t, acceptsAlbumPenalty(albums, penalties, 0.2))
+}
+
+func TestAcceptsAlbumPenaltyWithoutMatchingAlbum(t *testing.T) {
+	albums := Albums{{ID: "unmatched-album"}}
+	penalties := []config.AlbumPenalty{{Album: "other-album", Factor: 0.2}}
+
+	assert.True(t, acceptsAlbumPenalty(albums, penalties, 0.9999))
+}
+
+func TestAlbumPenaltyRollStableForAssetWithinRequest(t *testing.T) {
+	want := albumPenaltyRoll("asset-a", "request-a")
+
+	for range 20 {
+		assert.Equal(t, want, albumPenaltyRoll("asset-a", "request-a"))
+	}
+	assert.GreaterOrEqual(t, want, 0.0)
+	assert.Less(t, want, 1.0)
+	assert.NotEqual(t, want, albumPenaltyRoll("asset-a", "request-b"))
+	assert.NotEqual(t, want, albumPenaltyRoll("asset-b", "request-a"))
+}
+
+func TestAcceptsAlbumPenaltyForAssetIsStableWithinRequest(t *testing.T) {
+	albums := Albums{{ID: "overrepresented-album"}}
+	penalties := []config.AlbumPenalty{{Album: "overrepresented-album", Factor: 0.5}}
+	want := acceptsAlbumPenaltyForAsset(albums, penalties, "asset-a", "request-a")
+
+	for range 20 {
+		assert.Equal(
+			t,
+			want,
+			acceptsAlbumPenaltyForAsset(albums, penalties, "asset-a", "request-a"),
+		)
+	}
+}
