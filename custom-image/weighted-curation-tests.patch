@@ -0,0 +1,26 @@
+package routes
+
+import (
+	"testing"
+
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestFindCurationProfileCaseInsensitive(t *testing.T) {
+	want := config.CurationProfile{
+		Sources: []config.CuratedSource{{Type: "tag", Value: "People/Family", Weight: 25}},
+	}
+	profiles := map[string]config.CurationProfile{"Family Mix": want}
+
+	got, ok := findCurationProfile(profiles, "  family mix ")
+
+	assert.True(t, ok)
+	assert.Equal(t, want, got)
+}
+
+func TestFindCurationProfileMissing(t *testing.T) {
+	_, ok := findCurationProfile(map[string]config.CurationProfile{}, "missing")
+
+	assert.False(t, ok)
+}
