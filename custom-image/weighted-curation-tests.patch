@@ -0,0 +1,77 @@
+package config
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestCheckCurationNormalizesAlbumPenalties(t *testing.T) {
+	c := &Config{
+		CurationProfile: " balanced ",
+		Curation: CurationSettings{
+			Profiles: map[string]CurationProfile{
+				" balanced ": {
+					AlbumPenalties: []AlbumPenalty{
+						{Album: " overrepresented-album ", Factor: 0.2},
+					},
+				},
+			},
+		},
+	}
+
+	err := c.checkCuration()
+
+	assert.NoError(t, err)
+	profile := c.Curation.Profiles["balanced"]
+	assert.Equal(t, "overrepresented-album", profile.AlbumPenalties[0].Album)
+	assert.InDelta(t, 0.2, profile.AlbumPenalties[0].Factor, 0.0001)
+}
+
+func TestCheckCurationRejectsInvalidAlbumPenalties(t *testing.T) {
+	tests := []struct {
+		name      string
+		penalties []AlbumPenalty
+		wantError string
+	}{
+		{
+			name:      "empty album",
+			penalties: []AlbumPenalty{{Factor: 0.2}},
+			wantError: "album must not be empty",
+		},
+		{
+			name:      "zero factor",
+			penalties: []AlbumPenalty{{Album: "album-a", Factor: 0}},
+			wantError: "factor must be greater than 0 and at most 1",
+		},
+		{
+			name:      "factor above one",
+			penalties: []AlbumPenalty{{Album: "album-a", Factor: 1.1}},
+			wantError: "factor must be greater than 0 and at most 1",
+		},
+		{
+			name: "duplicate album",
+			penalties: []AlbumPenalty{
+				{Album: "album-a", Factor: 0.5},
+				{Album: " album-a ", Factor: 0.2},
+			},
+			wantError: "duplicates album",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := &Config{
+				Curation: CurationSettings{
+					Profiles: map[string]CurationProfile{
+						"balanced": {AlbumPenalties: tt.penalties},
+					},
+				},
+			}
+
+			err := c.checkCuration()
+
+			assert.ErrorContains(t, err, tt.wantError)
+		})
+	}
+}
