+	var buffer bytes.Buffer
+	err := jpeg.Encode(&buffer, image.NewRGBA(image.Rect(0, 0, 2, 1)), &jpeg.Options{Quality: 80})
+	require.NoError(t, err)
+	return buffer.Bytes()
+}
