+func assertHandlerFinishesWithin(t *testing.T, handler echo.HandlerFunc, req *http.Request, budget time.Duration, message string) {
+	t.Helper()
+
+	e := echo.New()
+	rec := httptest.NewRecorder()
+	c := e.NewContext(req, rec)
+
+	done := make(chan error, 1)
+	start := time.Now()
+	go func() {
+		done <- handler(c)
+	}()
+
+	select {
+	case <-done:
+		require.Lessf(t, time.Since(start), budget, message)
+	case <-time.After(budget):
+		select {
+		case <-done:
+		case <-time.After(2 * time.Second):
+			t.Fatal("handler failed to unwind after the cancellation budget expired")
+		}
+		t.Fatalf("%s", message)
+	}
+}
