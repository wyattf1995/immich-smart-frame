+func TestHideAssetTagOnlyInvalidatesPrimaryAssetCache(t *testing.T) {
+	cache.Initialize()
+	cache.Flush()
+	t.Cleanup(cache.Flush)
+
+	baseConfig := newCancellationTestConfig("http://immich.test")
+	baseConfig.Kiosk.Cache = true
+	baseConfig.HideButtonAction = []string{kiosk.HideButtonActionTag}
+	com := common.New()
+
+	t.Run("success", func(t *testing.T) {
+		cache.Flush()
+		cacheKey := mustSeedAssetInfoCache(t, *baseConfig, "asset-a", "frame-a", testImageAsset("asset-a"))
+
+		originalClient := immich.HTTPClient
+		immich.HTTPClient = &http.Client{Transport: routesRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+			switch r.URL.Path {
+			case "/api/tags":
+				return jsonResponse(t, immich.Tags{{ID: "tag-hidden", Name: "hidden", Value: "hidden"}}), nil
+			case "/api/tags/tag-hidden/assets":
+				return jsonResponse(t, []map[string]any{{"success": true}}), nil
+			default:
+				t.Fatalf("unexpected hide success path: %s", r.URL.Path)
+				return nil, nil
+			}
+		})}
+		t.Cleanup(func() { immich.HTTPClient = originalClient })
+
+		req := httptest.NewRequest(http.MethodPost, "/asset/hide", strings.NewReader("assetID=asset-a&tagName=hidden"))
+		req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationForm)
+		req.Header.Set("kiosk-device-id", "frame-a")
+		rec := httptest.NewRecorder()
+		c := echo.New().NewContext(req, rec)
+
+		require.NoError(t, HideAsset(baseConfig, com, true)(c))
+		require.Equal(t, http.StatusOK, rec.Code)
+		_, found := cache.Get(cacheKey)
+		require.False(t, found, "successful tag-only hide must drop the primary asset cache entry")
+	})
+
+	t.Run("ambiguous failure", func(t *testing.T) {
+		cache.Flush()
+		cacheKey := mustSeedAssetInfoCache(t, *baseConfig, "asset-a", "frame-a", testImageAsset("asset-a"))
+
+		originalClient := immich.HTTPClient
+		immich.HTTPClient = &http.Client{Transport: routesRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+			switch r.URL.Path {
+			case "/api/tags":
+				return jsonResponse(t, immich.Tags{{ID: "tag-hidden", Name: "hidden", Value: "hidden"}}), nil
+			case "/api/tags/tag-hidden/assets":
+				return jsonResponse(t, []map[string]any{{"success": false, "error": "race"}}), nil
+			case "/api/assets/asset-a":
+				reconciled := testImageAsset("asset-a")
+				reconciled.Tags = immich.Tags{{ID: "tag-hidden", Name: "hidden", Value: "hidden"}}
+				return jsonResponse(t, reconciled), nil
+			default:
+				t.Fatalf("unexpected hide failure path: %s", r.URL.Path)
+				return nil, nil
+			}
+		})}
+		t.Cleanup(func() { immich.HTTPClient = originalClient })
+
+		req := httptest.NewRequest(http.MethodPost, "/asset/hide", strings.NewReader("assetID=asset-a&tagName=hidden"))
+		req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationForm)
+		req.Header.Set("kiosk-device-id", "frame-a")
+		rec := httptest.NewRecorder()
+		c := echo.New().NewContext(req, rec)
+
+		require.NoError(t, HideAsset(baseConfig, com, true)(c))
+		require.Equal(t, http.StatusConflict, rec.Code)
+		_, found := cache.Get(cacheKey)
+		require.False(t, found, "ambiguous tag-only hide failure must drop the stale primary asset cache entry")
+	})
+}
