+func invokeProcessImage(t *testing.T, ctx context.Context, asset *immich.Asset, requestConfig config.Config, requestID, deviceID string, isPrefetch bool) (image.Image, error) {
+	t.Helper()
+
+	fn := reflect.ValueOf(processImage)
+	var results []reflect.Value
+	switch fn.Type().NumIn() {
+	case 5:
+		results = fn.Call([]reflect.Value{
+			reflect.ValueOf(asset),
+			reflect.ValueOf(requestConfig),
+			reflect.ValueOf(requestID),
+			reflect.ValueOf(deviceID),
+			reflect.ValueOf(isPrefetch),
+		})
+	case 6:
+		results = fn.Call([]reflect.Value{
+			reflect.ValueOf(ctx),
+			reflect.ValueOf(asset),
+			reflect.ValueOf(requestConfig),
+			reflect.ValueOf(requestID),
+			reflect.ValueOf(deviceID),
+			reflect.ValueOf(isPrefetch),
+		})
+	default:
+		t.Fatalf("unexpected processImage signature with %d parameters", fn.Type().NumIn())
+	}
+
+	var img image.Image
+	if value := results[0]; !value.IsNil() {
+		img = value.Interface().(image.Image)
+	}
+	var err error
+	if value := results[1]; !value.IsNil() {
+		err = value.Interface().(error)
+	}
+	return img, err
+}
+
+func pathBase(p string) string {
+	parts := strings.Split(strings.TrimSuffix(p, "/thumbnail"), "/")
+	return parts[len(parts)-1]
+}
