+func TestProcessImageSchedulesLivePhotoLookupWithoutBlockingForeground(t *testing.T) {
+	managerCtx, stopManager := context.WithCancel(context.Background())
+	t.Cleanup(stopManager)
+
+	prevVideoManager := VideoManager
+	videoManager, err := video.New(managerCtx)
+	require.NoError(t, err)
+	VideoManager = videoManager
+	t.Cleanup(func() { VideoManager = prevVideoManager })
+	t.Cleanup(video.DeleteTmpDir)
+
+	requestConfig := *newCancellationTestConfig("http://immich.test")
+	requestConfig.LivePhotos = true
+	foregroundCtx, cancelForeground := context.WithCancel(context.Background())
+	t.Cleanup(cancelForeground)
+	imageAsset := immich.New(foregroundCtx, requestConfig)
+	imageAsset.ID = "image-a"
+	imageAsset.Type = immich.ImageType
+	imageAsset.OriginalMimeType = kiosk.MimeTypeJpeg
+	imageAsset.ExifInfo = immich.ExifInfo{
+		ExifImageWidth:  1920,
+		ExifImageHeight: 1080,
+	}
+	imageAsset.Owner = immich.Owner{
+		ID:    "owner-a",
+		Email: "owner@example.com",
+		Name:  "Owner",
+	}
+	imageAsset.Tags = []immich.Tag{}
+	imageAsset.LivePhotoVideoID = "live-video"
+
+	lookupStarted := make(chan struct{})
+	releaseLookup := make(chan struct{})
+	originalClient := immich.HTTPClient
+	var startOnce sync.Once
+	immich.HTTPClient = &http.Client{Transport: routesRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		switch r.URL.Path {
+		case "/api/assets/live-video":
+			startOnce.Do(func() { close(lookupStarted) })
+			return jsonResponse(t, testVideoAsset("live-video")), nil
+		case "/api/assets/live-video/video/playback":
+			<-releaseLookup
+			return byteResponse(http.StatusOK, "video/mp4", []byte("video-bytes")), nil
+		case "/api/assets/live-video/thumbnail":
+			return byteResponse(http.StatusOK, kiosk.MimeTypeJpeg, mustEncodeJPEG(t)), nil
+		case "/api/assets/image-a/thumbnail":
+			return byteResponse(http.StatusOK, kiosk.MimeTypeJpeg, mustEncodeJPEG(t)), nil
+		default:
+			t.Fatalf("unexpected live-photo request path: %s", r.URL.Path)
+			return nil, nil
+		}
+	})}
+	t.Cleanup(func() { immich.HTTPClient = originalClient })
+
+	started := time.Now()
+	img, processErr := invokeProcessImage(t, foregroundCtx, &imageAsset, requestConfig, "request-a", "device-a", false)
+	require.NoError(t, processErr)
+	require.NotNil(t, img)
+	require.Less(t, time.Since(started), 250*time.Millisecond, "live-photo background admission must not block the foreground route")
+
+	select {
+	case <-lookupStarted:
+	case <-time.After(time.Second):
+		t.Fatal("live-photo lookup was not admitted into background work")
+	}
+	require.True(t, VideoManager.IsDownloading("live-video"), "live-photo lookup should hold a background download reservation")
+
+	cancelForeground()
+	time.Sleep(20 * time.Millisecond)
+	require.True(t, VideoManager.IsDownloading("live-video"), "live-photo lookup should be detached from the foreground request context")
+
+	close(releaseLookup)
+	require.Eventually(t, func() bool {
+		return !VideoManager.IsDownloading("live-video")
+	}, time.Second, 5*time.Millisecond, "live-photo lookup should finish once the detached background work completes")
+}
