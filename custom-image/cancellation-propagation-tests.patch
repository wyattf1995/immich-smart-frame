+func newCancellationAwareImmichClient(t *testing.T, blockedPath string, blockedCalls *atomic.Int32, succeedAfterCancel bool) *http.Client {
+	t.Helper()
+
+	previewBytes := mustEncodeJPEG(t)
+
+	return &http.Client{Transport: routesRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		switch {
+		case r.URL.Path == "/api/search/random":
+			return jsonResponse(t, []immich.Asset{testImageAsset("asset-a")}), nil
+		case r.URL.Path == blockedPath:
+			if blockedCalls != nil {
+				blockedCalls.Add(1)
+			}
+			<-r.Context().Done()
+			if succeedAfterCancel {
+				if strings.HasSuffix(r.URL.Path, "/thumbnail") {
+					return byteResponse(http.StatusOK, kiosk.MimeTypeJpeg, previewBytes), nil
+				}
+				return jsonResponse(t, testImageAsset(pathBase(r.URL.Path))), nil
+			}
+			return nil, r.Context().Err()
+		case strings.HasPrefix(r.URL.Path, "/api/assets/") && strings.HasSuffix(r.URL.Path, "/thumbnail"):
+			return byteResponse(http.StatusOK, kiosk.MimeTypeJpeg, previewBytes), nil
+		case strings.HasPrefix(r.URL.Path, "/api/assets/"):
+			return jsonResponse(t, testImageAsset(pathBase(r.URL.Path))), nil
+		default:
+			t.Fatalf("unexpected Immich request path: %s", r.URL.Path)
+			return nil, nil
+		}
+	})}
+}
