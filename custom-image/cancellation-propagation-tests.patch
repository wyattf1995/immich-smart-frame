+func TestDrainDownloadsBlocksNewAdmissionAndRespectsCallerCancellation(t *testing.T) {
+	cache.Initialize()
+	cache.Flush()
+	DeleteTmpDir()
+	t.Cleanup(cache.Flush)
+	t.Cleanup(DeleteTmpDir)
+
+	requestConfig := config.Config{
+		ImmichURL: "http://immich.test",
+		Kiosk:     config.KioskSettings{Cache: false, HTTPTimeout: 1},
+	}
+
+	t.Run("blocks new admission while draining", func(t *testing.T) {
+		manager, activeStarted, releaseActive, secondaryCalls := newDrainTestManager(t, requestConfig)
+		drain := findDrainMethod(t, manager)
+		require.True(t, invokeScheduleDownload(t, manager, context.Background(), newVideoAssetForManager(context.Background(), requestConfig, "video-a"), requestConfig, "device-a", ""), "first admission should succeed")
+		select {
+		case <-activeStarted:
+		case <-time.After(time.Second):
+			t.Fatal("active video download did not start")
+		}
+
+		drainCtx, cancel := context.WithTimeout(context.Background(), time.Second)
+		defer cancel()
+		done := make(chan bool, 1)
+		go func() {
+			done <- invokeDrainDownloads(t, drain, drainCtx)
+		}()
+
+		time.Sleep(20 * time.Millisecond)
+		require.False(t, invokeScheduleDownload(t, manager, context.Background(), newVideoAssetForManager(context.Background(), requestConfig, "video-b"), requestConfig, "device-b", ""), "drain should block new download admission while it waits for active work")
+		require.Zero(t, secondaryCalls.Load(), "blocked admission must not start a second download")
+
+		close(releaseActive)
+		require.True(t, <-done, "drain should complete once the active download finishes")
+	})
+
+	t.Run("respects caller cancellation", func(t *testing.T) {
+		manager, activeStarted, releaseActive, _ := newDrainTestManager(t, requestConfig)
+		drain := findDrainMethod(t, manager)
+		require.True(t, invokeScheduleDownload(t, manager, context.Background(), newVideoAssetForManager(context.Background(), requestConfig, "video-a"), requestConfig, "device-a", ""), "admission should still succeed before the cancelled drain begins")
+		select {
+		case <-activeStarted:
+		case <-time.After(time.Second):
+			t.Fatal("second active video download did not start")
+		}
+
+		drainCtx, cancel := context.WithTimeout(context.Background(), 25*time.Millisecond)
+		defer cancel()
+		require.False(t, invokeDrainDownloads(t, drain, drainCtx), "drain should return false when its caller is cancelled")
+
+		close(releaseActive)
+		require.Eventually(t, func() bool {
+			return invokeDrainDownloads(t, drain, context.Background())
+		}, time.Second, 10*time.Millisecond, "drain should succeed after the active work is allowed to finish")
+	})
+}
+
+type videoRoundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f videoRoundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func mustEncodeVideoPreviewJPEG(t *testing.T) []byte {
+	t.Helper()
+
+	var buffer bytes.Buffer
+	err := jpeg.Encode(&buffer, image.NewRGBA(image.Rect(0, 0, 2, 1)), &jpeg.Options{Quality: 80})
+	require.NoError(t, err)
+	return buffer.Bytes()
+}
+
+func newDrainTestManager(t *testing.T, requestConfig config.Config) (*Manager, chan struct{}, chan struct{}, *atomic.Int32) {
+	t.Helper()
+
+	managerCtx, stopManager := context.WithCancel(context.Background())
+	t.Cleanup(stopManager)
+	manager, err := New(managerCtx)
+	require.NoError(t, err)
+
+	activeStarted := make(chan struct{})
+	releaseActive := make(chan struct{})
+	secondaryCalls := &atomic.Int32{}
+	originalClient := immich.HTTPClient
+	immich.HTTPClient = &http.Client{Transport: videoRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		switch r.URL.Path {
+		case "/api/assets/video-a/video/playback":
+			close(activeStarted)
+			<-releaseActive
+			return &http.Response{
+				StatusCode: http.StatusOK,
+				Header:     http.Header{"Content-Type": []string{"video/mp4"}},
+				Body:       io.NopCloser(strings.NewReader("video-a")),
+			}, nil
+		case "/api/assets/video-a/thumbnail", "/api/assets/video-b/thumbnail":
+			return &http.Response{
+				StatusCode: http.StatusOK,
+				Header:     http.Header{"Content-Type": []string{kiosk.MimeTypeJpeg}},
+				Body:       io.NopCloser(bytes.NewReader(mustEncodeVideoPreviewJPEG(t))),
+			}, nil
+		case "/api/assets/video-b/video/playback":
+			secondaryCalls.Add(1)
+			return &http.Response{
+				StatusCode: http.StatusOK,
+				Header:     http.Header{"Content-Type": []string{"video/mp4"}},
+				Body:       io.NopCloser(strings.NewReader("video-b")),
+			}, nil
+		default:
+			t.Fatalf("unexpected drain test path: %s", r.URL.Path)
+			return nil, nil
+		}
+	})}
+	t.Cleanup(func() { immich.HTTPClient = originalClient })
+	return manager, activeStarted, releaseActive, secondaryCalls
+}
+
+func newVideoAssetForManager(ctx context.Context, requestConfig config.Config, id string) immich.Asset {
+	asset := immich.New(ctx, requestConfig)
+	asset.ID = id
+	asset.OriginalFileName = id + ".mp4"
+	asset.OriginalMimeType = "video/mp4"
+	return asset
+}
+
+func invokeDownloadVideo(t *testing.T, manager *Manager, ctx context.Context, asset immich.Asset, requestConfig config.Config, deviceID, requestURL string) {
+	t.Helper()
+
+	method := reflect.ValueOf(manager).MethodByName("DownloadVideo")
+	switch method.Type().NumIn() {
+	case 4:
+		method.Call([]reflect.Value{
+			reflect.ValueOf(asset),
+			reflect.ValueOf(requestConfig),
+			reflect.ValueOf(deviceID),
+			reflect.ValueOf(requestURL),
+		})
+	case 5:
+		method.Call([]reflect.Value{
+			reflect.ValueOf(ctx),
+			reflect.ValueOf(asset),
+			reflect.ValueOf(requestConfig),
+			reflect.ValueOf(deviceID),
+			reflect.ValueOf(requestURL),
+		})
+	default:
+		t.Fatalf("unexpected DownloadVideo signature with %d parameters", method.Type().NumIn())
+	}
+}
+
+func findDrainMethod(t *testing.T, manager *Manager) reflect.Value {
+	t.Helper()
+
+	value := reflect.ValueOf(manager)
+	for i := 0; i < value.NumMethod(); i++ {
+		method := value.Method(i)
+		name := value.Type().Method(i).Name
+		if strings.Contains(name, "Drain") {
+			return method
+		}
+	}
+	t.Fatal("video manager is missing a drain method for background downloads")
+	return reflect.Value{}
+}
+
+func invokeDrainDownloads(t *testing.T, method reflect.Value, ctx context.Context) bool {
+	t.Helper()
+
+	require.Equal(t, 1, method.Type().NumIn(), "drain method must accept exactly one context parameter")
+	require.Equal(t, 1, method.Type().NumOut(), "drain method must return exactly one value")
+	require.True(t, method.Type().In(0).Implements(reflect.TypeOf((*context.Context)(nil)).Elem()), "drain method must accept a context.Context")
+	require.Equal(t, reflect.TypeOf(true), method.Type().Out(0), "drain method must return a bool success flag")
+
+	results := method.Call([]reflect.Value{reflect.ValueOf(ctx)})
+	return results[0].Bool()
+}
+
+func invokeScheduleDownload(t *testing.T, manager *Manager, ctx context.Context, asset immich.Asset, requestConfig config.Config, deviceID, requestURL string) bool {
+	t.Helper()
+
+	method := reflect.ValueOf(manager).MethodByName("ScheduleDownload")
+	require.True(t, method.IsValid(), "video manager must expose ScheduleDownload")
+	require.Equal(t, 5, method.Type().NumIn(), "ScheduleDownload signature changed unexpectedly")
+	var results []reflect.Value
+	if method.Type().In(0).Implements(reflect.TypeOf((*context.Context)(nil)).Elem()) {
+		results = method.Call([]reflect.Value{
+			reflect.ValueOf(ctx),
+			reflect.ValueOf(asset),
+			reflect.ValueOf(requestConfig),
+			reflect.ValueOf(deviceID),
+			reflect.ValueOf(requestURL),
+		})
+	} else {
+		require.Equal(t, reflect.TypeOf(asset), method.Type().In(0), "ScheduleDownload should accept an immich.Asset first when it does not take a context")
+		require.Equal(t, reflect.TypeOf(requestConfig), method.Type().In(1), "ScheduleDownload should accept config.Config second")
+		require.Equal(t, reflect.TypeOf(0), method.Type().In(2), "ScheduleDownload should accept timeoutSeconds as an int third parameter")
+		results = method.Call([]reflect.Value{
+			reflect.ValueOf(asset),
+			reflect.ValueOf(requestConfig),
+			reflect.ValueOf(requestConfig.Kiosk.HTTPTimeout),
+			reflect.ValueOf(deviceID),
+			reflect.ValueOf(requestURL),
+		})
+	}
+	require.Len(t, results, 1)
+	return results[0].Bool()
+}
