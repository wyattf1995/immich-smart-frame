+func TestDispatcherRejectsAdmissionWhenCapacityIsFull(t *testing.T) {
+	dispatcher := newDispatcher(1, time.Second)
+	started := make(chan struct{})
+	release := make(chan struct{})
+
+	require.True(t, dispatcher.scheduleWithContext(context.Background(), "first", func(context.Context) {
+		close(started)
+		<-release
+	}))
+
+	<-started
+	require.False(t, dispatcher.scheduleWithContext(context.Background(), "second", func(context.Context) {}), "dispatcher must reject new webhook work once its bounded capacity is full")
+
+	close(release)
+	require.True(t, dispatcher.drain(context.Background()))
+}
+
+func TestDispatcherDerivesWorkerContextFromTimeoutAndParentCancel(t *testing.T) {
+	t.Run("timeout", func(t *testing.T) {
+		dispatcher := newDispatcher(1, 25*time.Millisecond)
+		done := make(chan error, 1)
+
+		require.True(t, dispatcher.scheduleWithContext(context.Background(), "timeout", func(ctx context.Context) {
+			<-ctx.Done()
+			done <- ctx.Err()
+		}))
+
+		select {
+		case err := <-done:
+			require.ErrorIs(t, err, context.DeadlineExceeded)
+		case <-time.After(250 * time.Millisecond):
+			t.Fatal("dispatcher worker did not observe its timeout-bound context")
+		}
+
+		require.True(t, dispatcher.drain(context.Background()))
+	})
+
+	t.Run("parent cancel", func(t *testing.T) {
+		dispatcher := newDispatcher(1, time.Second)
+		parent, cancel := context.WithCancel(context.Background())
+		done := make(chan error, 1)
+
+		require.True(t, dispatcher.scheduleWithContext(parent, "cancel", func(ctx context.Context) {
+			<-ctx.Done()
+			done <- ctx.Err()
+		}))
+
+		cancel()
+
+		select {
+		case err := <-done:
+			require.ErrorIs(t, err, context.Canceled)
+		case <-time.After(250 * time.Millisecond):
+			t.Fatal("dispatcher worker did not observe parent cancellation")
+		}
+
+		require.True(t, dispatcher.drain(context.Background()))
+	})
+}
+
+func TestDispatcherDrainWaitsForWorkersAndRespectsCallerCancel(t *testing.T) {
+	dispatcher := newDispatcher(1, time.Second)
+	started := make(chan struct{})
+	release := make(chan struct{})
+
+	require.True(t, dispatcher.scheduleWithContext(context.Background(), "blocking", func(ctx context.Context) {
+		close(started)
+		select {
+		case <-release:
+		case <-ctx.Done():
+		}
+	}))
+
+	<-started
+
+	drainCtx, cancel := context.WithTimeout(context.Background(), 25*time.Millisecond)
+	defer cancel()
+	require.False(t, dispatcher.drain(drainCtx), "drain must stop waiting when its caller is cancelled")
+
+	close(release)
+	require.True(t, dispatcher.drain(context.Background()), "drain must wait for outstanding workers once they are allowed to finish")
+}
+
+func TestProcessWideWebhookDispatcherContract(t *testing.T) {
+	dispatcherSource, err := os.ReadFile("webhooks_dispatcher.go")
+	require.NoError(t, err)
+	text := string(dispatcherSource)
+
+	require.Regexp(t, regexp.MustCompile(`var webhookDispatcher = newDispatcher\(`), text, "webhook dispatch must use one process-wide dispatcher")
+	require.NotContains(t, text, "dispatcherForTimeout", "webhook dispatch must not select a dispatcher per timeout")
+	require.NotContains(t, text, "webhookDispatchers", "webhook dispatch must not keep a plural dispatcher registry")
+	require.NotContains(t, text, "LoadOrStore(timeout", "webhook dispatch must not key dispatcher selection by timeout")
+	require.Regexp(
+		t,
+		regexp.MustCompile(`(?s)webhookDispatcher\.scheduleWithContextAndTimeout\(\s*ctx,\s*key,\s*timeout,`),
+		text,
+		"webhook enqueue must use the process-wide dispatcher with a per-job timeout",
+	)
+
+	webhooksSource, err := os.ReadFile(filepath.Join("webhooks.go"))
+	require.NoError(t, err)
+	require.NotContains(t, string(webhooksSource), "newDispatcher(", "webhook trigger entrypoints must not create per-request dispatchers")
+	require.True(t, strings.Contains(string(webhooksSource), "enqueueWebhook("), "trigger should still delegate enqueue to the shared dispatcher path")
+}
