+package immich
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+func TestImmichAPICallRetriesTransientSafeReadButNotMutation(t *testing.T) {
+	original := HTTPClient
+	t.Cleanup(func() { HTTPClient = original })
+	var calls atomic.Int32
+	HTTPClient = &http.Client{Transport: roundTripFunc(func(*http.Request) (*http.Response, error) {
+		if calls.Add(1) == 1 {
+			return &http.Response{StatusCode: http.StatusServiceUnavailable, Header: make(http.Header), Body: io.NopCloser(strings.NewReader("busy"))}, nil
+		}
+		return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(strings.NewReader("{}"))}, nil
+	})}
+	asset := New(context.Background(), config.Config{ImmichAPIKey: "key"})
+	_, _, _, err := asset.immichAPICall(context.Background(), http.MethodGet, "http://immich.test/api/assets", nil)
+	require.NoError(t, err)
+	require.EqualValues(t, 2, calls.Load())
+
+	calls.Store(0)
+	_, _, _, err = asset.immichAPICall(context.Background(), http.MethodPost, "http://immich.test/api/assets/asset/rating", []byte(`{}`))
+	require.Error(t, err)
+	require.EqualValues(t, 1, calls.Load())
+}
+
+func TestRetryableOperationOnlyAllowsSelectionPosts(t *testing.T) {
+	require.True(t, retryableOperation(http.MethodPost, "http://immich.test/api/search/random"))
+	require.True(t, retryableOperation(http.MethodPost, "http://immich.test/api/search/metadata"))
+	require.False(t, retryableOperation(http.MethodPost, "http://immich.test/api/assets/asset/like"))
+	require.False(t, retryableOperation(http.MethodDelete, "http://immich.test/api/assets/asset"))
+}
