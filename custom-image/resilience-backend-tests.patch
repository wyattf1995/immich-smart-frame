+package routes
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestForegroundAssetContextHonorsRequestAndShutdown(t *testing.T) {
+	request, cancelRequest := context.WithCancel(context.Background())
+	shutdown, cancelShutdown := context.WithCancel(context.Background())
+	ctx, cancel := foregroundAssetContext(request, shutdown, 1)
+	defer cancel()
+	cancelRequest()
+	require.Eventually(t, func() bool { return ctx.Err() == context.Canceled }, time.Second, time.Millisecond)
+
+	ctx, cancel = foregroundAssetContext(context.Background(), shutdown, 1)
+	defer cancel()
+	cancelShutdown()
+	require.Eventually(t, func() bool { return ctx.Err() == context.Canceled }, time.Second, time.Millisecond)
+}
+
+func TestPrefetchSchedulerStopsWhenParentStopsAndDrains(t *testing.T) {
+	scheduler := newPrefetchScheduler(1, time.Second)
+	parent, stop := context.WithCancel(context.Background())
+	started := make(chan struct{})
+	stopped := make(chan struct{})
+	require.True(t, scheduler.scheduleWithContext(parent, "one", func(ctx context.Context) {
+		close(started)
+		<-ctx.Done()
+		close(stopped)
+	}))
+	<-started
+	stop()
+	require.Eventually(t, func() bool { select { case <-stopped: return true; default: return false } }, time.Second, time.Millisecond)
+	drainCtx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	require.True(t, scheduler.drain(drainCtx))
+}
