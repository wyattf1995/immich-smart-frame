+package config
+
+import (
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestSnapshotUsesIndependentRequestLock(t *testing.T) {
+	c := New()
+	c.Kiosk.HTTPTimeout = 20
+	snapshot := c.Snapshot()
+	require.NotSame(t, c.mu, snapshot.mu)
+	snapshot.Kiosk.HTTPTimeout = 1
+	require.Equal(t, 20, c.Kiosk.HTTPTimeout)
+
+	var wg sync.WaitGroup
+	for range 100 {
+		wg.Go(func() { _ = c.Snapshot() })
+	}
+	wg.Wait()
+}
