+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { recoverAssetRequest } from "../src/ts/asset-request-recovery.ts";
+
+function requestEvent(path?: string): Event {
+    return {
+        detail: path === undefined ? {} : { pathInfo: { requestPath: path } },
+    } as unknown as Event;
+}
+
+test("asset requests always release their lock before polling restarts", () => {
+    for (const path of ["/asset/new", "/asset/offline", "/asset/previous"]) {
+        const calls: string[] = [];
+        const recovered = recoverAssetRequest(
+            requestEvent(path),
+            () => calls.push("release"),
+            () => calls.push("start"),
+        );
+
+        assert.equal(recovered, true, path);
+        assert.deepEqual(calls, ["release", "start"], path);
+    }
+});
+
+test("unrelated and malformed requests do not alter slideshow state", () => {
+    for (const event of [
+        requestEvent("/weather"),
+        requestEvent(),
+        {} as Event,
+    ]) {
+        const calls: string[] = [];
+        const recovered = recoverAssetRequest(
+            event,
+            () => calls.push("release"),
+            () => calls.push("start"),
+        );
+
+        assert.equal(recovered, false);
+        assert.deepEqual(calls, []);
+    }
+});
