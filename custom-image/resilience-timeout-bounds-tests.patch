+func TestNonpositiveHTTPTimeoutUsesDefault(t *testing.T) {
+	c := New()
+	c.Kiosk.HTTPTimeout = 0
+	c.checkHTTPTimeout()
+	require.Equal(t, 20, c.Kiosk.HTTPTimeout)
+	c.Kiosk.HTTPTimeout = -1
+	c.checkHTTPTimeout()
+	require.Equal(t, 20, c.Kiosk.HTTPTimeout)
+	c.Kiosk.HTTPTimeout = 7
+	c.checkHTTPTimeout()
+	require.Equal(t, 7, c.Kiosk.HTTPTimeout)
+}
