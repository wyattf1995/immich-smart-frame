+package config
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/labstack/echo/v5"
+	"github.com/stretchr/testify/require"
+)
+
+func TestExcludedAssetsRemainServerPolicyWhenURLOverridesAreApplied(t *testing.T) {
+	cfg := New()
+	cfg.ExcludedAssets = []string{"protected-asset"}
+	req := httptest.NewRequest(http.MethodGet, "/?excluded_assets=none&excluded_asset=other-asset", nil)
+	context := echo.New().NewContext(req, httptest.NewRecorder())
+
+	require.NoError(t, cfg.ConfigWithOverrides(context.QueryParams(), context))
+	require.Equal(t, []string{"protected-asset"}, cfg.ExcludedAssets)
+}
+
+func TestExcludedAssetsRemainServerPolicyAcrossJSONBinding(t *testing.T) {
+	for _, body := range []string{
+		`{"excludedAssets":[]}`,
+		`{"excludedAssets":["request-injected-asset","request-injected-second"]}`,
+	} {
+		// Two elements force encoding/json to exercise the shared backing-array
+		// overwrite path, rather than only replacing a zero-length destination.
+		baseline := []string{"protected-asset", "protected-second"}
+		cfg := New()
+		cfg.ExcludedAssets = append([]string(nil), baseline...)
+		req := httptest.NewRequest(http.MethodPost, "/", strings.NewReader(body))
+		req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationJSON)
+		context := echo.New().NewContext(req, httptest.NewRecorder())
+
+		require.NoError(t, cfg.ConfigWithOverrides(context.QueryParams(), context), body)
+		require.Equal(t, baseline, cfg.ExcludedAssets, body)
+		require.Equal(t, []string{"protected-asset", "protected-second"}, baseline, "binding must not mutate the cloned baseline")
+	}
+}
+
+func TestExcludedAssetsRemainServerPolicyAfterMalformedJSONBinding(t *testing.T) {
+	baseline := []string{"protected-asset", "protected-second"}
+	cfg := New()
+	cfg.ExcludedAssets = append([]string(nil), baseline...)
+	req := httptest.NewRequest(http.MethodPost, "/", strings.NewReader(`{"excludedAssets":["request-injected",42]}`))
+	req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationJSON)
+	context := echo.New().NewContext(req, httptest.NewRecorder())
+
+	require.Error(t, cfg.ConfigWithOverrides(context.QueryParams(), context))
+	require.Equal(t, baseline, cfg.ExcludedAssets, "a partial bind must restore the full hard policy")
+}
+
+func TestExcludedAlbumsRetainConfiguredBaselineAcrossOverrides(t *testing.T) {
+	tests := []struct {
+		name   string
+		method string
+		target string
+		body   string
+		want   []string
+	}{
+		{name: "query none", method: http.MethodGet, target: "/?excluded_album=none", want: []string{"protected-album"}},
+		{name: "query addition", method: http.MethodGet, target: "/?exclude_album=request-album", want: []string{"protected-album", "request-album"}},
+		{name: "JSON clear", method: http.MethodPost, target: "/", body: `{"excluded_albums":[]}`, want: []string{"protected-album"}},
+		{name: "JSON replacement", method: http.MethodPost, target: "/", body: `{"excluded_albums":["request-album"]}`, want: []string{"protected-album", "request-album"}},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			cfg := New()
+			cfg.ExcludedAlbums = []string{"protected-album"}
+			req := httptest.NewRequest(test.method, test.target, strings.NewReader(test.body))
+			if test.body != "" {
+				req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationJSON)
+			}
+			context := echo.New().NewContext(req, httptest.NewRecorder())
+
+			require.NoError(t, cfg.ConfigWithOverrides(context.QueryParams(), context))
+			require.Equal(t, test.want, cfg.ExcludedAlbums)
+		})
+	}
+}
+
+func TestExcludedAssetsFingerprintIsOrderIndependentAndContentSensitive(t *testing.T) {
+	left := Config{ExcludedAssets: []string{"asset-b", "asset-a"}}
+	right := Config{ExcludedAssets: []string{"asset-a", "asset-b"}}
+	different := Config{ExcludedAssets: []string{"asset-a", "asset-c"}}
+
+	require.Equal(t, left.ExcludedAssetsFingerprint(), right.ExcludedAssetsFingerprint())
+	require.NotEqual(t, left.ExcludedAssetsFingerprint(), different.ExcludedAssetsFingerprint())
+}
+
+func TestExcludedAssetsAreRedactedFromSerializedConfig(t *testing.T) {
+	config := Config{ExcludedAssets: []string{"hard-excluded-private-id"}}
+
+	serialized := config.SanitizedYaml()
+	require.NotContains(t, serialized, "hard-excluded-private-id")
+}
+
+func TestDebugConfigStringRedactsHardExclusionsAndSecrets(t *testing.T) {
+	config := Config{
+		ExcludedAssets:     []string{"hard-excluded-private-id"},
+		ImmichAPIKey:       "private-api-key",
+		ImmichUsersAPIKeys: map[string]string{"private-user": "private-user-key"},
+	}
+	config.Kiosk.DebugVerbose = true
+
+	serialized := config.String()
+	for _, privateValue := range []string{"hard-excluded-private-id", "private-api-key", "private-user", "private-user-key"} {
+		require.NotContains(t, serialized, privateValue)
+	}
+	require.Contains(t, serialized, "excludedAssets", "the public config shape remains useful for debugging")
+	require.Contains(t, serialized, "REDACTED", "redacted fields retain the existing marker")
+}
