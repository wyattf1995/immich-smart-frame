diff --git a/ci/performance-finalization-contract.test.py b/ci/performance-finalization-contract.test.py
new file mode 100755
index 0000000..2cabd5a
--- /dev/null
+++ b/ci/performance-finalization-contract.test.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""Lightweight contracts for performance validation finalization and reports."""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parent.parent
+RUNNER = ROOT / "ci/performance-nas.sh"
+SHARED_RUNNER = ROOT / "ci/shared-playback-nas.sh"
+REPORTER = ROOT / "ci/shared-playback-report.mjs"
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise AssertionError(message)
+
+
+def static_runner_contract() -> None:
+    source = RUNNER.read_text()
+    require(source.index("trap early_exit EXIT") < source.index("manifest \"$source_manifest_before\""),
+            "early sanitizer trap must cover source manifest and acquisition")
+    require("if ! finalize_report" not in source,
+            "finalizer must not run in an errexit-suppressed conditional")
+    require("local original_status=$?" in source,
+            "exit trap must retain the original command status")
+    require("if [[ $status -eq 0 && $finalization_status -ne 0 ]]; then" in source,
+            "finalization may replace only a successful original status")
+    require("manifest \"$source_manifest_after\" || return 1" in source,
+            "failed post-validation manifest must fail finalization")
+    require("--status \"$report_status\"" in source,
+            "reporter must receive guard-derived final status")
+    require("text.endswith('_templ.go') and (root / (text[:-len('_templ.go')] + '.templ')).is_file()" in source,
+            "only generated companions of transported templates may be excluded")
+    assets = source.index("run_step frontend-css")
+    templates = source.index("run_step templ-generate")
+    backend_proof = source.index("run_step backend-performance-proof env CI=1")
+    require(assets < templates < backend_proof,
+            "frontend embedded assets and templ output must precede backend route proofs")
+    require("run_step go-mod-download env CI=1 \"$go_bin\" mod download" in source,
+            "templ must use the pinned Go tool module graph")
+    require("generated_templates_manifest \"$generated_template_manifest\"" in source,
+            "generated template output must have a separate hash manifest")
+    require("shared-playback-report.mjs --status passed" in SHARED_RUNNER.read_text(),
+            "the completed shared-playback runner must provide its authoritative report status")
+
+
+def write_executable(path: Path, body: str) -> None:
+    path.write_text(body)
+    path.chmod(0o700)
+
+
+def run_report(status: str, commands: str, browser_available: bool = True) -> tuple[dict[str, object], int]:
+    node = shutil.which("node")
+    require(node is not None, "node is required for this lightweight report contract")
+    with tempfile.TemporaryDirectory(prefix="performance-finalization-") as temporary:
+        root = Path(temporary)
+        runtime = root / "runtime"
+        package = runtime / "package.json"
+        playwright = runtime / "node_modules/playwright"
+        playwright_core = runtime / "node_modules/playwright-core"
+        playwright.mkdir(parents=True)
+        playwright_core.mkdir(parents=True)
+        package.write_text('{"name":"synthetic-runtime"}\n')
+        (playwright / "package.json").write_text('{"name":"playwright","version":"0.0.0-test"}\n')
+        (playwright_core / "package.json").write_text('{"name":"playwright-core","exports":{"./package.json":"./package.json"}}\n')
+        (playwright_core / "browsers.json").write_text('{"browsers":[{"name":"chromium-headless-shell","revision":"1243"}]}\n')
+        browser_root = root / "ms-playwright"
+        if browser_available:
+            browser = browser_root / "chromium_headless_shell-1243" / "chrome-headless-shell-linux64" / "chrome-headless-shell"
+            browser.parent.mkdir(parents=True)
+            write_executable(browser, "#!/bin/sh\necho Chromium 0.0.0-test\n")
+        go = root / "go"
+        write_executable(go, "#!/bin/sh\necho 'go version go1.26.6 synthetic'\n")
+        report = root / "report"
+        report.mkdir()
+        identity = root / "source-identity.json"
+        identity.write_text('{"status":"failed","schema":1}\n')
+        command_file = root / "commands.tsv"
+        command_file.write_text(commands)
+        log = root / "sanitized.log"
+        log.write_text("synthetic\n")
+        archive = root / "report.zip"
+        environment = os.environ | {"PLAYWRIGHT_RUNTIME_PACKAGE": str(package), "PLAYWRIGHT_BROWSERS_PATH": str(browser_root)}
+        completed = subprocess.run(
+            [node, str(REPORTER), "--status", status,
+             "--report-dir", str(report), "--source-identity", str(identity),
+             "--commands", str(command_file), "--log", str(log),
+             "--node", node, "--go", str(go), "--zip", str(archive)],
+            cwd=ROOT,
+            env=environment,
+            text=True,
+            capture_output=True,
+        )
+        require(archive.is_file() and archive.stat().st_size > 0, "report archive missing")
+        return json.loads((report / "summary.json").read_text()), completed.returncode
+
+
+def report_status_contract() -> None:
+    # A direct postcondition/receipt guard can fail without a failed run_step row.
+    guard_failed, guard_exit = run_report("failed", "all-steps\tpassed\tsynthetic\n")
+    require(guard_exit == 0, "a verified runtime may archive a preexisting failed validation")
+    require(guard_failed["status"] == "failed", "guard-derived failure must govern summary status")
+    require(guard_failed["requestedStatus"] == "failed", "summary must retain requested status")
+    require(guard_failed["failedCommands"] == [], "fixture intentionally has no failed command row")
+    files = guard_failed["reportFiles"]
+    require("tools.json" in files, "runtime receipt must be included in report inventory")
+    require(guard_failed["browserProbeStatus"] == "verified", "installed headless shell must be recorded")
+
+    unavailable, unavailable_exit = run_report("passed", "all-steps\tpassed\tsynthetic\n", browser_available=False)
+    require(unavailable_exit != 0, "unavailable browser probe must fail the report step after evidence is saved")
+    require(unavailable["status"] == "failed", "missing headless shell must fail closed without discarding the receipt")
+    require(unavailable["browserProbeStatus"] == "unavailable", "unavailable browser probe must be explicit")
+
+    command_failed, command_exit = run_report("passed", "step\tfailed\tsynthetic\n")
+    require(command_exit == 0, "verified runtime must preserve command failure in the summary without masking it")
+    require(command_failed["status"] == "failed", "failed command still governs a nominally passed report")
+
+
+if __name__ == "__main__":
+    static_runner_contract()
+    report_status_contract()
+    print("performance finalization contracts passed")
diff --git a/ci/performance-nas.sh b/ci/performance-nas.sh
new file mode 100755
index 0000000..3d1cd5e
--- /dev/null
+++ b/ci/performance-nas.sh
@@ -0,0 +1,344 @@
+#!/usr/bin/env bash
+# Pinned, credential-free NAS validation for approved Immich backend and decoder
+# performance work. The admitted source archive intentionally has no .git metadata
+# or /run identity mount; this runner records a full transport manifest for the
+# external agent-nas receipt to bind after export.
+set -euo pipefail
+umask 077
+
+readonly NODE_VERSION='26.7.0'
+readonly NODE_SHA256='982aa24dd8be4c889c6a8ab337ddff3b0896645b20f4239356e80552c16277ee'
+readonly NODE_URL="https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz"
+readonly GO_VERSION='1.26.6'
+readonly GO_SHA256='708effb774be8237570d0add163225abbdfaf4fca28b2611df167beba4feef89'
+readonly GO_URL="https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz"
+
+readonly root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
+cd "$root_dir"
+readonly workspace_dir="$root_dir/.nas-performance"
+readonly tools_dir="$workspace_dir/toolchains"
+readonly cache_dir="$workspace_dir/cache"
+readonly temp_dir="$workspace_dir/tmp"
+readonly report_dir="$root_dir/reports/performance"
+readonly report_zip="$root_dir/reports/performance-validation.zip"
+readonly raw_log="$workspace_dir/validation.raw.log"
+readonly sanitized_log="$report_dir/sanitized.log"
+readonly command_report="$report_dir/commands.tsv"
+readonly source_manifest_before="$report_dir/transport-source-manifest-before.json"
+readonly source_manifest_after="$report_dir/transport-source-manifest-after.json"
+readonly generated_template_manifest="$report_dir/generated-template-manifest.json"
+readonly source_identity="$report_dir/source-identity.json"
+
+mkdir -p "$tools_dir" "$cache_dir/npm" "$cache_dir/go-build" "$cache_dir/gomod" \
+  "$cache_dir/config" "$cache_dir/system" "$workspace_dir/gopath" "$temp_dir" "$report_dir"
+shopt -s nullglob
+chmod 700 "$workspace_dir" "$tools_dir" "$cache_dir" "$temp_dir" "$report_dir"
+: > "$raw_log"
+: > "$command_report"
+chmod 600 "$raw_log" "$command_report"
+
+sanitize_log() {
+  python3 - "$raw_log" "$sanitized_log" <<'PY'
+import re, sys
+source, destination = map(__import__('pathlib').Path, sys.argv[1:])
+text = source.read_text(errors='replace')
+text = re.sub(r'(?i)\b(authorization|password|token|secret)\b(\s*[:=]\s*)\S+', r'\1\2[REDACTED]', text)
+destination.write_text(text)
+PY
+  chmod 600 "$sanitized_log"
+}
+
+# Keep early acquisition/preflight failures sanitized and visible. This trap is
+# replaced by on_exit once the pinned toolchains are available for full reports.
+early_exit() {
+  local status=$?
+  sanitize_log >/dev/null 2>&1 || true
+  if [[ $status -ne 0 && -f "$sanitized_log" ]]; then
+    tail -n 90 "$sanitized_log" >&2 || true
+  fi
+  exit "$status"
+}
+trap early_exit EXIT
+
+for dependency in bash curl sha256sum tar xz python3; do
+  command -v "$dependency" >/dev/null 2>&1 || {
+    printf 'missing required runtime dependency: %s\n' "$dependency" >&2
+    exit 64
+  }
+done
+[[ -f frontend/package-lock.json && -f go.mod && -f ci/backend-perf-proof.sh && \
+  -f ci/verify-decode-frame-proof.py && -f ci/shared-playback-browser.mjs && \
+  -f ci/shared-photo-quality-browser.mjs ]] || {
+  printf 'materialized source is missing a required performance validation input\n' >&2
+  exit 66
+}
+
+manifest() {
+  local output="$1"
+  python3 - "$root_dir" "$output" <<'PY'
+import hashlib, json, os, sys
+from pathlib import Path
+root, output = map(Path, sys.argv[1:])
+excluded_root_names = {'.git', '.nas-performance', 'reports', 'dist', 'node_modules', 'lost+found'}
+excluded_prefixes = ('frontend/public/assets/css/',)
+excluded_files = {
+    'frontend/public/assets/js/kiosk.js',
+    'frontend/public/assets/js/url-builder.js',
+}
+
+def excluded(relative: Path) -> bool:
+    text = relative.as_posix()
+    # templ emits only the adjacent ignored companion for a transported .templ.
+    # Keep every authored Go file in the integrity manifest.
+    generated_template = text.endswith('_templ.go') and (root / (text[:-len('_templ.go')] + '.templ')).is_file()
+    return (any(part in excluded_root_names for part in relative.parts) or
+            generated_template or
+            text in excluded_files or
+            text.startswith(excluded_prefixes))
+files = {}
+for parent_text, directories, names in os.walk(root, topdown=True, followlinks=False):
+    parent = Path(parent_text)
+    retained = []
+    for name in directories:
+        candidate = parent / name
+        relative = candidate.relative_to(root)
+        if excluded(relative):
+            continue
+        if candidate.is_symlink():
+            raise SystemExit(f'unexpected source directory symlink: {relative}')
+        retained.append(name)
+    directories[:] = retained
+    for name in names:
+        candidate = parent / name
+        relative = candidate.relative_to(root)
+        if excluded(relative):
+            continue
+        if candidate.is_symlink():
+            raise SystemExit(f'unexpected source file symlink: {relative}')
+        if not candidate.is_file():
+            raise SystemExit(f'unexpected source entry: {relative}')
+        files[relative.as_posix()] = hashlib.sha256(candidate.read_bytes()).hexdigest()
+payload = {'schema': 1, 'files': files}
+encoded = json.dumps(payload, sort_keys=True, separators=(',', ':')).encode()
+payload['sha256'] = hashlib.sha256(encoded).hexdigest()
+output.write_text(json.dumps(payload, indent=2, sort_keys=True) + '\n')
+PY
+}
+
+generated_templates_manifest() {
+  local output="$1"
+  python3 - "$root_dir" "$output" <<'PY'
+import hashlib, json, os, sys
+from pathlib import Path
+root, output = map(Path, sys.argv[1:])
+files = {}
+excluded = {'.git', '.nas-performance', 'reports', 'dist', 'node_modules', 'lost+found'}
+for parent_text, directories, names in os.walk(root, topdown=True, followlinks=False):
+    parent = Path(parent_text)
+    directories[:] = [name for name in directories if name not in excluded]
+    for name in names:
+        if not name.endswith('.templ'):
+            continue
+        source = parent / name
+        generated = source.with_name(source.name[:-len('.templ')] + '_templ.go')
+        if generated.is_file() and not generated.is_symlink():
+            files[generated.relative_to(root).as_posix()] = hashlib.sha256(generated.read_bytes()).hexdigest()
+if not files:
+    raise SystemExit('templ generated no companion Go files')
+payload = {'schema': 1, 'files': files}
+encoded = json.dumps(payload, sort_keys=True, separators=(',', ':')).encode()
+payload['sha256'] = hashlib.sha256(encoded).hexdigest()
+output.write_text(json.dumps(payload, indent=2, sort_keys=True) + '\n')
+PY
+}
+
+run_step() {
+  local name="$1"
+  shift
+  printf '%s\tstarted\t%s\n' "$name" "$*" >> "$command_report"
+  if "$@" >> "$raw_log" 2>&1; then
+    printf '%s\tpassed\t%s\n' "$name" "$*" >> "$command_report"
+  else
+    local status=$?
+    printf '%s\tfailed\t%s\n' "$name" "$*" >> "$command_report"
+    return "$status"
+  fi
+}
+
+download_and_verify() {
+  local url="$1" sha="$2" output="$3"
+  run_step "download-$(basename "$output")" curl --fail --location --silent --show-error --output "$output" "$url"
+  printf '%s  %s\n' "$sha" "$output" | sha256sum --check --strict >> "$raw_log" 2>&1
+}
+
+finalize_report() {
+  local requested_status="$1"
+  local report_status="$requested_status"
+  local -a artifact_args=()
+  local -a artifacts=(
+    'dist/kiosk'
+    'frontend/public/assets/css/kiosk.css'
+    'frontend/public/assets/js/kiosk.js'
+    'frontend/public/assets/js/url-builder.js'
+  )
+  local artifact
