+func TestDispatcherDrainWaitsForReservedWebhookPreparation(t *testing.T) {
+	dispatcher := newDispatcher(1, time.Second)
+	requestConfig := config.New()
+	requestConfig.Webhooks = config.Webhooks{{Event: string(NewAsset), URL: "http://127.0.0.1:1"}}
+	requestData := &common.RouteRequestData{RequestConfig: *requestConfig}
+	prepared := make(chan struct{})
+	release := make(chan struct{})
+	var releaseOnce sync.Once
+	releaseWork := func() { releaseOnce.Do(func() { close(release) }) }
+	t.Cleanup(releaseWork)
+	done := make(chan struct{})
+
+	go func() {
+		defer close(done)
+		enqueueWebhookWithDispatcher(context.Background(), requestData, "test", NewAsset, common.ViewData{}, dispatcher, func(*common.RouteRequestData, string, WebhookEvent, string, common.ViewData) ([]byte, error) {
+			close(prepared)
+			<-release
+			return nil, errors.New("marshal failed")
+		})
+	}()
+	awaitWebhookTestSignal(t, prepared)
+
+	drainCtx, cancel := context.WithTimeout(context.Background(), 25*time.Millisecond)
+	defer cancel()
+	require.False(t, dispatcher.drain(drainCtx), "drain must wait for an admitted synchronous preparation")
+	releaseWork()
+	awaitWebhookTestSignal(t, done)
+	drainWebhookTest(t, dispatcher)
+}
