+        return id;
+    },
+    clearTimeout: (id: number) => timers.delete(id),
+};
+
+function image(decode: () => Promise<void>) {
+    const listeners = new Map<string, () => void>();
+    return {
+        decode,
+        complete: false,
+        naturalWidth: 0,
+        naturalHeight: 0,
+        addEventListener: (name: string, callback: () => void) => listeners.set(name, callback),
+        removeEventListener: (name: string) => listeners.delete(name),
+        fire: (name: string) => listeners.get(name)?.(),
+        listenerCount: () => listeners.size,
+    };
+}
+
+function frame(...images: any[]) {
+    return { querySelectorAll: () => images } as any;
+}
+
+test("sync throw falls back to load", async () => {
+    const current = image(() => { throw new Error("sync"); });
+    const promise = decodeFrame(frame(current), new AbortController().signal, 100);
+    current.complete = true;
+    current.naturalWidth = 1;
+    current.fire("load");
+    await promise;
+});
+
+test("completed valid image skips a non-settling decode", async () => {
+    let calls = 0;
+    const current = image(() => {
+        calls += 1;
+        return new Promise<void>(() => {});
+    });
+    current.complete = true;
+    current.naturalWidth = 1;
+    await decodeFrame(frame(current), new AbortController().signal, 100);
+    assert.equal(calls, 0, "a valid completed image has no decode wait");
+});
+
+test("completed broken image rejects without waiting for an event that already passed", async () => {
+    const current = image(() => new Promise<void>(() => {}));
+    current.complete = true;
+    await assert.rejects(decodeFrame(frame(current), new AbortController().signal, 100), /image decode failed/);
+});
+
+test("abort and timeout settle a never-decoding image", async () => {
+    let current = image(() => new Promise<void>(() => {}));
+    const controller = new AbortController();
+    const aborted = decodeFrame(frame(current), controller.signal, 100);
+    controller.abort();
+    await assert.rejects(aborted, /aborted/);
+
+    current = image(() => new Promise<void>(() => {}));
+    const timedOut = decodeFrame(frame(current), new AbortController().signal, 100);
+    [...timers.values()].pop()?.();
+    await assert.rejects(timedOut, /timed out/);
+});
+
+test("decode rejection falls back to load and consumes late rejection", async () => {
+    let reject!: () => void;
+    const abortedImage = image(() => new Promise<void>((_, rejectDecode) => { reject = rejectDecode; }));
+    const controller = new AbortController();
+    const aborted = decodeFrame(frame(abortedImage), controller.signal, 100);
+    controller.abort();
+    await assert.rejects(aborted, /aborted/);
+    reject();
+    await Promise.resolve();
+
+    const fallbackImage = image(() => Promise.reject(new Error("decode")));
+    const fallback = decodeFrame(frame(fallbackImage), new AbortController().signal, 100);
+    fallbackImage.complete = true;
+    fallbackImage.naturalWidth = 1;
+    await Promise.resolve();
+    fallbackImage.fire("load");
+    await fallback;
+});
+
+test("fallback listeners clean up and an abort between stages settles", async () => {
+    let reject!: () => void;
+    const current = image(() => new Promise<void>((_, rejectDecode) => { reject = rejectDecode; }));
+    const controller = new AbortController();
+    const pending = decodeFrame(frame(current), controller.signal, 100);
+    reject();
+    for (let index = 0; index < 4; index += 1) await Promise.resolve();
+    controller.abort();
+    await assert.rejects(pending, /aborted/);
+    assert.equal(current.listenerCount(), 0, "abort removes fallback load and error listeners");
+});
+
+test("a failed image aborts sibling waits and cleans their listeners", async () => {
+    const broken = image(() => new Promise<void>(() => {}));
+    broken.complete = true;
+    const sibling = image(() => new Promise<void>(() => {}));
+    await assert.rejects(decodeFrame(frame(broken, sibling), new AbortController().signal, 100), /image decode failed/);
+    assert.equal(sibling.listenerCount(), 0, "the rejected sibling does not retain an abort listener or deadline");
+});
