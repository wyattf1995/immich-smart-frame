+proof('same-key-transaction-serialization', 'internal/immich/immich_album.go',
+ 'defer release()', 'release()',
+ ['go','test','-count=1','./internal/immich','-run','^TestAssetFromAlbumSerializesConcurrentCachedResiduals$'],
+ '--- FAIL: TestAssetFromAlbumSerializesConcurrentCachedResiduals')
+proof('cursor-lease-aba', 'internal/immich/immich_album_cursor.go',
+ 'func (r *albumPageCursorRegistry) advanceIfCurrent(key albumPageCursorKey, expected albumPageCursorLease, hasNextPage bool) bool {\n\tr.mu.Lock()\n\tdefer r.mu.Unlock()\n\tentry, ok := r.entries[key]\n\tif !ok || entry.page != expected.page || entry.offset != expected.offset || entry.version != expected.version {',
+ 'func (r *albumPageCursorRegistry) advanceIfCurrent(key albumPageCursorKey, expected albumPageCursorLease, hasNextPage bool) bool {\n\tr.mu.Lock()\n\tdefer r.mu.Unlock()\n\tentry, ok := r.entries[key]\n\tif !ok {',
+ ['go','test','-count=1','./internal/immich','-run','^TestAlbumPageCursorLeaseNeverReusesVersionAfterClearOrEviction$'],
