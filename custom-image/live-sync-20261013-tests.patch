+func TestAssetFromAlbumSerializesConcurrentCachedResiduals(t *testing.T) {
+	cache.Initialize()
+	cache.Flush()
+	t.Cleanup(cache.Flush)
+
+	firstStarted := make(chan struct{})
+	releaseFirst := make(chan struct{})
+	secondRequest := make(chan struct{}, 1)
+	var calls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		call := calls.Add(1)
+		if call == 1 {
+			close(firstStarted)
+			<-releaseFirst
+		} else {
+			secondRequest <- struct{}{}
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"assets":{"items":[{"id":"first","type":"IMAGE","tags":[]},{"id":"second","type":"IMAGE","tags":[]}],"nextPage":"","total":2}}`))
+	}))
+	defer server.Close()
+	var workers sync.WaitGroup
+	defer func() {
+		select {
+		case <-releaseFirst:
+		default:
+			close(releaseFirst)
+		}
+		done := make(chan struct{})
+		go func() { workers.Wait(); close(done) }()
+		select {
+		case <-done:
+		case <-time.After(time.Second):
+			t.Errorf("album selection workers did not drain")
+		}
+	}()
+
+	cfg := config.Config{ImmichURL: server.URL, AlbumOrder: string(Asc), Kiosk: config.KioskSettings{Cache: true, FetchedAssetsSize: 2}}
+	randomCfg := cfg
+	randomCfg.AlbumOrder = string(Rand)
+	require.Equal(t, albumSelectionGateKey(cfg, "album", "display"), albumSelectionGateKey(randomCfg, "album", "display"), "ascending and random presentation share the upstream ascending metadata cache")
+	firstDone := make(chan error, 1)
+	first := New(context.Background(), cfg)
+	workers.Add(1)
+	go func() {
+		defer workers.Done()
+		firstDone <- first.AssetFromAlbum("album", "first", "display")
+	}()
+	<-firstStarted
+	secondDone := make(chan error, 1)
+	second := New(context.Background(), randomCfg)
+	workers.Add(1)
+	go func() {
+		defer workers.Done()
+		secondDone <- second.AssetFromAlbum("album", "second", "display")
+	}()
+	select {
+	case <-secondRequest:
+		t.Fatal("same-key selection reached the API before the first residual was committed")
+	case <-time.After(100 * time.Millisecond):
+	}
+	close(releaseFirst)
+	require.NoError(t, <-firstDone)
+	require.NoError(t, <-secondDone)
+	require.NotEqual(t, first.ID, second.ID, "concurrent callers must consume distinct cached residuals")
+	require.EqualValues(t, 1, calls.Load(), "the second selection must use the committed residual")
+}
