@@ -0,0 +1,50 @@
+package config
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/labstack/echo/v5"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSnapshotSharesImmutableHardExclusionPolicyAndRestoresBindBaseline(t *testing.T) {
+	cfg := New()
+	cfg.ExcludedAssets = []string{"protected", "protected-second"}
+	cfg.compileHardExclusions()
+	snapshot := cfg.Snapshot()
+	require.Same(t, cfg.hardExclusions, snapshot.hardExclusions)
+	require.Same(t, &cfg.ExcludedAssets[0], &snapshot.ExcludedAssets[0])
+
+	req := httptest.NewRequest(http.MethodPost, "/", strings.NewReader(`{"excludedAssets":["request-overwrite","request-overwrite-second"]}`))
+	req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationJSON)
+	context := echo.New().NewContext(req, httptest.NewRecorder())
+	require.NoError(t, snapshot.ConfigWithOverrides(context.QueryParams(), context))
+	require.True(t, snapshot.IsHardExcludedAsset("protected"))
+	require.Equal(t, []string{"protected", "protected-second"}, snapshot.ExcludedAssets)
+	require.Equal(t, []string{"protected", "protected-second"}, cfg.ExcludedAssets, "request binding must not overwrite the loaded shared backing array")
+}
+
+func TestReloadReplacementKeepsExistingHardExclusionSnapshotStable(t *testing.T) {
+	cfg := New()
+	cfg.ExcludedAssets = []string{"old-protected", "old-second"}
+	cfg.compileHardExclusions()
+	oldSnapshot := cfg.Snapshot()
+
+	replacement := New()
+	replacement.ExcludedAssets = []string{"new-protected"}
+	replacement.compileHardExclusions()
+	// Match reloadConfig's replacement operation while retaining its stable lock.
+	replacement.mu = cfg.mu
+	cfg.mu.Lock()
+	*cfg = *replacement
+	cfg.mu.Unlock()
+
+	require.Equal(t, []string{"old-protected", "old-second"}, oldSnapshot.ExcludedAssets)
+	require.True(t, oldSnapshot.IsHardExcludedAsset("old-protected"))
+	require.False(t, oldSnapshot.IsHardExcludedAsset("new-protected"))
+	require.Equal(t, []string{"new-protected"}, cfg.ExcludedAssets)
+	require.True(t, cfg.IsHardExcludedAsset("new-protected"))
+}
