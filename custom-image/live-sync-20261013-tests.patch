index 0000000..d1b2264
--- /dev/null
+++ b/ci/verify-concurrency-backend-proof.py
@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+"""Source-only red/green proof for the C6/C7 backend concurrency guards.
+
+Run this only in the guarded NAS backend validation environment. It mutates one
+source guard at a time, runs its focused Go test, restores byte-identical source,
+and records hashes plus red/green logs under reports/concurrency-backend.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parent.parent
+OUT = ROOT / "reports" / "concurrency-backend"
+TESTS = (
+    Path("internal/config/config_offline_parallel_test.go"),
+    Path("internal/routes/routes_offline_worker_limit_test.go"),
+    Path("internal/webhooks/webhooks_dispatcher_test.go"),
+)
+
+
+@dataclass(frozen=True)
+class Proof:
+    name: str
+    source: Path
+    old: str
+    new: str
+    command: tuple[str, ...]
+    expected_failure: str
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def test_hashes() -> dict[str, str]:
+    return {str(path): sha256(ROOT / path) for path in TESTS}
+
+
+def run(proof: Proof, label: str) -> subprocess.CompletedProcess[str]:
+    result = subprocess.run(proof.command, cwd=ROOT, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+    (OUT / f"{proof.name}-{label}.log").write_text(result.stdout)
+    return result
+
+
+def execute(proof: Proof) -> dict[str, object]:
+    source = ROOT / proof.source
+    original = source.read_bytes()
+    original_text = original.decode("utf-8")
+    if original_text.count(proof.old) != 1:
+        raise AssertionError(f"{proof.name}: mutation marker must occur exactly once")
+
+    before = test_hashes()
+    green_before = run(proof, "green-before")
+    if green_before.returncode != 0:
+        raise AssertionError(f"{proof.name}: focused baseline failed")
+
+    red: subprocess.CompletedProcess[str] | None = None
+    try:
+        source.write_text(original_text.replace(proof.old, proof.new))
+        red = run(proof, "red")
+        if red.returncode == 0 or proof.expected_failure not in red.stdout:
+            raise AssertionError(f"{proof.name}: expected guard {proof.expected_failure!r} did not fail")
+    finally:
+        source.write_bytes(original)
+
+    if source.read_bytes() != original:
+        raise AssertionError(f"{proof.name}: source restore mismatch")
+
+    green_after = run(proof, "green-after")
+    if green_after.returncode != 0:
+        raise AssertionError(f"{proof.name}: restored source failed")
+
+    after = test_hashes()
+    if before != after:
+        raise AssertionError(f"{proof.name}: proof changed a guarding test")
+
+    assert red is not None
+    return {
+        "name": proof.name,
+        "source": str(proof.source),
+        "redExit": red.returncode,
+        "greenBeforeExit": green_before.returncode,
+        "greenAfterExit": green_after.returncode,
+        "expectedFailure": proof.expected_failure,
+        "sourceRestored": True,
+        "testsUnchanged": True,
+        "testSha256Before": before,
+        "testSha256After": after,
+    }
+
+
+def main() -> int:
+    OUT.mkdir(parents=True, exist_ok=True)
+    proofs = (
+        Proof(
+            "offline-runtime-worker-cap",
+            Path("internal/routes/routes_offline.go"),
+            "if workers > config.MaxOfflineParallelDownloads {",
+            "if false {",
+            ("go", "test", "-timeout=30s", "-count=1", "./internal/routes", "-run", "^TestOfflineWorkerLimitKeepsOneSafeWorker$"),
+            "--- FAIL: TestOfflineWorkerLimitKeepsOneSafeWorker",
+        ),
+        Proof(
+            "offline-config-worker-cap",
+            Path("internal/config/config_validation.go"),
+            "if c.OfflineMode.ParallelDownloads > MaxOfflineParallelDownloads {",
+            "if false {",
+            ("go", "test", "-timeout=30s", "-count=1", "./internal/config", "-run", "^TestOfflineParallelDownloadsClampsToOneWorker$"),
+            "--- FAIL: TestOfflineParallelDownloadsClampsToOneWorker",
+        ),
+        Proof(
+            "webhook-rejects-before-payload",
+            Path("internal/webhooks/webhooks_dispatcher.go"),
+            "reservation, admitted := dispatcher.reserveWithContextAndTimeout(ctx, key, timeout)\n\t\tif !admitted {",
+            "_, _ = preparePayload(requestData, kioskVersion, event, eventID, viewData)\n\t\treservation, admitted := dispatcher.reserveWithContextAndTimeout(ctx, key, timeout)\n\t\tif !admitted {",
+            ("go", "test", "-timeout=30s", "-count=1", "./internal/webhooks", "-run", "^TestEnqueueWebhookRejectsBeforePayloadPreparation$"),
+            "a full dispatcher must reject before payload preparation",
+        ),
+        Proof(
+            "webhook-prepare-error-releases-slot",
+            Path("internal/webhooks/webhooks_dispatcher.go"),
+            "if err != nil {\n\t\t\tlog.Error(\"webhook marshal\", \"event\", event, \"eventID\", eventID, \"err\", err)\n\t\t\treservation.releaseSlot()\n\t\t\tcontinue\n\t\t}",
+            "if err != nil {\n\t\t\tlog.Error(\"webhook marshal\", \"event\", event, \"eventID\", eventID, \"err\", err)\n\t\t\tcontinue\n\t\t}",
+            ("go", "test", "-timeout=30s", "-count=1", "./internal/webhooks", "-run", "^TestWebhookPreparationErrorReleasesReservation$"),
+            "--- FAIL: TestWebhookPreparationErrorReleasesReservation",
+        ),
+        Proof(
+            "webhook-immutable-payload-before-return",
+            Path("internal/webhooks/webhooks_dispatcher.go"),
+            '\t\tjsonPayload, err := preparePayload(requestData, kioskVersion, event, eventID, viewData)\n\t\tif err != nil {\n\t\t\tlog.Error("webhook marshal", "event", event, "eventID", eventID, "err", err)\n\t\t\treservation.releaseSlot()\n\t\t\tcontinue\n\t\t}\n\t\tif err := reservation.ctx.Err(); err != nil {\n\t\t\tlogDispatchOutcome("webhook preparation", err, "event", event, "eventID", eventID, "host", parsedURL.Host)\n\t\t\treservation.releaseSlot()\n\t\t\tcontinue\n\t\t}\n\n\t\treservation.start(func(workerCtx context.Context) {\n\t\t\tdeliverWebhook(workerCtx, webhook, parsedURL, jsonPayload, event, eventID)\n\t\t})',
+            '\t\treservation.start(func(workerCtx context.Context) {\n\t\t\tjsonPayload, err := preparePayload(requestData, kioskVersion, event, eventID, viewData)\n\t\t\tif err != nil { return }\n\t\t\tdeliverWebhook(workerCtx, webhook, parsedURL, jsonPayload, event, eventID)\n\t\t})',
+            ("go", "test", "-timeout=30s", "-count=1", "./internal/webhooks", "-run", "^TestEnqueueWebhookWorkerUsesImmutableConfigSnapshot$"),
+            "enqueue returned before immutable payload preparation completed",
+        ),
+    )
+
+    results: list[dict[str, object]] = []
+    receipt = OUT / "source-negative-proof.json"
+    try:
+        for proof in proofs:
+            results.append(execute(proof))
+            receipt.write_text(json.dumps({"status": "in-progress", "proofs": results}, indent=2) + "\n")
+    except Exception:
+        receipt.write_text(json.dumps({"status": "failed", "proofs": results}, indent=2) + "\n")
+        raise
+
+    receipt.write_text(json.dumps({"status": "passed", "proofs": results}, indent=2) + "\n")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
