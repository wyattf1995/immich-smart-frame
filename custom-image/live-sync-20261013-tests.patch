+func TestSharedSelectionConfigRefreshesOnlyServerDenyLists(t *testing.T) {
+	frozen := config.New()
+	frozen.ExcludedAlbums = []string{"frozen-album"}
+	frozen.Curation.Profiles = map[string]config.CurationProfile{
+		"balanced": {Sources: []config.CuratedSource{{Type: "random", Weight: 1}}, AlbumPenalties: []config.AlbumPenalty{}},
+	}
+	frozen.Kiosk.SyncGroups = map[string]config.SyncGroupSettings{
+		"downstairs": {CurationProfile: "balanced", Duration: 45},
+	}
+	live := frozen.Snapshot()
+	live.ExcludedAlbums = []string{"newly-excluded-album"}
+	live.ExcludedAssets = []string{"newly-hard-excluded"}
+	// Model a normalized reload: its hard policy is an immutable compiled object,
+	// not a fallback that a selection may recreate from a copied slice.
+	live.AdoptHardExclusionsFrom(live)
+	live.Curation.Profiles["balanced"] = config.CurationProfile{Sources: []config.CuratedSource{{Type: "album", Value: "must-not-replace", Weight: 1}}}
+	live.Kiosk.SyncGroups["downstairs"] = config.SyncGroupSettings{CurationProfile: "must-not-replace", Duration: 1}
+
+	selection := sharedSelectionConfig(*frozen, &live)
+	require.Equal(t, []string{"newly-excluded-album"}, selection.ExcludedAlbums)
+	require.Equal(t, []string{"newly-hard-excluded"}, selection.ExcludedAssets)
+	require.True(t, selection.IsHardExcludedAsset("newly-hard-excluded"), "fresh deny-list must replace the frozen compiled policy")
+	require.Same(t, live.HardExclusions(), selection.HardExclusions(), "selection must reuse the immutable live hard policy rather than recreate it from a copied slice")
+	require.Equal(t, frozen.Curation.Profiles, selection.Curation.Profiles, "live config reload must not alter frozen shared source policy")
+	require.Equal(t, frozen.Kiosk.SyncGroups, selection.Kiosk.SyncGroups, "live config reload must not alter frozen group controls")
+}
