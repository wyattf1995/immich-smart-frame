+++ b/ci/verify-decode-frame-proof.py
@@ -0,0 +1,99 @@
+#!/usr/bin/env python3
+"""Source-only red/green proof for the bounded frame decoder.
+
+The lockfile-pinned esbuild binary bundles the dependency-free decoder fixtures;
+this deliberately avoids npx/tsx downloads or undeclared runtime dependencies.
+"""
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+root = Path(sys.argv[1]).resolve()
+source = root / "frontend/src/ts/decode-frame.ts"
+tests = (
+    root / "frontend/tests/shared-playback-decode-behavior.test.ts",
+    root / "frontend/tests/shared-playback-decode-contract.test.ts",
+    root / "frontend/tests/shared-playback-decode-sync-contract.test.ts",
+)
+reports = Path(os.environ.get("DECODE_FRAME_PROOF_REPORT_DIR", root / "reports")).resolve()
+node_value = os.environ.get("NODE_BINARY") or shutil.which("node")
+if node_value is None:
+    raise RuntimeError("NODE_BINARY must name an executable Node runtime")
+node = Path(node_value)
+esbuild = Path(os.environ.get("ESBUILD_BINARY", root / "frontend/node_modules/.bin/esbuild"))
+if not node.is_file() or not node.stat().st_mode & 0o111:
+    raise RuntimeError("NODE_BINARY must name an executable Node runtime")
+if not esbuild.is_file() or not esbuild.stat().st_mode & 0o111:
+    raise RuntimeError("ESBUILD_BINARY must name lockfile-installed esbuild")
+reports.mkdir(parents=True, exist_ok=True)
+original = source.read_bytes()
+test_hashes = {str(path.relative_to(root)): hashlib.sha256(path.read_bytes()).hexdigest() for path in tests}
+needle = b'''try {
+        decoded = image.decode();
+    } catch {
+        decoded = Promise.reject(new Error("image decode invocation failed"));
+    }'''
+if original.count(needle) != 1:
+    raise AssertionError("sync-decode fallback mutation needle must occur exactly once")
+
+
+def run_fixtures(label: str) -> subprocess.CompletedProcess[str]:
+    # Contract fixtures resolve ../src from import.meta.url. Keep generated bundles
+    # beside the source tests so that contract remains true during proof execution.
+    output_dir = root / "frontend/tests"
+    outputs: list[Path] = []
+    try:
+        bundle_output: list[str] = []
+        bundle_errors: list[str] = []
+        for index, test in enumerate(tests):
+            with tempfile.NamedTemporaryFile(prefix=f".decode-frame-proof-{index}-", suffix=".mjs", dir=output_dir, delete=False) as handle:
+                output = Path(handle.name)
+            outputs.append(output)
+            bundle = subprocess.run(
+                [str(esbuild), str(test), "--bundle", "--platform=node", "--format=esm", f"--outfile={output}"],
+                cwd=root,
+                text=True,
+                capture_output=True,
+            )
+            bundle_output.append(bundle.stdout)
+            bundle_errors.append(bundle.stderr)
+            if bundle.returncode != 0:
+                result = bundle
+                break
+        else:
+            result = subprocess.run([str(node), "--test", *map(str, outputs)], cwd=root, text=True, capture_output=True)
+        result.stdout = "".join(bundle_output) + result.stdout
+        result.stderr = "".join(bundle_errors) + result.stderr
+        (reports / f"decode-frame-{label}.log").write_text(result.stdout + result.stderr)
+        return result
+    finally:
+        for output in outputs:
+            output.unlink(missing_ok=True)
+
+try:
+    source.write_bytes(original.replace(needle, b"decoded = image.decode();"))
+    red = run_fixtures("red")
+    if red.returncode == 0 or "sync throw falls back to load" not in red.stdout + red.stderr:
+        raise AssertionError("removing the sync fallback did not fail its behavioral fixture")
+finally:
+    source.write_bytes(original)
+if source.read_bytes() != original:
+    raise AssertionError("decoder proof did not restore exact source bytes")
+green = run_fixtures("green")
+if green.returncode != 0:
+    raise AssertionError("restored decoder did not pass its focused tests")
+if {str(path.relative_to(root)): hashlib.sha256(path.read_bytes()).hexdigest() for path in tests} != test_hashes:
+    raise AssertionError("proof changed a test file")
+(reports / "decode-frame-proof.json").write_text(json.dumps({
+    "passed": True,
+    "source_sha256": hashlib.sha256(source.read_bytes()).hexdigest(),
+    "test_hashes": test_hashes,
+    "runner": {"node": str(node), "esbuild": str(esbuild)},
+    "red": "removing sync decode fallback failed the sync-throw behavioral fixture",
+    "green": "restored source passed all bundled decoder fixtures",
+}, indent=2) + "\n")
