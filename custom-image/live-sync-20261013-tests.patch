+		require.Equal(t, 100, payload.Assets[0].People[0].Faces[0].ImageWidth)
+		require.NotEmpty(t, payload.EventID)
+		require.Equal(t, string(NewAsset), payload.Event)
+	case <-time.After(time.Second):
+		t.Fatal("admitted webhook did not deliver its immutable payload")
+	}
+	drainWebhookTest(t, dispatcher)
+}
