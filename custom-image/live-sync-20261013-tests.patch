+#!/usr/bin/env python3
+"""Source-only red/green proof for final performance report status handling."""
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parent.parent
+source = root / "ci/shared-playback-report.mjs"
+test = root / "ci/performance-finalization-contract.test.py"
+original = source.read_bytes()
+test_hash = hashlib.sha256(test.read_bytes()).hexdigest()
+needle = b"requestedStatus === 'failed' ||"
+if original.count(needle) != 1:
+    raise AssertionError("report status mutation needle must occur exactly once")
+
+try:
+    source.write_bytes(original.replace(needle, b"false ||"))
+    red = subprocess.run([sys.executable, str(test)], cwd=root, text=True, capture_output=True)
+    if red.returncode == 0 or "guard-derived failure must govern summary status" not in red.stdout + red.stderr:
+        raise AssertionError("removing requested failure handling did not fail its behavioral fixture")
+finally:
+    source.write_bytes(original)
+if source.read_bytes() != original:
+    raise AssertionError("proof did not restore exact report source bytes")
+green = subprocess.run([sys.executable, str(test)], cwd=root, text=True, capture_output=True)
+if green.returncode != 0:
+    raise AssertionError(green.stdout + green.stderr)
+if hashlib.sha256(test.read_bytes()).hexdigest() != test_hash:
+    raise AssertionError("proof changed its test fixture")
+print("performance finalization source proof passed")
