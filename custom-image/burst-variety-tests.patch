+func TestFrameSelectionSuppressesCaptureBurstsAndCanBeDisabled(t *testing.T) {
+	previous := frameRecentAssets
+	frameRecentAssets = recentFrameAssets{devices: map[string][]recentFrameAsset{}}
+	t.Cleanup(func() { frameRecentAssets = previous })
+
+	captured := time.Date(2026, 9, 4, 12, 0, 0, 0, time.UTC)
+	frameRecentAssets.remember("frame-a", &immich.Asset{ID: "prior", LocalDateTime: captured}, false)
+	candidate := &immich.Asset{ID: "candidate", LocalDateTime: captured.Add(4 * time.Minute)}
+	t.Setenv("FRAME_CAPTURE_BURST_SECONDS", "")
+	require.False(t, frameSelectionAllowed("frame-a", candidate, 0), "the default five-minute capture window must suppress adjacent shots")
+	require.True(t, frameSelectionAllowed("frame-a", candidate, finalSelectionAttempt), "the final attempt must relax burst suppression")
+
+	t.Setenv("FRAME_CAPTURE_BURST_SECONDS", "0")
+	require.True(t, frameSelectionAllowed("frame-a", candidate, 0), "an explicit zero must disable capture-burst suppression")
+	require.True(t, frameSelectionAllowed("frame-a", &immich.Asset{ID: "without-time"}, 0), "assets without a capture timestamp remain selectable")
+}
+
+func TestFrameSelectionCanSuppressRecentIDsAcrossFramesWithinBounds(t *testing.T) {
+	previous := frameRecentAssets
+	frameRecentAssets = recentFrameAssets{devices: map[string][]recentFrameAsset{}}
+	t.Cleanup(func() { frameRecentAssets = previous })
+	t.Setenv("FRAME_CAPTURE_BURST_SECONDS", "0")
+	t.Setenv("FRAME_CROSS_FRAME_REPEAT_SUPPRESSION", "true")
+
+	shared := &immich.Asset{ID: "shared"}
+	frameRecentAssets.remember("frame-a", shared, true)
+	require.False(t, frameSelectionAllowed("frame-b", shared, 0), "a recent selection on another frame must be suppressed when enabled")
+	require.True(t, frameSelectionAllowed("frame-b", shared, finalSelectionAttempt), "the final attempt must still avoid starvation")
+
+	for index := 0; index < frameRecentDeviceLimit+1; index++ {
+		frameRecentAssets.remember(fmt.Sprintf("frame-%d", index), &immich.Asset{ID: fmt.Sprintf("asset-%d", index)}, true)
+	}
+	require.LessOrEqual(t, len(frameRecentAssets.devices), frameRecentDeviceLimit)
+	require.LessOrEqual(t, len(frameRecentAssets.global), frameRecentAssetLimit)
+}
