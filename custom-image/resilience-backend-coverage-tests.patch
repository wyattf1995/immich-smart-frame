+package routes
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/damongolding/immich-kiosk/internal/immich"
+	"github.com/stretchr/testify/require"
+)
+
+type offlineRoundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f offlineRoundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestForegroundDeadlineUsesHotSnapshotTimeout(t *testing.T) {
+	ctx, cancel := foregroundAssetContext(context.Background(), context.Background(), 1)
+	defer cancel()
+	deadline, ok := ctx.Deadline()
+	require.True(t, ok)
+	require.LessOrEqual(t, time.Until(deadline), time.Second)
+
+	ctx, cancel = foregroundAssetContext(context.Background(), context.Background(), 90)
+	defer cancel()
+	deadline, ok = ctx.Deadline()
+	require.True(t, ok)
+	require.LessOrEqual(t, time.Until(deadline), foregroundAssetTimeout)
+}
+
+func TestExpiredOfflineFallbackSurvivesImmichOutage(t *testing.T) {
+	dir := t.TempDir()
+	oldWD, err := os.Getwd()
+	require.NoError(t, err)
+	require.NoError(t, os.Chdir(dir))
+	t.Cleanup(func() { require.NoError(t, os.Chdir(oldWD)) })
+	require.NoError(t, os.Mkdir(OfflineAssetsPath, 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(OfflineAssetsPath, "asset"), []byte("durable"), 0o600))
+	require.NoError(t, os.WriteFile(filepath.Join(OfflineAssetsPath, OfflineExpirationFilename), []byte(time.Now().Add(-time.Hour).Format(time.RFC3339)), 0o600))
+
+	originalClient := immich.HTTPClient
+	immich.HTTPClient = &http.Client{Transport: offlineRoundTripFunc(func(*http.Request) (*http.Response, error) { return nil, errors.New("offline") })}
+	t.Cleanup(func() { immich.HTTPClient = originalClient })
+	expired, err := checkOfflineAssetsExpiration(context.Background(), "http://immich.test")
+	require.NoError(t, err)
+	require.False(t, expired)
+	_, err = os.Stat(filepath.Join(OfflineAssetsPath, "asset"))
+	require.NoError(t, err)
+}
+
+func TestPartialActionStateHelperFindsCurrentTag(t *testing.T) {
+	require.True(t, assetHasTag(immich.Tags{{Name: "hide-me"}}, "HIDE-ME"))
+	require.True(t, assetHasTag(immich.Tags{{Value: "hide-me"}}, "hide-me"))
+	require.False(t, assetHasTag(immich.Tags{{Name: "other"}}, "hide-me"))
+}

