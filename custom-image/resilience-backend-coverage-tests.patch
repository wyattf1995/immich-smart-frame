index 0000000..0f52a57
--- /dev/null
+++ b/main_resilience_test.go
@@ -0,0 +1,75 @@
+package main
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/labstack/echo/v5"
+	"github.com/stretchr/testify/require"
+)
+
+func TestHealthRoutesSeparateLocalLivenessFromImmichReadiness(t *testing.T) {
+	upstreamStatus := http.StatusServiceUnavailable
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		require.Equal(t, "/api/assets/statistics", r.URL.Path)
+		require.Equal(t, "key", r.Header.Get("x-api-key"))
+		w.WriteHeader(upstreamStatus)
+		if upstreamStatus == http.StatusOK {
+			_, _ = w.Write([]byte(`{"total":1}`))
+		}
+	}))
+	defer upstream.Close()
+
+	base := config.New()
+	base.ImmichURL, base.ImmichAPIKey = upstream.URL, "key"
+	base.Kiosk.Cache = false
+	e := echo.New()
+	registerHealthRoutes(e, base)
+
+	for _, endpoint := range []string{"/health", "/livez"} {
+		rec := httptest.NewRecorder()
+		e.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, endpoint, nil))
+		require.Equal(t, http.StatusOK, rec.Code)
+	}
+	rec := httptest.NewRecorder()
+	e.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/readyz", nil))
+	require.Equal(t, http.StatusServiceUnavailable, rec.Code)
+	require.Empty(t, rec.Body.String())
+
+	healthyUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		require.Equal(t, "key", r.Header.Get("x-api-key"))
+		_, _ = w.Write([]byte(`{"total":1}`))
+	}))
+	defer healthyUpstream.Close()
+	// Use a distinct upstream identity so the failed probe's backoff cannot hide
+	// this independently healthy dependency.
+	base.ImmichURL = healthyUpstream.URL
+	rec = httptest.NewRecorder()
+	e.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/readyz", nil))
+	require.Equal(t, http.StatusOK, rec.Code)
+}
+
+func TestHealthcheckCLIAndServerLimits(t *testing.T) {
+	endpoint, ok := checkEndpoint([]string{"--healthcheck"})
+	require.True(t, ok)
+	require.Equal(t, "/livez", endpoint)
+	endpoint, ok = checkEndpoint([]string{"--livecheck"})
+	require.True(t, ok)
+	require.Equal(t, "/livez", endpoint)
+	endpoint, ok = checkEndpoint([]string{"--readycheck"})
+	require.True(t, ok)
+	require.Equal(t, "/readyz", endpoint)
+	_, ok = checkEndpoint([]string{"--unknown"})
+	require.False(t, ok)
+
+	server := &http.Server{}
+	require.NoError(t, configureServer(server))
+	require.Equal(t, 5*time.Second, server.ReadHeaderTimeout)
+	require.Equal(t, 30*time.Second, server.ReadTimeout)
+	require.Equal(t, 45*time.Second, server.WriteTimeout)
+	require.Equal(t, 60*time.Second, server.IdleTimeout)
+	require.Equal(t, 16<<10, server.MaxHeaderBytes)
+}
