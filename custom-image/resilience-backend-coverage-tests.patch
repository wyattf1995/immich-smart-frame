+func TestSnapshotIsRaceSafeDuringHotReloadStyleWrites(t *testing.T) {
+	c := New()
+	done := make(chan struct{})
+	var wg sync.WaitGroup
+	wg.Go(func() {
+		defer close(done)
+		for range 500 {
+			c.mu.Lock()
+			c.Kiosk.HTTPTimeout++
+			c.Kiosk.AllowedOrigins = []string{"https://reload.test"}
+			c.mu.Unlock()
+		}
+	})
+	for range 500 {
+		wg.Go(func() {
+			snapshot := c.Snapshot()
+			_ = snapshot.Kiosk.HTTPTimeout
+			_ = snapshot.Kiosk.AllowedOrigins
+		})
+	}
+	<-done
+	wg.Wait()
+}
