@@ -0,0 +1,51 @@
+package immich
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRetryAfterIsAProviderMinimumAndUnsafeTransportIsNotReplayed(t *testing.T) {
+	require.GreaterOrEqual(t, retryDelay(0, "1"), time.Second)
+	require.GreaterOrEqual(t, retryDelay(0, "0"), time.Duration(0))
+
+	original := HTTPClient
+	t.Cleanup(func() { HTTPClient = original })
+	calls := 0
+	HTTPClient = &http.Client{Transport: roundTripFunc(func(*http.Request) (*http.Response, error) {
+		calls++
+		return nil, errors.New("temporary transport failure")
+	})}
+	asset := New(context.Background(), config.Config{ImmichAPIKey: "key", Kiosk: config.KioskSettings{HTTPTimeout: 1}})
+	_, _, _, err := asset.immichAPICall(context.Background(), http.MethodPost, "http://immich.test/api/assets/asset/rating", []byte(`{}`))
+	require.Error(t, err)
+	require.Equal(t, 1, calls)
+}
+
+func TestReadinessCachesRecentSuccessAndBacksOffFailures(t *testing.T) {
+	original := HTTPClient
+	t.Cleanup(func() { HTTPClient = original })
+	calls := 0
+	HTTPClient = &http.Client{Transport: roundTripFunc(func(*http.Request) (*http.Response, error) {
+		calls++
+		return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"total":1}`))}, nil
+	})}
+	cfg := config.Config{ImmichURL: "http://readiness-success.test", ImmichAPIKey: "key", Kiosk: config.KioskSettings{Cache: false}}
+	require.NoError(t, Ready(context.Background(), cfg))
+	require.NoError(t, Ready(context.Background(), cfg))
+	require.Equal(t, 1, calls)
+
+	HTTPClient = &http.Client{Transport: roundTripFunc(func(*http.Request) (*http.Response, error) { return nil, errors.New("offline") })}
+	failingCfg := cfg
+	failingCfg.ImmichURL = "http://readiness-failure.test"
+	require.Error(t, Ready(context.Background(), failingCfg))
+	require.Error(t, Ready(context.Background(), failingCfg))
+}
