+package cache
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestCacheEvictsToTheConfiguredByteBudget(t *testing.T) {
+	Initialize()
+	Flush()
+	oldBudget := maxCacheBytes
+	maxCacheBytes = 32
+	t.Cleanup(func() {
+		maxCacheBytes = oldBudget
+		Flush()
+	})
+
+	Set("first", strings.Repeat("a", 20), 60, 60)
+	Set("second", strings.Repeat("b", 20), 60, 60)
+	require.LessOrEqual(t, ByteSize(), int64(maxCacheBytes))
+	_, firstFound := Get("first")
+	_, secondFound := Get("second")
+	require.False(t, firstFound && secondFound, "both values exceed the bounded cache budget")
+}
