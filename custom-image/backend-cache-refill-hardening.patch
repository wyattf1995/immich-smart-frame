+// AssetToCacheIfGeneration appends a view item only if generation is current.
+// It returns false when an invalidation raced with the producer.
+func AssetToCacheIfGeneration[T any](generation uint64, viewDataToAdd T, requestConfig *config.Config, deviceID, url string) bool {
+	return assetToCacheAtGeneration(viewDataToAdd, requestConfig, deviceID, url, APPEND, generation)
+}
+
+// AssetToCacheWithPositionIfGeneration is the conditional form for callers
+// that prepend downloaded video or other high-priority view data.
+func AssetToCacheWithPositionIfGeneration[T any](generation uint64, viewDataToAdd T, requestConfig *config.Config, deviceID, url string, position Position) bool {
