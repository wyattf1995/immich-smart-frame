 )
 
+const lockHistogramBuckets = 64
+
+// lockTelemetry records aggregate mutex timing in power-of-two nanosecond
+// buckets. The fixed-size histograms keep observability bounded.
+type lockTelemetry struct {
+	waits [lockHistogramBuckets]atomic.Uint64
+	holds [lockHistogramBuckets]atomic.Uint64
+}
+
+func lockLatencyBucket(nanoseconds uint64) int {
+	if nanoseconds <= 1 {
+		return 0
+	}
+	return bits.Len64(nanoseconds - 1)
+}
+
+func (h *lockTelemetry) record(wait, hold time.Duration) {
+	h.waits[lockLatencyBucket(uint64(wait))].Add(1)
+	h.holds[lockLatencyBucket(uint64(hold))].Add(1)
+}
+
+func lockP95UpperBound(histogram *[lockHistogramBuckets]atomic.Uint64) (uint64, uint64) {
+	var total uint64
+	for index := range histogram {
+		total += histogram[index].Load()
+	}
+	if total == 0 {
+		return 0, 0
+	}
+	target := (total*95 + 99) / 100
+	var seen uint64
+	for index := range histogram {
+		seen += histogram[index].Load()
+		if seen >= target {
+			return uint64(1) << index, total
+		}
+	}
+	return uint64(1) << (lockHistogramBuckets - 1), total
+}
+
+// LockMetrics exposes aggregate cache mutex p95 upper bounds and the number
+// of recorded acquisitions. It contains no cache keys, values, or callers.
+func LockMetrics() (waitP95Nanoseconds, holdP95Nanoseconds, samples uint64) {
+	waitP95Nanoseconds, samples = lockP95UpperBound(&cacheLockStats.waits)
+	holdP95Nanoseconds, _ = lockP95UpperBound(&cacheLockStats.holds)
+	return waitP95Nanoseconds, holdP95Nanoseconds, samples
+}
+
+func lockCache() func() {
+	waitStarted := time.Now()
+	cacheMu.Lock()
+	lockedAt := time.Now()
+	return func() {
+		cacheLockStats.record(lockedAt.Sub(waitStarted), time.Since(lockedAt))
+		cacheMu.Unlock()
+	}
+}
