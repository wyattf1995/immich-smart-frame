+package immich
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestHasValidAlbumsSkipsMembershipRequestWithoutRestrictions(t *testing.T) {
+	var calls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte("[]"))
+	}))
+	defer server.Close()
+
+	asset := New(context.Background(), config.Config{ImmichURL: server.URL})
+	asset.ID = "asset-a"
+	assert.True(t, asset.hasValidAlbums("request-a", "device-a"))
+	assert.Zero(t, calls.Load(), "unconfigured assets must not query album membership")
+
+	asset = New(context.Background(), config.Config{ImmichURL: server.URL, ExcludedAlbums: []string{"excluded"}})
+	asset.ID = "asset-b"
+	assert.True(t, asset.hasValidAlbums("request-b", "device-a"))
+	assert.EqualValues(t, 1, calls.Load(), "configured exclusions must preserve membership lookup")
+
+	profileConfig := config.Config{
+		ImmichURL:       server.URL,
+		CurationProfile: "profile",
+		Curation: config.CurationSettings{Profiles: map[string]config.CurationProfile{
+			"profile": {AlbumPenalties: []config.AlbumPenalty{{Album: "penalized", Factor: 1}}},
+		}},
+	}
+	asset = New(context.Background(), profileConfig)
+	asset.ID = "asset-c"
+	assert.True(t, asset.hasValidAlbums("request-c", "device-a"))
+	assert.EqualValues(t, 2, calls.Load(), "configured penalties must preserve membership lookup")
+}
