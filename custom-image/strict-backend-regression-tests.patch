+package routes
+
+import (
+	"context"
+	"net/http"
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/damongolding/immich-kiosk/internal/common"
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/damongolding/immich-kiosk/internal/immich"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAssetPreFetchPassesDeadlineToBlockingHTTPTransport(t *testing.T) {
+	originalClient := immich.HTTPClient
+	cancelled := make(chan struct{})
+	immich.HTTPClient = &http.Client{Transport: routesRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		<-r.Context().Done()
+		close(cancelled)
+		return nil, r.Context().Err()
+	})}
+	t.Cleanup(func() { immich.HTTPClient = originalClient })
+	requestURL, err := url.Parse("http://kiosk.local/view")
+	require.NoError(t, err)
+	ctx, cancel := context.WithTimeout(context.Background(), 25*time.Millisecond)
+	defer cancel()
+	requestData := &common.RouteRequestData{RequestID: "request-a", DeviceID: "device-a", RequestConfig: config.Config{ImmichURL: "http://immich.test"}}
+	requestCopy := common.ContextCopy{URL: *requestURL, RequestHeader: http.Header{"kiosk-device-id": []string{"device-a"}}, ResponseHeader: make(http.Header)}
+
+	assetPreFetch(ctx, nil, requestData, requestCopy)
+	require.Eventually(t, func() bool { select { case <-cancelled: return true; default: return false } }, time.Second, 5*time.Millisecond)
+}
+
+type routesRoundTripFunc func(*http.Request) (*http.Response, error)
+func (f routesRoundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
