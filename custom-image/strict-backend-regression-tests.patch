@@ -0,0 +1,56 @@
+package immich
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestHasValidAlbumsSkipsMembershipRequestWithoutRestrictions(t *testing.T) {
+	var calls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte("[]"))
+	}))
+	defer server.Close()
+
+	asset := New(context.Background(), config.Config{ImmichURL: server.URL})
+	asset.ID = "asset-a"
+	assert.True(t, asset.hasValidAlbums("request-a", "device-a"))
+	assert.Zero(t, calls.Load())
+
+	asset = New(context.Background(), config.Config{ImmichURL: server.URL, ExcludedAlbums: []string{"excluded"}})
+	asset.ID = "asset-b"
+	assert.True(t, asset.hasValidAlbums("request-b", "device-a"))
+	assert.EqualValues(t, 1, calls.Load())
+
+	profileConfig := config.Config{ImmichURL: server.URL, CurationProfile: "profile", Curation: config.CurationSettings{Profiles: map[string]config.CurationProfile{
+		"profile": {AlbumPenalties: []config.AlbumPenalty{{Album: "penalized", Factor: 1}}},
+	}}}
+	asset = New(context.Background(), profileConfig)
+	asset.ID = "asset-c"
+	assert.True(t, asset.hasValidAlbums("request-c", "device-a"))
+	assert.EqualValues(t, 2, calls.Load())
+}
+
+func TestSelectedAlbumRestrictionsCompilesExcludedIDs(t *testing.T) {
+	restrictions := selectedAlbumRestrictions(config.Config{ExcludedAlbums: []string{"one", "two"}})
+	assert.False(t, restrictions.allows(Albums{{ID: "two"}}, "asset", "request"))
+	assert.True(t, restrictions.allows(Albums{{ID: "three"}}, "asset", "request"))
+}
+
+func BenchmarkAlbumRestrictionsLookup(b *testing.B) {
+	restrictions := selectedAlbumRestrictions(config.Config{ExcludedAlbums: []string{"one", "two", "three", "four", "five"}})
+	albums := Albums{{ID: "a"}, {ID: "b"}, {ID: "c"}, {ID: "d"}, {ID: "e"}}
+	b.ReportAllocs()
+	b.ResetTimer()
+	for range b.N {
+		if !restrictions.allows(albums, "asset-a", "request-a") { b.Fatal("unexpected exclusion") }
+	}
+}
