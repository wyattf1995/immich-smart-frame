@@ -0,0 +1,25 @@
+package immich
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+func TestImmichAPICallStopsRetryBackoffWhenContextEnds(t *testing.T) {
+	originalClient := HTTPClient
+	HTTPClient = &http.Client{Transport: roundTripFunc(func(*http.Request) (*http.Response, error) { return nil, errors.New("blocked") })}
+	t.Cleanup(func() { HTTPClient = originalClient })
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	asset := New(ctx, config.Config{ImmichURL: "http://immich.test"})
+	start := time.Now()
+	_, _, _, err := asset.immichAPICall(ctx, http.MethodGet, "http://immich.test/api/test", nil)
+	require.ErrorIs(t, err, context.Canceled)
+	require.Less(t, time.Since(start), 200*time.Millisecond)
+}

+type roundTripFunc func(*http.Request) (*http.Response, error)
+func (f roundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
