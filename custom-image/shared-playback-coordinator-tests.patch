+type fakeClock struct {
+	mu      sync.Mutex
+	now     time.Time
+	waiters []fakeWaiter
+}
+
+type fakeWaiter struct {
+	at time.Time
+	ch chan time.Time
+}
+
+func newFakeClock() *fakeClock { return &fakeClock{now: time.Unix(1_700_000_000, 0).UTC()} }
+func (f *fakeClock) Now() time.Time {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.now
+}
+func (f *fakeClock) After(delay time.Duration) <-chan time.Time {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	ch := make(chan time.Time, 1)
+	at := f.now.Add(delay)
+	if !at.After(f.now) {
+		ch <- f.now
+		return ch
+	}
+	f.waiters = append(f.waiters, fakeWaiter{at: at, ch: ch})
+	return ch
+}
+func (f *fakeClock) Advance(delay time.Duration) {
+	f.mu.Lock()
+	f.now = f.now.Add(delay)
+	remaining := f.waiters[:0]
+	for _, waiter := range f.waiters {
+		if !waiter.at.After(f.now) {
+			waiter.ch <- f.now
+		} else {
+			remaining = append(remaining, waiter)
+		}
+	}
+	f.waiters = remaining
+	f.mu.Unlock()
+}
+
+type loaderResult struct {
+	asset Asset
+	err   error
+}
+
+type queuedLoader struct {
+	calls   chan LoadRequest
+	results chan loaderResult
+}
+
+func newQueuedLoader() *queuedLoader {
+	return &queuedLoader{calls: make(chan LoadRequest, 64), results: make(chan loaderResult, 64)}
+}
+func (l *queuedLoader) load(ctx context.Context, request LoadRequest) (Asset, error) {
+	select {
+	case l.calls <- request:
+	case <-ctx.Done():
+		return Asset{}, ctx.Err()
+	}
+	select {
+	case result := <-l.results:
+		return result.asset, result.err
+	case <-ctx.Done():
+		return Asset{}, ctx.Err()
+	}
+}
+func (l *queuedLoader) enqueue(id string) { l.results <- loaderResult{asset: NewAsset(id, "user-"+id)} }
+
+func newTestCoordinator(t *testing.T, clock *fakeClock, loader *queuedLoader, overrides GroupConfig) *Coordinator {
+	t.Helper()
+	config := GroupConfig{ID: "downstairs", SelectionKey: "balanced", Duration: 10 * time.Second, IdleTimeout: time.Hour}
+	if overrides.ID != "" {
+		config = overrides
+	}
+	coordinator, err := New([]GroupConfig{config}, loader.load, Options{Clock: clock})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(coordinator.Close)
+	return coordinator
+}
+
+func waitState(t *testing.T, coordinator *Coordinator, match func(State) bool) State {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		state, err := coordinator.State("downstairs")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if match(state) {
+			return state
+		}
+		time.Sleep(time.Millisecond)
+	}
+	state, _ := coordinator.State("downstairs")
+	t.Fatalf("timed out waiting for playback state: %+v", state)
+	return State{}
+}
+
+func rawState(coordinator *Coordinator) State {
+	coordinator.mu.Lock()
+	s := coordinator.sessions["downstairs"]
+	coordinator.mu.Unlock()
+	if s == nil {
+		return State{}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.snapshotLocked()
+}
+
+func waitRawState(t *testing.T, coordinator *Coordinator, match func(State) bool) State {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		state := rawState(coordinator)
+		if match(state) {
+			return state
+		}
+		time.Sleep(time.Millisecond)
+	}
+	state := rawState(coordinator)
+	t.Fatalf("timed out waiting for raw playback state: %+v", state)
+	return State{}
+}
+
+func waitClockWaiter(t *testing.T, clock *fakeClock) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		clock.mu.Lock()
+		armed := len(clock.waiters) > 0
+		clock.mu.Unlock()
+		if armed {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("timed out waiting for fake clock waiter")
+}
+
+func waitClockWaiterAt(t *testing.T, clock *fakeClock, due time.Time) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		clock.mu.Lock()
+		armed := false
+		for _, waiter := range clock.waiters {
+			if waiter.at.Equal(due) {
+				armed = true
+				break
+			}
+		}
+		clock.mu.Unlock()
+		if armed {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatalf("timed out waiting for fake clock waiter at %s", due)
+}
+
+func requireNoLoaderCall(t *testing.T, loader *queuedLoader) {
+	t.Helper()
+	select {
+	case request := <-loader.calls:
+		t.Fatalf("unexpected loader call after retry limit: %+v", request)
+	case <-time.After(50 * time.Millisecond):
+	}
+}
+
+func waitCalls(t *testing.T, loader *queuedLoader, count int) []LoadRequest {
+	t.Helper()
+	requests := make([]LoadRequest, 0, count)
+	deadline := time.After(time.Second)
+	for len(requests) < count {
+		select {
+		case request := <-loader.calls:
+			requests = append(requests, request)
+		case <-deadline:
+			t.Fatalf("timed out waiting for loader call %d", len(requests)+1)
+		}
+	}
+	return requests
+}
+
+func prepareTwoSlides(t *testing.T, coordinator *Coordinator, loader *queuedLoader) State {
+	t.Helper()
+	_, err := coordinator.State("downstairs")
+	if err != nil {
+		t.Fatal(err)
+	}
+	waitCalls(t, loader, 1)
+	loader.enqueue("asset-a")
+	waitCalls(t, loader, 1)
+	loader.enqueue("asset-b")
+	return waitState(t, coordinator, func(state State) bool { return state.Current != nil && state.Next != nil && !state.Loading })
+}
