+func TestPauseResumeAndCASNext(t *testing.T) {
+	clock := newFakeClock()
+	loader := newQueuedLoader()
+	coordinator := newTestCoordinator(t, clock, loader, GroupConfig{})
+	state := prepareTwoSlides(t, coordinator, loader)
+	paused, err := coordinator.Command("downstairs", Command{Action: Pause, ExpectedEpoch: state.Epoch, ExpectedVersion: state.Version})
+	if err != nil || !paused.Paused {
+		t.Fatalf("pause: state=%+v err=%v", paused, err)
+	}
+	clock.Advance(time.Minute)
+	stillPaused := waitState(t, coordinator, func(state State) bool {
+		return state.Paused && state.Current != nil && state.Current.AssetID == "asset-a"
+	})
+	resumed, err := coordinator.Command("downstairs", Command{Action: Resume, ExpectedEpoch: stillPaused.Epoch, ExpectedVersion: stillPaused.Version})
+	if err != nil || resumed.Paused {
+		t.Fatalf("resume: state=%+v err=%v", resumed, err)
+	}
+
+	var successes int
+	var lock sync.Mutex
+	var group sync.WaitGroup
+	for range 12 {
+		group.Add(1)
+		go func(version uint64) {
+			defer group.Done()
+			_, commandErr := coordinator.Command("downstairs", Command{Action: Next, ExpectedEpoch: resumed.Epoch, ExpectedVersion: version})
+			if commandErr == nil {
+				lock.Lock()
+				successes++
+				lock.Unlock()
+			}
+		}(resumed.Version)
+	}
+	group.Wait()
+	if successes != 1 {
+		t.Fatalf("CAS next succeeded %d times, want 1", successes)
+	}
+}
