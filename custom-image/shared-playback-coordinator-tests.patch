+func TestIdleGroupRetiresWithoutFurtherSelection(t *testing.T) {
+	clock := newFakeClock()
+	loader := newQueuedLoader()
+	config := GroupConfig{ID: "downstairs", Duration: 10 * time.Second, IdleTimeout: 10 * time.Second}
+	coordinator := newTestCoordinator(t, clock, loader, config)
+	_, err := coordinator.State("downstairs")
+	if err != nil {
+		t.Fatal(err)
+	}
+	waitCalls(t, loader, 1)
+	loader.enqueue("asset-a")
+	waitCalls(t, loader, 1)
+	loader.enqueue("asset-b")
+	waitState(t, coordinator, func(state State) bool { return state.Current != nil && state.Next != nil })
+	clock.Advance(10 * time.Second)
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		coordinator.mu.Lock()
+		remaining := len(coordinator.sessions)
+		coordinator.mu.Unlock()
+		if remaining == 0 {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("idle group did not retire")
+}
