+func TestFailureRetainsCurrentAndStopsAfterBoundedRetries(t *testing.T) {
+	clock := newFakeClock()
+	loader := newQueuedLoader()
+	config := GroupConfig{ID: "downstairs", Duration: 10 * time.Second, IdleTimeout: time.Hour, RetryLimit: 2, RetryDelay: time.Second}
+	coordinator := newTestCoordinator(t, clock, loader, config)
+	prepareTwoSlides(t, coordinator, loader)
+	clock.Advance(13 * time.Second)
+	waitCalls(t, loader, 1)
+	loader.results <- loaderResult{err: errors.New("offline")}
+	waitRawState(t, coordinator, func(state State) bool {
+		return state.Current != nil && state.Current.AssetID == "asset-b" && state.Next == nil && !state.Loading
+	})
+	// finishLoad records retryAt asynchronously; ensure its fake-clock waiter is
+	// armed before moving test time past that deadline.
+	waitClockWaiterAt(t, clock, clock.Now().Add(time.Second))
+	clock.Advance(time.Second)
+	waitCalls(t, loader, 1)
+	loader.results <- loaderResult{err: errors.New("offline")}
+	state := waitRawState(t, coordinator, func(state State) bool {
+		return state.Current != nil && state.Current.AssetID == "asset-b" && state.Next == nil && !state.Loading
+	})
+	if state.Current == nil || state.Current.AssetID != "asset-b" || state.Loading {
+		t.Fatalf("failed preload did not settle while retaining current: %+v", state)
+	}
+	if state.Next != nil {
+		t.Fatalf("failed preload should retain current without a next slide: %+v", state)
+	}
+	// The session must finish planning after the second failure before time moves
+	// again; a remaining retry timer would produce a third loader call here.
+	waitClockWaiter(t, clock)
+	clock.Advance(10 * time.Second)
+	requireNoLoaderCall(t, loader)
+}
