+func TestConcurrentReadsUseOneInitialLoader(t *testing.T) {
+	clock := newFakeClock()
+	loader := newQueuedLoader()
+	coordinator := newTestCoordinator(t, clock, loader, GroupConfig{})
+	var group sync.WaitGroup
+	for range 24 {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			_, _ = coordinator.State("downstairs")
+		}()
+	}
+	waitCalls(t, loader, 1)
+	select {
+	case request := <-loader.calls:
+		t.Fatalf("selection was not singleflight: %+v", request)
+	default:
+	}
+	loader.enqueue("asset-a")
+	group.Wait()
+}
