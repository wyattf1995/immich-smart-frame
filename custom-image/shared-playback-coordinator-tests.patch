+func TestEpochAndAssetPrivacyAcrossRestart(t *testing.T) {
+	clock := newFakeClock()
+	loaderOne := newQueuedLoader()
+	first := newTestCoordinator(t, clock, loaderOne, GroupConfig{})
+	stateOne := prepareTwoSlides(t, first, loaderOne)
+	asset, found, err := first.AssetForSlide("downstairs", stateOne.Current.ID)
+	if err != nil || !found || asset.SelectedUser() != "user-asset-a" {
+		t.Fatalf("asset lookup: asset=%+v found=%v err=%v", asset, found, err)
+	}
+	encoded, err := json.Marshal(asset)
+	if err != nil || string(encoded) != `{"assetId":"asset-a"}` {
+		t.Fatalf("asset privacy marshal=%s err=%v", encoded, err)
+	}
+	first.Close()
+
+	loaderTwo := newQueuedLoader()
+	second := newTestCoordinator(t, clock, loaderTwo, GroupConfig{})
+	stateTwo := prepareTwoSlides(t, second, loaderTwo)
+	if stateOne.Epoch == stateTwo.Epoch {
+		t.Fatal("new coordinator reused epoch")
+	}
+}
