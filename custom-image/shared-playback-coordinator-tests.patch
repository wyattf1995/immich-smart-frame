+func TestCloseJoinsBlockedLoader(t *testing.T) {
+	clock := newFakeClock()
+	loader := newQueuedLoader()
+	coordinator := newTestCoordinator(t, clock, loader, GroupConfig{})
+	if _, err := coordinator.State("downstairs"); err != nil {
+		t.Fatal(err)
+	}
+	waitCalls(t, loader, 1)
+	done := make(chan struct{})
+	go func() {
+		coordinator.Close()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("Close did not join the canceled loader")
+	}
+}
