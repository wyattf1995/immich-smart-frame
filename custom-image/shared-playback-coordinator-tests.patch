+func TestPreviousThenNextReturnsToCurrentAsset(t *testing.T) {
+	clock := newFakeClock()
+	loader := newQueuedLoader()
+	coordinator := newTestCoordinator(t, clock, loader, GroupConfig{})
+	state := prepareTwoSlides(t, coordinator, loader)
+	next, err := coordinator.Command("downstairs", Command{Action: Next, ExpectedEpoch: state.Epoch, ExpectedVersion: state.Version})
+	if err != nil || next.Current == nil || next.Current.AssetID != "asset-b" {
+		t.Fatalf("next: state=%+v err=%v", next, err)
+	}
+	waitCalls(t, loader, 1)
+	loader.enqueue("asset-c")
+	ready := waitState(t, coordinator, func(state State) bool {
+		return state.Current != nil && state.Next != nil && state.Next.AssetID == "asset-c"
+	})
+	previous, err := coordinator.Command("downstairs", Command{Action: Previous, ExpectedEpoch: ready.Epoch, ExpectedVersion: ready.Version})
+	if err != nil || previous.Current.AssetID != "asset-a" || previous.Next.AssetID != "asset-b" {
+		t.Fatalf("previous: state=%+v err=%v", previous, err)
+	}
+	back, err := coordinator.Command("downstairs", Command{Action: Next, ExpectedEpoch: previous.Epoch, ExpectedVersion: previous.Version})
+	if err != nil || back.Current.AssetID != "asset-b" {
+		t.Fatalf("next after previous: state=%+v err=%v", back, err)
+	}
+}
