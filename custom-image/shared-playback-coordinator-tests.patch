+func TestReplayedAndRestartedCommandsAreRejected(t *testing.T) {
+	clock := newFakeClock()
+	loader := newQueuedLoader()
+	config := GroupConfig{ID: "downstairs", Duration: 10 * time.Second, IdleTimeout: 10 * time.Second}
+	coordinator := newTestCoordinator(t, clock, loader, config)
+	state := prepareTwoSlides(t, coordinator, loader)
+	command := Command{Action: Next, ExpectedEpoch: state.Epoch, ExpectedVersion: state.Version}
+	if _, err := coordinator.Command("downstairs", command); err != nil {
+		t.Fatalf("first next: %v", err)
+	}
+	waitCalls(t, loader, 1)
+	loader.enqueue("asset-c")
+	waitState(t, coordinator, func(state State) bool {
+		return state.Current != nil && state.Next != nil && state.Current.AssetID == "asset-b" && state.Next.AssetID == "asset-c"
+	})
+	if _, err := coordinator.Command("downstairs", command); !errors.Is(err, ErrVersionConflict) {
+		t.Fatalf("replayed next error = %v, want version conflict", err)
+	}
+
+	clock.Advance(10 * time.Second)
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		coordinator.mu.Lock()
+		retired := len(coordinator.sessions) == 0
+		coordinator.mu.Unlock()
+		if retired {
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	coordinator.mu.Lock()
+	retired := len(coordinator.sessions) == 0
+	coordinator.mu.Unlock()
+	if !retired {
+		t.Fatal("session did not retire before restart check")
+	}
+	if _, err := coordinator.State("downstairs"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := coordinator.Command("downstairs", command); !errors.Is(err, ErrVersionConflict) {
+		t.Fatalf("old epoch command error = %v, want version conflict", err)
+	}
+}
