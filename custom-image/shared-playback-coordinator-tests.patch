+func TestNewRequiresFiniteConfiguredGroups(t *testing.T) {
+	clock := newFakeClock()
+	loader := newQueuedLoader()
+	coordinator, err := New(nil, loader.load, Options{Clock: clock, MaxConfiguredGroups: 1})
+	if err != nil {
+		t.Fatalf("empty allowlist should be a disabled coordinator: %v", err)
+	}
+	coordinator.Close()
+	if _, err := New([]GroupConfig{{ID: "a", Duration: time.Second}, {ID: "b", Duration: time.Second}}, loader.load, Options{Clock: clock, MaxConfiguredGroups: 1}); err == nil {
+		t.Fatal("expected configured-group capacity rejection")
+	}
+	if _, err := New([]GroupConfig{{ID: "a", Duration: 3 * time.Second, PreloadLead: 3 * time.Second}}, loader.load, Options{Clock: clock}); err == nil {
+		t.Fatal("expected invalid preload lead rejection")
+	}
+}
