+func TestAutomaticAdvanceKeepsPreparedDeadlineAndAllowsBoundedHistoryRepeat(t *testing.T) {
+	clock := newFakeClock()
+	loader := newQueuedLoader()
+	coordinator := newTestCoordinator(t, clock, loader, GroupConfig{})
+	initial := prepareTwoSlides(t, coordinator, loader)
+	preparedStart := initial.Next.StartsAt
+
+	clock.Advance(13 * time.Second)
+	waitCalls(t, loader, 1)
+	// The loader receives history only as an exclusion hint. A small valid
+	// catalogue may legitimately return asset-a once it is no longer displayed.
+	loader.enqueue("asset-a")
+	advanced := waitState(t, coordinator, func(state State) bool {
+		return state.Current != nil && state.Next != nil && state.Current.AssetID == "asset-b" && state.Next.AssetID == "asset-a"
+	})
+	if !advanced.Current.StartsAt.Equal(preparedStart) {
+		t.Fatalf("automatic advance rewrote prepared deadline: got %s want %s", advanced.Current.StartsAt, preparedStart)
+	}
+}
