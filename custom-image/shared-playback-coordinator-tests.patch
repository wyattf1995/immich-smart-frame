+func TestAutomaticAdvancePreloadsDistinctNextSlide(t *testing.T) {
+	clock := newFakeClock()
+	loader := newQueuedLoader()
+	coordinator := newTestCoordinator(t, clock, loader, GroupConfig{})
+	initial := prepareTwoSlides(t, coordinator, loader)
+	if initial.Current.AssetID != "asset-a" || initial.Next.AssetID != "asset-b" || initial.Current.ID == initial.Next.ID {
+		t.Fatalf("unexpected prepared state: %+v", initial)
+	}
+	clock.Advance(13 * time.Second)
+	waitCalls(t, loader, 1)
+	loader.enqueue("asset-c")
+	advanced := waitState(t, coordinator, func(state State) bool {
+		return state.Current != nil && state.Next != nil && state.Current.AssetID == "asset-b" && state.Next.AssetID == "asset-c"
+	})
+	if advanced.Version <= initial.Version {
+		t.Fatalf("version did not advance: %d -> %d", initial.Version, advanced.Version)
+	}
+}
