+func TestUnknownGroupDoesNotStartLoader(t *testing.T) {
+	clock := newFakeClock()
+	loader := newQueuedLoader()
+	coordinator := newTestCoordinator(t, clock, loader, GroupConfig{})
+	if _, err := coordinator.State("unknown"); !errors.Is(err, ErrUnknownGroup) {
