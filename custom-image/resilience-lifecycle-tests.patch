+func TestPrefetchSchedulerRejectsAdmissionOnceDrainBegins(t *testing.T) {
+	scheduler := newPrefetchScheduler(1, time.Second)
+	drainCtx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	require.True(t, scheduler.drain(drainCtx))
+	require.False(t, scheduler.scheduleWithContext(context.Background(), "after-drain", func(context.Context) {}))
