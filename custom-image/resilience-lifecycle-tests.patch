+	source, err := os.ReadFile("routes_offline.go")
+	require.NoError(t, err)
+	functionStart := strings.Index(string(source), "func handleNoOfflineAssets")
+	require.NotEqual(t, -1, functionStart)
+	functionSource := string(source)[functionStart:]
+	require.Contains(t, functionSource, "scheduleOfflinePrewarm(com, requestConfig, requestCtx, requestID, deviceID)")
+	require.NotContains(t, functionSource, "go func(c common.ContextCopy)")
+}
