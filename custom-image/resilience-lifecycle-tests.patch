+func TestPasswordHotReloadAndHealthProbesBypassKeyAuth(t *testing.T) {
+	base := config.New()
+	e := echo.New()
+	e.GET("/protected", func(c *echo.Context) error { return c.String(http.StatusOK, "OK") })
+	registerHealthRoutes(e, base)
+	addMiddleware(e, base)
+
+	request := func(path, password string) int {
+		req := httptest.NewRequest(http.MethodGet, path, nil)
+		if password != "" {
+			req.Header.Set("Authorization", password)
+		}
+		rec := httptest.NewRecorder()
+		e.ServeHTTP(rec, req)
+		return rec.Code
+	}
+	require.Equal(t, http.StatusOK, request("/protected", ""))
+
+	base.Kiosk.Password = "rotated"
+	require.Equal(t, http.StatusUnauthorized, request("/protected", ""))
+	require.Equal(t, http.StatusOK, request("/protected", "rotated"))
+	for _, path := range []string{"/health", "/livez", "/readyz"} {
+		require.NotEqual(t, http.StatusUnauthorized, request(path, ""))
+	}
+
+	base.Kiosk.Password = ""
+	require.Equal(t, http.StatusOK, request("/protected", ""))
+}
