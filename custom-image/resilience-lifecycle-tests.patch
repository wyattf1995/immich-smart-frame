+func TestImmichAPICallBoundsUnsetTimeout(t *testing.T) {
+	original := HTTPClient
+	t.Cleanup(func() { HTTPClient = original })
+	HTTPClient = &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		deadline, ok := r.Context().Deadline()
+		require.True(t, ok)
+		require.LessOrEqual(t, time.Until(deadline), defaultAPICallTimeout)
+		return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{}`))}, nil
+	})}
+	asset := New(context.Background(), config.Config{ImmichAPIKey: "key"})
+	_, _, _, err := asset.immichAPICall(context.Background(), http.MethodGet, "http://immich.test/api/assets", nil)
+	require.NoError(t, err)
+}
