diff --git a/internal/routes/routes_curation.go b/internal/routes/routes_curation.go
new file mode 100644
index 0000000..9be189a
--- /dev/null
+++ b/internal/routes/routes_curation.go
@@ -0,0 +1,104 @@
+package routes
+
+import (
+	"fmt"
+	"strings"
+
+	"charm.land/log/v2"
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/damongolding/immich-kiosk/internal/immich"
+	"github.com/damongolding/immich-kiosk/internal/kiosk"
+	"github.com/damongolding/immich-kiosk/internal/utils"
+)
+
+// gatherCuratedAssetBuckets turns a named curation profile into the same
+// weighted source buckets used by Kiosk's normal asset selection path. It does
+// not write anything to Immich; it only resolves source names to read-only API
+// queries.
+func gatherCuratedAssetBuckets(immichAsset *immich.Asset, requestConfig config.Config, requestID, deviceID string) ([]utils.AssetWithWeighting, error) {
+	profile, ok := findCurationProfile(requestConfig.Curation.Profiles, requestConfig.CurationProfile)
+	if !ok {
+		return nil, fmt.Errorf("curation profile %q was not found", requestConfig.CurationProfile)
+	}
+
+	assets := make([]utils.AssetWithWeighting, 0, len(profile.Sources))
+	var allTags immich.Tags
+
+	for _, source := range profile.Sources {
+		if source.Weight <= 0 {
+			log.Warn("Skipping curated source with non-positive weight", "profile", requestConfig.CurationProfile, "type", source.Type, "value", source.Value)
+			continue
+		}
+
+		asset := utils.AssetWithWeighting{ConfiguredWeight: source.Weight}
+		switch strings.ToLower(strings.TrimSpace(source.Type)) {
+		case "album":
+			if strings.TrimSpace(source.Value) == "" {
+				return nil, fmt.Errorf("curation profile %q contains an album source without a value", requestConfig.CurationProfile)
+			}
+			asset.Asset = utils.WeightedAsset{Type: kiosk.SourceAlbum, ID: source.Value, Name: source.Value}
+
+		case "person":
+			if strings.TrimSpace(source.Value) == "" {
+				return nil, fmt.Errorf("curation profile %q contains a person source without a value", requestConfig.CurationProfile)
+			}
+			asset.Asset = utils.WeightedAsset{Type: kiosk.SourcePerson, ID: source.Value, Name: source.Value}
+
+		case "tag":
+			if strings.TrimSpace(source.Value) == "" {
+				return nil, fmt.Errorf("curation profile %q contains a tag source without a value", requestConfig.CurationProfile)
+			}
+			if allTags == nil {
+				immichAsset.ApplyDefaultUser()
+				var err error
+				allTags, _, err = immichAsset.AllTags(requestID, deviceID)
+				if err != nil {
+					return nil, fmt.Errorf("getting tags for curation profile %q: %w", requestConfig.CurationProfile, err)
+				}
+			}
+			tag, err := allTags.Get(source.Value)
+			if err != nil {
+				return nil, fmt.Errorf("curation profile %q references unknown tag %q: %w", requestConfig.CurationProfile, source.Value, err)
+			}
+			asset.Asset = utils.WeightedAsset{Type: kiosk.SourceTag, ID: tag.ID, Name: tag.Value}
+
+		case "date":
+			if strings.TrimSpace(source.Value) == "" {
+				return nil, fmt.Errorf("curation profile %q contains a date source without a value", requestConfig.CurationProfile)
+			}
+			asset.Asset = utils.WeightedAsset{Type: kiosk.SourceDateRange, ID: source.Value, Name: source.Value}
+
+		case "memories":
+			immichAsset.ApplyDefaultUser()
+			if immichAsset.MemoriesAssetsCount(requestID, deviceID) == 0 {
+				log.Warn("Skipping curated memories source because no memories are currently available", "profile", requestConfig.CurationProfile)
+				continue
+			}
+			asset.Asset = utils.WeightedAsset{Type: kiosk.SourceMemories, ID: string(kiosk.SourceMemories), Name: "memories"}
+
+		case "random":
+			asset.Asset = utils.WeightedAsset{Type: kiosk.SourceRandom, ID: string(kiosk.SourceRandom), Name: "random"}
+
+		default:
+			return nil, fmt.Errorf("curation profile %q contains unsupported source type %q", requestConfig.CurationProfile, source.Type)
+		}
+
+		assets = append(assets, asset)
+	}
+
+	if len(assets) == 0 {
+		return nil, fmt.Errorf("curation profile %q has no usable sources", requestConfig.CurationProfile)
+	}
+
+	return assets, nil
+}
+
+func findCurationProfile(profiles map[string]config.CurationProfile, wanted string) (config.CurationProfile, bool) {
+	for name, profile := range profiles {
+		if strings.EqualFold(strings.TrimSpace(name), strings.TrimSpace(wanted)) {
+			return profile, true
+		}
+	}
+
+	return config.CurationProfile{}, false
+}
