+func TestDatePoolRegistryConcurrentConsumersShareRefresh(t *testing.T) {
+	registry := newDatePoolRegistry(4)
+	var refreshes atomic.Int32
+	start := make(chan struct{})
+	fetch := func(context.Context) ([]Asset, error) {
+		refreshes.Add(1)
+		<-start
+		return []Asset{{ID: "one"}, {ID: "two"}, {ID: "two"}, {ID: "three"}, {ID: "four"}}, nil
+	}
+
+	seen := make(chan string, 4)
+	var workers sync.WaitGroup
+	for range 4 {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			asset, ok, err := registry.take(context.Background(), "key", time.Minute, fetch)
+			require.NoError(t, err)
+			require.True(t, ok)
+			seen <- asset.ID
+		}()
+	}
+	close(start)
+	workers.Wait()
+	close(seen)
+
+	unique := map[string]bool{}
+	for id := range seen {
+		require.False(t, unique[id], "candidate %q was returned twice", id)
+		unique[id] = true
+	}
+	require.Len(t, unique, 4)
+	require.EqualValues(t, 1, refreshes.Load(), "one empty generation must cause one backing refresh")
+}
+
+func TestDatePoolRegistryBoundsAndPrunesExpiredEntries(t *testing.T) {
+	now := time.Unix(1_000, 0)
+	registry := newDatePoolRegistryWithClock(2, func() time.Time { return now })
+	fetch := func(id string) datePoolFetch {
+		return func(context.Context) ([]Asset, error) { return []Asset{{ID: id}}, nil }
+	}
+
+	_, _, err := registry.take(context.Background(), "one", time.Minute, fetch("one"))
+	require.NoError(t, err)
+	_, _, err = registry.take(context.Background(), "two", time.Minute, fetch("two"))
+	require.NoError(t, err)
+	_, _, err = registry.take(context.Background(), "three", time.Minute, fetch("three"))
+	require.NoError(t, err)
+	require.LessOrEqual(t, registry.size(), 2)
+
+	now = now.Add(2 * time.Minute)
+	_, _, err = registry.take(context.Background(), "four", time.Minute, fetch("four"))
+	require.NoError(t, err)
+	require.Equal(t, 1, registry.size(), "expired idle entries should be pruned atomically")
+}
+
+func TestRandomAssetInDateRangeCacheDisabledRetainsNothing(t *testing.T) {
+	cache.Initialize()
+	dateCandidatePools = newDatePoolRegistry(defaultDatePoolRegistrySize)
+	var calls atomic.Int32
+	server := dateAssetServer(t, &calls)
+	defer server.Close()
+
+	requestConfig := config.Config{ImmichURL: server.URL, Kiosk: config.KioskSettings{Cache: false, FetchedAssetsSize: 4}}
+	first := New(context.Background(), requestConfig)
+	require.NoError(t, first.RandomAssetInDateRange("last-30", "request-one", "device", false))
+	second := New(context.Background(), requestConfig)
+	require.NoError(t, second.RandomAssetInDateRange("last-30", "request-two", "device", false))
+	require.EqualValues(t, 2, calls.Load(), "cache=false must preserve one live request per selection")
+	require.NotEqual(t, first.ID, second.ID)
+}
+
+func TestRandomAssetInDateRangeUsesDecodedPoolBeforeHTTP(t *testing.T) {
+	cache.Initialize()
+	dateCandidatePools = newDatePoolRegistry(defaultDatePoolRegistrySize)
+	var calls atomic.Int32
+	server := dateAssetServer(t, &calls)
+	defer server.Close()
+
+	requestConfig := config.Config{ImmichURL: server.URL, Duration: 60, Kiosk: config.KioskSettings{Cache: true, FetchedAssetsSize: 2}}
+	first := New(context.Background(), requestConfig)
+	require.NoError(t, first.RandomAssetInDateRange("last-30", "request-one", "device", false))
+	second := New(context.Background(), requestConfig)
+	require.NoError(t, second.RandomAssetInDateRange("last-30", "request-two", "device", true))
+	require.EqualValues(t, 1, calls.Load(), "warm decoded candidates must be consumed before another HTTP request")
+	require.NotEqual(t, first.ID, second.ID)
+
+	third := New(context.Background(), requestConfig)
+	require.NoError(t, third.RandomAssetInDateRange("last-30", "request-three", "device", false))
+	require.EqualValues(t, 2, calls.Load(), "pool exhaustion must cause exactly one fresh response")
+	require.NotEqual(t, second.ID, third.ID)
+}
+
+func dateAssetServer(t *testing.T, calls *atomic.Int32) *httptest.Server {
+	t.Helper()
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		call := calls.Add(1)
+		w.Header().Set("Content-Type", "application/json")
+		assets := []Asset{
+			{ID: string(rune('a' + call*2)), Type: ImageType, ExifInfo: ExifInfo{ExifImageHeight: 1080, ExifImageWidth: 1920}},
+			{ID: string(rune('b' + call*2)), Type: ImageType, ExifInfo: ExifInfo{ExifImageHeight: 1080, ExifImageWidth: 1920}},
+		}
+		require.NoError(t, json.NewEncoder(w).Encode(assets))
+	}))
+}
