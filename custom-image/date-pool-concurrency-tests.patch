+package immich
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestDatePoolRegistrySharesOneGenerationAndRefresh(t *testing.T) {
+	registry := newDatePoolRegistry(4)
+	pool := registry.acquire("key", time.Minute)
+	pool.refill([]Asset{{ID: "one"}, {ID: "two"}, {ID: "three"}, {ID: "four"}})
+
+	seen := make(chan string, 4)
+	var workers sync.WaitGroup
+	for range 4 {
+		workers.Add(1)
+		go func() { defer workers.Done(); asset, ok := registry.acquire("key", time.Minute).take(); if ok { seen <- asset.ID } }()
+	}
+	workers.Wait()
+	close(seen)
+	unique := map[string]bool{}
+	for id := range seen { require.False(t, unique[id]); unique[id] = true }
+	require.Len(t, unique, 4)
+
+	var refreshes int
+	registry.refresh("key", pool, func() []Asset { refreshes++; return []Asset{{ID: "fresh"}} })
+	registry.refresh("key", pool, func() []Asset { refreshes++; return []Asset{{ID: "duplicate"}} })
+	require.Equal(t, 1, refreshes)
+	asset, ok := pool.take()
+	require.True(t, ok)
+	require.Equal(t, "fresh", asset.ID)
+}
