+package routes
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/damongolding/immich-kiosk/internal/common"
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/damongolding/immich-kiosk/internal/playback"
+	"github.com/labstack/echo/v5"
+	"github.com/stretchr/testify/require"
+)
+
+type sharedPlaybackTestServer struct {
+	e      *echo.Echo
+	shared *SharedPlayback
+	calls  *atomic.Int32
+}
+
+func newSharedPlaybackTestServer(t *testing.T) *sharedPlaybackTestServer {
+	t.Helper()
+	base := config.New()
+	base.ImmichURL = "http://private-immich.invalid"
+	base.Kiosk.HTTPTimeout = 1
+	var sequence atomic.Int32
+	calls := &atomic.Int32{}
+	coordinator, err := playback.New([]playback.GroupConfig{{
+		ID: "downstairs", SelectionKey: "balanced", Duration: 45 * time.Second, IdleTimeout: time.Minute,
+	}}, func(context.Context, playback.LoadRequest) (playback.Asset, error) {
+		calls.Add(1)
+		index := sequence.Add(1)
+		return playback.NewAsset(fmt.Sprintf("asset-%d", index), "private-selected-user"), nil
+	}, playback.Options{})
+	require.NoError(t, err)
+	server := &sharedPlaybackTestServer{shared: &SharedPlayback{coordinator: coordinator, base: base, common: common.New()}, calls: calls}
+	server.e = echo.New()
+	server.shared.Register(server.e)
+	t.Cleanup(server.shared.Close)
+	return server
+}
