+func TestSharedPlaybackSlideRendersWithStrictDimensionsWhenURLOverridesDisabled(t *testing.T) {
+	preview := mustEncodeJPEG(t)
+	photoSource := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch {
+		case strings.HasPrefix(r.URL.Path, "/api/assets/") && strings.HasSuffix(r.URL.Path, "/thumbnail"):
+			w.Header().Set(echo.HeaderContentType, "image/jpeg")
+			_, _ = w.Write(preview)
+		case strings.HasPrefix(r.URL.Path, "/api/assets/"):
+			w.Header().Set(echo.HeaderContentType, echo.MIMEApplicationJSON)
+			_ = json.NewEncoder(w).Encode(testImageAsset(pathBase(r.URL.Path)))
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	t.Cleanup(photoSource.Close)
+
+	base := newCancellationTestConfig(photoSource.URL)
+	base.Kiosk.DisableURLQueries = true
+	var sequence atomic.Int32
+	coordinator, err := playback.New([]playback.GroupConfig{{
+		ID: "downstairs", SelectionKey: "balanced", Duration: 45 * time.Second, IdleTimeout: time.Minute,
+	}}, func(context.Context, playback.LoadRequest) (playback.Asset, error) {
+		return playback.NewAsset(fmt.Sprintf("render-asset-%d", sequence.Add(1)), ""), nil
+	}, playback.Options{})
+	require.NoError(t, err)
+	t.Cleanup(coordinator.Close)
+
+	server := &sharedPlaybackTestServer{
+		shared: &SharedPlayback{coordinator: coordinator, base: base, common: common.New()},
+	}
+	server.e = echo.New()
+	server.shared.Register(server.e)
+	state := server.readyState(t)
+	require.NotNil(t, state.Current)
+	path := "/api/playback/downstairs/slide/" + state.Current.ID
+
+	valid := server.request(http.MethodGet, path+"?client_width=640&client_height=360", "")
+	require.Equal(t, http.StatusOK, valid.Code)
+	require.Contains(t, valid.Body.String(), "data:image/jpeg;base64,")
+	require.Equal(t, "private, no-store", valid.Header().Get("Cache-Control"))
+
+	for _, suffix := range []string{
+		"?client_width=640&client_width=641&client_height=360",
+		"?client_width=invalid&client_height=360",
+		"?client_width=3841&client_height=2160",
+	} {
+		rec := server.request(http.MethodGet, path+suffix, "")
+		require.Equal(t, http.StatusBadRequest, rec.Code, suffix)
+		require.Equal(t, "private, no-store", rec.Header().Get("Cache-Control"))
+	}
