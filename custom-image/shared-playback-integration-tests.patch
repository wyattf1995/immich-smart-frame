+package routes
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"image"
+	"image/color"
+	"image/jpeg"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/damongolding/immich-kiosk/internal/common"
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/damongolding/immich-kiosk/internal/playback"
+	"github.com/labstack/echo/v5"
+)
+
+// This opt-in test process hosts the production HTML, player bundle, coordinator,
+// HTTP routes and JPEG renderer. Only the photo source is synthetic. The browser
+// harness owns its process and sends SIGTERM; ordinary go test never starts it.
+func TestSharedPlaybackBrowserFixture(t *testing.T) {
+	readyPath := os.Getenv("FRAME_SYNC_FIXTURE_READY")
+	if readyPath == "" {
+		t.Skip("explicit browser fixture process only")
+	}
+	sourceRoot := os.Getenv("FRAME_SYNC_SOURCE_ROOT")
+	if sourceRoot == "" {
+		t.Fatal("source root is required")
+	}
+	var selections atomic.Uint64
+	var independentRequests atomic.Uint64
+	photoSource := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		parts := strings.Split(strings.Trim(r.URL.Path, "/"), "/")
+		if len(parts) < 3 || parts[0] != "api" || parts[1] != "assets" {
+			http.NotFound(w, r)
+			return
+		}
+		id := parts[2]
+		if len(parts) == 3 {
+			w.Header().Set("Content-Type", "application/json")
+			_ = json.NewEncoder(w).Encode(testImageAsset(id))
+			return
+		}
+		if len(parts) != 4 || (parts[3] != "thumbnail" && parts[3] != "original") {
+			http.NotFound(w, r)
+			return
+		}
+		canvas := image.NewRGBA(image.Rect(0, 0, 480, 270))
+		var n uint64
+		_, _ = fmt.Sscanf(id, "00000000-0000-4000-8000-%012d", &n)
+		for y := 0; y < 270; y++ {
+			for x := 0; x < 480; x++ {
+				canvas.SetRGBA(x, y, color.RGBA{R: uint8((uint64(x) + n*47) % 256), G: uint8((uint64(y) + n*71) % 256), B: uint8((n * 39) % 256), A: 255})
+			}
+		}
+		w.Header().Set("Content-Type", "image/jpeg")
+		_ = jpeg.Encode(w, canvas, &jpeg.Options{Quality: 85})
+	}))
+	defer photoSource.Close()
+	cfg := newCancellationTestConfig(photoSource.URL)
+	cfg.Kiosk.HTTPTimeout = 8
+	cfg.Kiosk.DisableURLQueries = true
+	cfg.Kiosk.SyncGroups = map[string]config.SyncGroupSettings{"shared-test": {CurationProfile: "balanced", Duration: 10}}
+	cfg.ShowTime = false
+	cfg.ShowDate = false
+	cfg.DisableScreensaver = false
+	cfg.DisableSleep = true
+	cfg.ShowMoreInfo = false
+	cfg.ShowProgressBar = false
+	cfg.ShowImageDate = false
+	cfg.ImageFit = "contain"
+	cfg.Transition = "none"
+	com := common.New()
+	coordinator, err := playback.New([]playback.GroupConfig{{ID: "shared-test", SelectionKey: "balanced", Duration: 10 * time.Second,
+		PreloadLead: 3 * time.Second, IdleTimeout: time.Minute, RetryDelay: time.Second, RetryLimit: 3, HistoryLimit: 12}},
+		func(ctx context.Context, request playback.LoadRequest) (playback.Asset, error) {
+			if err := ctx.Err(); err != nil {
+				return playback.Asset{}, err
+			}
+			return playback.NewAsset(fmt.Sprintf("00000000-0000-4000-8000-%012d", selections.Add(1)), ""), nil
+		}, playback.Options{MaxConfiguredGroups: 8})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer coordinator.Close()
+	shared := &SharedPlayback{coordinator: coordinator, base: cfg, common: com}
+	e := echo.New()
+	shared.Register(e)
+	e.GET("/", Home(cfg, com))
+	e.GET("/assets/js/kiosk.*.js", func(c *echo.Context) error {
+		return c.File(filepath.Join(sourceRoot, "frontend/public/assets/js/kiosk.js"))
+	})
+	e.GET("/assets/css/kiosk.*.css", func(c *echo.Context) error {
+		return c.File(filepath.Join(sourceRoot, "frontend/public/assets/css/kiosk.css"))
+	})
+	e.Static("/assets", filepath.Join(sourceRoot, "frontend/public/assets"))
+	e.POST("/asset/new", func(c *echo.Context) error { independentRequests.Add(1); return c.NoContent(204) })
+	e.POST("/asset/offline", func(c *echo.Context) error { independentRequests.Add(1); return c.NoContent(204) })
+	e.POST("/asset/previous", func(c *echo.Context) error { independentRequests.Add(1); return c.NoContent(204) })
+	e.GET("/fixture/stats", func(c *echo.Context) error {
+		return c.JSON(200, map[string]any{"independentRequests": independentRequests.Load(), "selections": selections.Load()})
+	})
+	server := httptest.NewServer(e)
+	defer server.Close()
+	var ready bytes.Buffer
+	_ = json.NewEncoder(&ready).Encode(map[string]any{"url": server.URL, "pid": os.Getpid(), "source": "synthetic"})
+	if err := os.WriteFile(readyPath, ready.Bytes(), 0600); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-com.Context().Done():
+	case <-time.After(4 * time.Minute):
+		t.Error("browser fixture exceeded lifetime")
+	}
+}
