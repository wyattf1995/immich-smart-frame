+import { createRequire } from 'node:module';
+import { spawn, spawnSync } from 'node:child_process';
+import { readFile, writeFile, mkdir } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import assert from 'node:assert/strict';
+const require = createRequire('/opt/launchpad-browser-runtime/package.json');
+const { chromium } = require('playwright');
+const root=process.cwd(), reports=resolve(root,'reports/shared-playback');
+await mkdir(reports,{recursive:true});
+const fixture=resolve(process.env.TMPDIR,'shared-playback-fixture');
+const readyFile=resolve(process.env.TMPDIR,`shared-playback-ready-${process.pid}.json`);
+const build=spawnSync('go',['test','-c','-o',fixture,'./internal/routes'],{stdio:'inherit'});
+assert.equal(build.status,0,'fixture compilation');
+const server=spawn(fixture,['-test.run=^TestSharedPlaybackBrowserFixture$','-test.timeout=4m'],{cwd:root,env:{...process.env,FRAME_SYNC_FIXTURE_READY:readyFile,FRAME_SYNC_SOURCE_ROOT:root},stdio:['ignore','pipe','pipe']});
+let log='';server.stdout.on('data',d=>log+=d);server.stderr.on('data',d=>log+=d);
+const delay=ms=>new Promise(r=>setTimeout(r,ms));
+async function eventually(fn,label,timeout=20000){const end=Date.now()+timeout;let error;while(Date.now()<end){try {const result=await fn();if(result)return result;}catch(e){error=e;}await delay(100);}throw Error(`${label}: ${error?.message??'timed out'}`);}
+let browser;const contexts=[];const pages=[];const network=[];const consoleMessages=[];const errors=[];const report={synthetic:true,tests:[],transitions:[],resources:{fixturePid:server.pid}};
+try{
+ const ready=await eventually(async()=>JSON.parse(await readFile(readyFile,'utf8')),'fixture ready',10000);
+ assert.equal(ready.pid,server.pid);
+ browser=await chromium.launch({headless:true,chromiumSandbox:false});
+ const makePage=async(viewport,clockSkew=0)=>{
+  const context=await browser.newContext({viewport});contexts.push(context);
+  await context.addInitScript(({clockSkew})=>{
+   const realNow=Date.now.bind(Date);Date.now=()=>realNow()+clockSkew;
+   window.sharedSettles=[];window.sharedStates=[];
+   for(const [name,key]of [['frame:shared-photo-settled','sharedSettles'],['frame:shared-playback-state','sharedStates']])document.addEventListener(name,event=>{
+    const root=document.querySelector('#kiosk');
+    const photo=root?.querySelector('img[alt="Main image"]');
+    window[key].push({at:performance.timeOrigin+performance.now(),id:root?.dataset.sharedPlaybackSlide,session:root?.dataset.sharedPlaybackSession,paused:typeof event.detail==='string'?JSON.parse(event.detail).sharedPlaybackPaused:undefined,decoded:photo?.complete&&photo?.naturalWidth>0,history:document.querySelector('#kiosk-history input[name=history]')?.value});
+   });
+  },{clockSkew});
+  const page=await context.newPage();pages.push(page);page.on('pageerror',e=>errors.push(e.stack??e.message));
+  page.on('response',r=>{if(network.length<100)network.push({url:r.url(),status:r.status(),type:r.request().resourceType()});});
+  page.on('requestfailed',r=>{if(network.length<100)network.push({url:r.url(),failed:r.failure()?.errorText});});
+  page.on('console',m=>{if(consoleMessages.length<40)consoleMessages.push({type:m.type(),text:m.text().slice(0,1000)});});
+  const homeResponse=await page.goto(`${ready.url}/?sync_group=shared-test&frame_id=synthetic-${contexts.length}`);
+  assert.equal(homeResponse.status(),200,'shared home responds successfully');
+  const bundle=await page.locator('script[src*="/assets/js/kiosk."]').getAttribute('src');
+  assert.ok(bundle,'shared home includes player bundle');
+  const bundleResponse=await page.request.get(new URL(bundle,ready.url).href);
+  assert.equal(bundleResponse.status(),200,'player bundle responds successfully');
+  return page;
+ };
+ const a=await makePage({width:1280,height:720});
+ const id=page=>page.locator('#kiosk').getAttribute('data-shared-playback-slide');
+ const photo=page=>page.locator('#kiosk-history input[name=history]').inputValue();
+ const state=async()=>{const r=await a.request.get(`${ready.url}/api/playback/shared-test`);assert.equal(r.status(),200);return r.json();};
+ await eventually(()=>id(a),'first decoded photo');
+ const b=await makePage({width:960,height:540},90000);
+ await eventually(async()=>{const x=await id(a);return x&&x===await id(b)},'late join and skewed clock match');
+ report.tests.push('late join displays current; 90-second client clock skew corrected');
+ const apiCommand=async(action,expected)=>{
+  const s=expected??await state();const r=await a.request.post(`${ready.url}/api/playback/shared-test/control`,{headers:{Origin:ready.url},data:{action,sessionId:s.sessionId,expectedVersion:s.version}});return {status:r.status(),state:await r.json()};
+ };
+ // Observe actual independently decoded transitions, with no local asset selection.
+ const first=await id(a);
+ await eventually(async()=>{const aa=await a.evaluate(()=>window.sharedSettles),bb=await b.evaluate(()=>window.sharedSettles);const pairs=aa.filter(x=>x.id!==first).map(x=>({a:x,b:bb.find(y=>x.id===y.id)})).filter(x=>x.b);if(pairs.length<3)return false;report.transitions=pairs;return true;},'three automatic synchronized transitions',45000);
+ for(const pair of report.transitions){assert.ok(Math.abs(pair.a.at-pair.b.at)<700,'scheduled transitions differ by less than 700ms');assert.ok(pair.a.decoded&&pair.b.decoded);assert.equal(pair.a.history,pair.b.history);assert.equal(typeof pair.a.paused,'boolean');}
+ await a.keyboard.press('p');
+ await eventually(async()=>{const s=await state();return s.paused&&await a.locator('#kiosk').getAttribute('data-shared-playback-paused')==='true'&&await b.locator('#kiosk').getAttribute('data-shared-playback-paused')==='true'},'shared pause');
+ await eventually(async()=>await id(a)===await id(b),'paused settled match');
+ const pausedId=await id(a),pausedPhoto=await photo(a);await delay(11000);assert.equal(await id(a),pausedId);assert.equal(await id(b),pausedId);
+ report.tests.push('pause on one browser holds both beyond the configured interval');
+ await eventually(async()=>Boolean((await state()).next),'prepared next');
+ const cas=await state();const simultaneous=await Promise.all([apiCommand('next',cas),apiCommand('next',cas)]);
+ assert.deepEqual(simultaneous.map(x=>x.status).sort(),[200,409]);
+ await eventually(async()=>{const x=await id(a);return x!==pausedId&&x===await id(b)},'one CAS next on both');
+ const afterNextPhoto=await photo(a);
+ await b.keyboard.press('ArrowLeft');
+ await eventually(async()=>await photo(a)===pausedPhoto&&await photo(b)===pausedPhoto&&await id(a)===await id(b),'previous on other browser');
+ await b.keyboard.press('ArrowRight');
+ await eventually(async()=>await photo(a)===afterNextPhoto&&await photo(b)===afterNextPhoto&&await id(a)===await id(b),'forward returns to selected photo');
+ report.tests.push('simultaneous next deduplicated; previous/next shared across browsers');
+ // Disconnect one participant before resuming; a failed poll must cancel local deadlines.
+ await contexts[1].setOffline(true);await delay(1800);
+ const held=await id(b);await a.keyboard.press('Shift+p');
+ await eventually(async()=>!(await state()).paused,'resume');
+ await eventually(async()=>await id(a)!==held,'online browser advances',16000);
+ assert.equal(await id(b),held,'offline browser holds the last image');
+ await contexts[1].setOffline(false);
+ await eventually(async()=>await id(a)===await id(b),'reconnect catches current',20000);
+ report.tests.push('disconnected browser holds image; reconnect catches current without backlog');
+ await a.screenshot({path:resolve(reports,'shared-browser-tv.png')});
+ await b.screenshot({path:resolve(reports,'shared-browser-frame.png')});
+ for(const page of [a,b]){
+  assert.equal(await page.locator('#kiosk .frame').count(),1);
+  const events=await page.evaluate(()=>({settles:window.sharedSettles,states:window.sharedStates}));
+  assert.ok(events.states.length>0&&events.states.every(s=>typeof s.paused==='boolean'&&s.session));
+  assert.ok(events.settles.every(s=>s.decoded&&s.history?.startsWith('*')&&s.session));
+ }
+ const before=(await (await a.request.get(`${ready.url}/fixture/stats`)).json()).independentRequests;
+ assert.equal(before,0,'shared views never use independent asset routes');
+ const soloContext=await browser.newContext();contexts.push(soloContext);const solo=await soloContext.newPage();await solo.goto(ready.url);
+ await eventually(async()=>((await (await a.request.get(`${ready.url}/fixture/stats`)).json()).independentRequests)>before,'independent home still starts existing HTMX slideshow');
+ report.tests.push('shared mode skips independent endpoints; existing independent mode retained');
+ assert.deepEqual(errors,[],'browser JavaScript errors');
+ report.status='passed';
+}catch(error){
+ report.status='failed';report.error=error.stack;report.pageErrors=errors;report.network=network;report.console=consoleMessages;report.pages=[];
+ for(const [index,page] of pages.entries()){
+  report.pages.push(await page.evaluate(()=>({url:location.href,body:document.body?.innerText.slice(0,2000),kiosk:document.querySelector('#kiosk')?.outerHTML.slice(0,3000),kioskData:document.querySelector('#kiosk-data')?.textContent,settles:window.sharedSettles,states:window.sharedStates})).catch(e=>({error:e.message})));
+  await page.screenshot({path:resolve(reports,`shared-browser-failure-${index}.png`)}).catch(()=>{});
+ }
+ console.error(JSON.stringify({pageErrors:errors,network,console:consoleMessages,pages:report.pages},null,2));
+ throw error;
+}
+finally{
+ for(const c of contexts)await c.close().catch(()=>{});
+ if(browser)await browser.close();
+ if(server.exitCode===null){server.kill('SIGTERM');await Promise.race([new Promise(r=>server.once('exit',r)),delay(5000)]);}
+ report.resources.fixtureExited=server.exitCode!==null||server.signalCode!==null;
+ report.resources.contextsClosed=contexts.length;report.resources.browserClosed=Boolean(browser);
+ await writeFile(resolve(reports,'shared-browser.json'),JSON.stringify(report,null,2));
+ await writeFile(resolve(reports,'shared-browser-fixture.log'),log);
+ if(!report.resources.fixtureExited){server.kill('SIGKILL');throw Error('fixture did not shut down gracefully');}
+}
diff --git a/ci/shared-playback-proof.sh b/ci/shared-playback-proof.sh
