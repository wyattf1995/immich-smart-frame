+func (s *sharedPlaybackTestServer) request(method, target, body string) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(method, "http://frame.test"+target, strings.NewReader(body))
+	req.Host = "frame.test"
+	rec := httptest.NewRecorder()
+	s.e.ServeHTTP(rec, req)
+	return rec
+}
+
+func (s *sharedPlaybackTestServer) readyState(t *testing.T) sharedStateResponse {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		rec := s.request(http.MethodGet, "/api/playback/downstairs", "")
+		require.Equal(t, http.StatusOK, rec.Code)
+		var state sharedStateResponse
+		require.NoError(t, json.Unmarshal(rec.Body.Bytes(), &state))
+		if state.Current != nil && state.Next != nil && !state.Loading {
+			return state
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("shared playback did not prepare current and next slides")
+	return sharedStateResponse{}
+}
+
+func controlRequest(t *testing.T, body string) *http.Request {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodPost, "http://frame.test/api/playback/downstairs/control", strings.NewReader(body))
+	req.Host = "frame.test"
+	req.Header.Set("Origin", "http://frame.test")
+	req.Header.Set("Sec-Fetch-Site", "same-origin")
+	req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationJSON)
+	return req
+}
