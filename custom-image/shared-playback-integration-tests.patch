+func TestSharedPlaybackControlRejectsCrossOriginAndMalformedJSON(t *testing.T) {
+	server := newSharedPlaybackTestServer(t)
+	state := server.readyState(t)
+	valid := fmt.Sprintf(`{"action":"pause","sessionId":%q,"expectedVersion":%d}`, state.SessionID, state.Version)
+	tooLarge := `{"action":"pause","sessionId":"` + strings.Repeat("a", 1100) + `","expectedVersion":1}`
+	tests := []struct {
+		name   string
+		body   string
+		mutate func(*http.Request)
+		want   int
+	}{
+		{name: "missing origin", body: valid, mutate: func(r *http.Request) { r.Header.Del("Origin") }, want: http.StatusForbidden},
+		{name: "cross site origin", body: valid, mutate: func(r *http.Request) { r.Header.Set("Origin", "https://other.test") }, want: http.StatusForbidden},
+		{name: "cross site fetch metadata", body: valid, mutate: func(r *http.Request) { r.Header.Set("Sec-Fetch-Site", "cross-site") }, want: http.StatusForbidden},
+		{name: "wrong content type", body: valid, mutate: func(r *http.Request) { r.Header.Set(echo.HeaderContentType, echo.MIMETextPlain) }, want: http.StatusUnsupportedMediaType},
+		{name: "oversized body", body: tooLarge, mutate: func(*http.Request) {}, want: http.StatusBadRequest},
+		{name: "unknown field", body: valid[:len(valid)-1] + `,"extra":true}`, mutate: func(*http.Request) {}, want: http.StatusBadRequest},
+		{name: "trailing JSON", body: valid + ` {}`, mutate: func(*http.Request) {}, want: http.StatusBadRequest},
+		{name: "unknown action", body: fmt.Sprintf(`{"action":"delete","sessionId":%q,"expectedVersion":%d}`, state.SessionID, state.Version), mutate: func(*http.Request) {}, want: http.StatusBadRequest},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			req := controlRequest(t, tt.body)
+			tt.mutate(req)
+			rec := httptest.NewRecorder()
+			server.e.ServeHTTP(rec, req)
+			require.Equal(t, tt.want, rec.Code)
+			require.Equal(t, "private, no-store", rec.Header().Get("Cache-Control"))
+		})
+	}
+
+	req := controlRequest(t, valid)
+	rec := httptest.NewRecorder()
+	server.e.ServeHTTP(rec, req)
+	require.Equal(t, http.StatusOK, rec.Code)
+	replay := controlRequest(t, valid)
+	replayRec := httptest.NewRecorder()
+	server.e.ServeHTTP(replayRec, replay)
+	require.Equal(t, http.StatusConflict, replayRec.Code)
+}
