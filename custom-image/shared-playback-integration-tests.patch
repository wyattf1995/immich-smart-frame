index 0000000..9207d78
--- /dev/null
+++ b/ci/shared-playback-proof.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+# Mutations touch source only. Exact original bytes are restored in finally,
+# and the same unedited guarding test must fail for its assertion then pass.
+set -euo pipefail
+python3 - <<'PY'
+from pathlib import Path
+import hashlib,json,subprocess
+root=Path.cwd();out=root/'reports/shared-playback';out.mkdir(parents=True,exist_ok=True)
+results=[]
+def proof(name,file,old,new,count,test,failed_marker):
+ p=root/file;original=p.read_bytes();text=original.decode();assert text.count(old)==count,(name,'guard drift')
+ def run(label):
+  result=subprocess.run(test,cwd=root,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)
+  (out/(name+'-'+label+'.log')).write_text(result.stdout)
+  return result
+ green_before=run('green-before');assert green_before.returncode==0,(name,'baseline guard failed')
+ try:
+  p.write_text(text.replace(old,new))
+  negative=run('red')
+  assert negative.returncode!=0 and failed_marker in negative.stdout,(name,'did not fail at guarding test')
+ finally:
+  p.write_bytes(original)
+ assert p.read_bytes()==original
+ green=run('green-after');assert green.returncode==0,(name,'restored guard failed')
+ results.append({'name':name,'testCommand':test,'redExit':negative.returncode,'greenBeforeExit':green_before.returncode,'greenAfterExit':green.returncode,'restoredSha256':hashlib.sha256(original).hexdigest(),'testsUnchanged':True})
+ (out/'source-negative-proof.json').write_text(json.dumps({'status':'in-progress','proofs':results},indent=2))
+proof('coordinator-cas','internal/playback/coordinator.go',
+ 'if command.ExpectedEpoch != s.epoch || command.ExpectedVersion != s.version {','if false {',2,
+ ['go','test','-count=1','./internal/playback','-run','^TestReplayedAndRestartedCommandsAreRejected$'],
+ '--- FAIL: TestReplayedAndRestartedCommandsAreRejected')
+proof('control-origin','internal/routes/routes_shared_playback.go',
+ 'if !sameOriginPlaybackControl(c.Request()) {','if false && !sameOriginPlaybackControl(c.Request()) {',1,
+ ['go','test','-count=1','./internal/routes','-run','^TestSharedPlaybackControlRejectsCrossOriginAndMalformedJSON$/missing_origin$'],
+ '--- FAIL: TestSharedPlaybackControlRejectsCrossOriginAndMalformedJSON')
+(out/'source-negative-proof.json').write_text(json.dumps({'status':'passed','proofs':results},indent=2))
+PY
