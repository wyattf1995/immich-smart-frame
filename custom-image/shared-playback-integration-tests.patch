@@ -0,0 +1,75 @@
+package config
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func sharedPlaybackConfig() *Config {
+	c := New()
+	c.Curation.Profiles = map[string]CurationProfile{"balanced": {}}
+	c.Kiosk.SyncGroups = map[string]SyncGroupSettings{
+		"downstairs": {CurationProfile: "balanced", Duration: 45},
+	}
+	return c
+}
+
+func TestValidateSyncGroups(t *testing.T) {
+	tests := []struct {
+		name   string
+		mutate func(*Config)
+		want   string
+	}{
+		{name: "configured group", mutate: func(*Config) {}},
+		{name: "bad identifier", mutate: func(c *Config) {
+			c.Kiosk.SyncGroups = map[string]SyncGroupSettings{"Bad ID": {CurationProfile: "balanced", Duration: 45}}
+		}, want: "invalid shared playback group ID"},
+		{name: "duration below bound", mutate: func(c *Config) {
+			c.Kiosk.SyncGroups["downstairs"] = SyncGroupSettings{CurationProfile: "balanced", Duration: 9}
+		}, want: "duration must be 10..3600"},
+		{name: "duration above bound", mutate: func(c *Config) {
+			c.Kiosk.SyncGroups["downstairs"] = SyncGroupSettings{CurationProfile: "balanced", Duration: 3601}
+		}, want: "duration must be 10..3600"},
+		{name: "missing profile", mutate: func(c *Config) { c.Kiosk.SyncGroups["downstairs"] = SyncGroupSettings{Duration: 45} }, want: "requires a curation_profile"},
+		{name: "unknown profile", mutate: func(c *Config) {
+			c.Kiosk.SyncGroups["downstairs"] = SyncGroupSettings{CurationProfile: "missing", Duration: 45}
+		}, want: "unknown curation_profile"},
+		{name: "eight groups allowed", mutate: func(c *Config) {
+			c.Kiosk.SyncGroups = make(map[string]SyncGroupSettings)
+			for i := range 8 {
+				c.Kiosk.SyncGroups[fmt.Sprintf("group-%d", i)] = SyncGroupSettings{CurationProfile: "balanced", Duration: 45}
+			}
+		}},
+		{name: "ninth group rejected", mutate: func(c *Config) {
+			c.Kiosk.SyncGroups = make(map[string]SyncGroupSettings)
+			for i := range 9 {
+				c.Kiosk.SyncGroups[fmt.Sprintf("group-%d", i)] = SyncGroupSettings{CurationProfile: "balanced", Duration: 45}
+			}
+		}, want: "at most 8 groups"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := sharedPlaybackConfig()
+			tt.mutate(c)
+			err := c.ValidateSyncGroups()
+			if tt.want == "" {
+				require.NoError(t, err)
+			} else {
+				require.ErrorContains(t, err, tt.want)
+			}
+		})
+	}
+}
+
+func TestSnapshotDeepCopiesSyncGroups(t *testing.T) {
+	c := sharedPlaybackConfig()
+	snapshot := c.Snapshot()
+	snapshot.Kiosk.SyncGroups["downstairs"] = SyncGroupSettings{CurationProfile: "balanced", Duration: 120}
+	snapshot.Kiosk.SyncGroups["upstairs"] = SyncGroupSettings{CurationProfile: "balanced", Duration: 45}
+
+	require.Equal(t, 45, c.Kiosk.SyncGroups["downstairs"].Duration)
+	_, exists := c.Kiosk.SyncGroups["upstairs"]
+	require.False(t, exists)
+}
