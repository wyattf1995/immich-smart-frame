+func retryableOperation(method, apiURL string) bool {
+	switch method {
+	case http.MethodGet, http.MethodHead, http.MethodOptions:
+		return true
+	case http.MethodPost:
+		u, err := url.Parse(apiURL)
+		if err != nil {
+			return false
+		}
+		// These POST endpoints are selections, not mutations.
+		return u.Path == "/api/search/random" || u.Path == "/api/search/metadata"
+	default:
+		return false
+	}
+}
+
+func transientStatus(status int) bool {
+	return status == http.StatusRequestTimeout || status == http.StatusTooEarly || status == http.StatusTooManyRequests || status >= 500
+}
+
+func waitRetry(ctx context.Context, attempt int, retryAfter string) error {
+	delay := retryDelay(attempt, retryAfter)
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
+
+func retryDelay(attempt int, retryAfter string) time.Duration {
+	delay := time.Duration(1<<attempt) * time.Second
+	retryAfterProvided := false
+	if seconds, err := strconv.Atoi(retryAfter); err == nil && seconds >= 0 {
+		delay = time.Duration(seconds) * time.Second
+		retryAfterProvided = true
+	} else if retryAt, err := http.ParseTime(retryAfter); err == nil {
+		delay = max(time.Until(retryAt), 0)
+		retryAfterProvided = true
+	}
+	// Retry-After is a provider minimum. Add bounded positive jitter only; for
+	// locally chosen backoff use full jitter to avoid synchronized retries.
+	if retryAfterProvided {
+		jitterLimit := min(250*time.Millisecond, max(delay/10, time.Millisecond))
+		delay += time.Duration(rand.Int64N(int64(jitterLimit) + 1))
+	} else if delay > 0 {
+		delay = time.Duration(rand.Int64N(int64(delay) + 1))
+	}
+	return delay
+}
