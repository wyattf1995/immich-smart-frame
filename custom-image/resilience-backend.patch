+// Ready performs a bounded authenticated read. It intentionally returns only an
+// error to callers so readiness endpoints never expose API keys or upstream
+// response bodies.
+func Ready(ctx context.Context, requestConfig config.Config) error {
+	key := readinessKey(requestConfig)
+	if ready, cacheErr := cachedReadiness(key, time.Now()); ready || cacheErr != nil {
+		return cacheErr
+	}
+	_, err, _ := readinessProbes.Do(key, func() (any, error) {
+		if ready, cacheErr := cachedReadiness(key, time.Now()); ready || cacheErr != nil {
+			return nil, cacheErr
+		}
+		asset := New(ctx, requestConfig)
+		_, probeErr := asset.assetsStatistics()
+		storeReadiness(key, time.Now(), probeErr)
+		return nil, probeErr
+	})
+	return err
+}
+
+func readinessKey(requestConfig config.Config) string {
+	apiKey := requestConfig.ImmichAPIKey
+	if requestConfig.SelectedUser != "" {
+		if userKey, ok := requestConfig.ImmichUsersAPIKeys[requestConfig.SelectedUser]; ok {
+			apiKey = userKey
+		}
+	}
+	digest := sha256.Sum256([]byte(apiKey))
+	// The cache key remains process-private and includes no raw credential.
+	return requestConfig.ImmichURL + "\x00" + requestConfig.SelectedUser + "\x00" + string(digest[:])
+}
+
+func cachedReadiness(key string, now time.Time) (bool, error) {
+	readinessCache.Lock()
+	cached := readinessCache.results[key]
+	readinessCache.Unlock()
+	if now.Before(cached.successUntil) {
+		return true, nil
+	}
+	if now.Before(cached.failureUntil) {
+		return false, fmt.Errorf("Immich readiness probe is temporarily backed off")
+	}
+	return false, nil
+}
+
+func storeReadiness(key string, now time.Time, err error) {
+	readinessCache.Lock()
+	if err == nil {
+		readinessCache.results[key] = readinessResult{successUntil: now.Add(readinessSuccessTTL)}
+	} else {
+		readinessCache.results[key] = readinessResult{failureUntil: now.Add(readinessFailureTTL)}
+	}
+	readinessCache.Unlock()
+}
