+// Snapshot returns an isolated, request-safe copy of the current configuration.
+// Reload swaps the source configuration while holding the same lock, so callers
+// must not copy Config directly.
+func (c *Config) Snapshot() Config {
+	c.mu.RLock()
+	snapshot := *c
+	// Request overrides mutate slices and maps. Deep-copy the exported config
+	// graph while holding the reload lock so no request shares mutable state.
+	copyRec(reflect.ValueOf(c).Elem(), reflect.ValueOf(&snapshot).Elem(), make(map[unsafe.Pointer]reflect.Value), false)
+	c.mu.RUnlock()
+	// Request overrides mutate their copy.  Do not retain the shared reload lock.
+	snapshot.mu = &sync.RWMutex{}
+	return snapshot
+}
