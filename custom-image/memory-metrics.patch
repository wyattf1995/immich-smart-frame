+func metricsTokenFromFile(filename string) (string, error) {
+	if filename == "" {
+		return "", errors.New("KIOSK_METRICS_TOKEN_FILE is not set")
+	}
+	contents, err := os.ReadFile(filename)
+	if err != nil {
+		return "", fmt.Errorf("reading metrics token file: %w", err)
+	}
+	token := strings.TrimSpace(string(contents))
+	if token == "" {
+		return "", errors.New("metrics token file is empty")
+	}
+	return token, nil
+}
+
+// metricsHandler accepts only an Authorization bearer token. It deliberately
+// does not use the kiosk password or query parameters.
+func metricsHandler(token string) echo.HandlerFunc {
+	return func(c *echo.Context) error {
+		provided := strings.TrimPrefix(c.Request().Header.Get("Authorization"), "Bearer ")
+		if !strings.HasPrefix(c.Request().Header.Get("Authorization"), "Bearer ") || subtle.ConstantTimeCompare([]byte(provided), []byte(token)) != 1 {
+			return c.NoContent(http.StatusUnauthorized)
+		}
+		return c.JSON(http.StatusOK, routes.RenderMemoryMetrics())
+	}
+}
+
