diff --git a/frontend/tests/polling-timer.test.ts b/frontend/tests/polling-timer.test.ts
new file mode 100644
index 0000000..f7291f9
--- /dev/null
+++ b/frontend/tests/polling-timer.test.ts
@@ -0,0 +1,100 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { resetTriggers, setFindResult, triggerCount } from "./htmx.mock";
+
+/**
+ * Photo slides advance on one timer per slide (FrameOS Touch, 10/17): the per-frame progress loop redrew an
+ * unchanged photo ~24 times a second on the frames, 90% of a core around the clock. The rules the loop kept still
+ * hold: one schedule at a time, no advance while the page is hidden, a pause keeps the remaining time.
+ */
+class FakeClassList {
+    private readonly values = new Set<string>();
+    add(...names: string[]) { for (const n of names) this.values.add(n); }
+    remove(...names: string[]) { for (const n of names) this.values.delete(n); }
+    contains(name: string) { return this.values.has(name); }
+}
+
+let clock = 0;
+let nextTimer = 1;
+const timers = new Map<number, { at: number; fn: () => void; delay: number }>();
+let frames = 0;
+const fakeDocument = { body: { classList: new FakeClassList() }, getElementById: () => null, visibilityState: "visible" };
+const bar = { style: { transform: "", transition: "" }, classList: new FakeClassList(), offsetWidth: 1 };
+
+Object.defineProperties(globalThis, {
+    document: { configurable: true, value: fakeDocument },
+    performance: { configurable: true, value: { now: () => clock } },
+    requestAnimationFrame: { configurable: true, value: () => ++frames },
+    cancelAnimationFrame: { configurable: true, value: () => undefined },
+    setTimeout: {
+        configurable: true,
+        value: (fn: () => void, delay: number) => {
+            const id = nextTimer++;
+            timers.set(id, { at: clock + delay, fn, delay });
+            return id;
+        },
+    },
+    clearTimeout: { configurable: true, value: (id: number) => timers.delete(id) },
+});
+
+function advance(ms: number) {
+    clock += ms;
+    for (const [id, timer] of [...timers]) {
+        if (timer.at <= clock) {
+            timers.delete(id);
+            timer.fn();
+        }
+    }
+}
+
+setFindResult(bar);
+const polling = await import("../src/ts/polling.ts");
+const kiosk = { classList: new FakeClassList() } as unknown as HTMLElement;
+const menu = { classList: new FakeClassList() } as unknown as HTMLElement;
+polling.initPolling(7_000, kiosk, menu);
+
+test("a photo slide arms one timer and asks for no animation frames", () => {
+    polling.startPolling();
+    polling.startPolling();
+    assert.equal(timers.size, 1, "one schedule per slide");
+    assert.equal([...timers.values()][0].delay, 7_000);
+    assert.equal(frames, 0, "no per-frame loop for photos");
+    assert.match(bar.style.transition, /7000ms linear/, "the bar animates once on the compositor");
+    assert.match(bar.style.transform, /scaleX\(1\)/);
+});
+
+test("the slide advances when its time is up and the page is visible", () => {
+    resetTriggers();
+    advance(7_000);
+    assert.equal(triggerCount(), 1, "kiosk-new-asset fired once");
+    assert.equal(timers.size, 0, "triggering a new asset stops the old schedule");
+});
+
+test("a slide that falls due while the page is hidden waits for the page to come back", () => {
+    polling.startPolling();
+    resetTriggers();
+    fakeDocument.visibilityState = "hidden";
+    advance(7_000);
+    assert.equal(triggerCount(), 0, "no advance while hidden");
+    polling.recoverPollingIfVisible();
+    assert.equal(triggerCount(), 0, "still hidden");
+    fakeDocument.visibilityState = "visible";
+    polling.recoverPollingIfVisible();
+    assert.equal(triggerCount(), 1, "advances on return, as the frame loop did");
+});
+
+test("a pause keeps the remaining time and a resume arms only the remainder", () => {
+    polling.stopPolling();
+    timers.clear();
+    polling.startPolling();
+    advance(3_000);
+    polling.pausePolling(false);
+    assert.equal(timers.size, 0, "paused: nothing scheduled");
+    assert.match(bar.style.transition, /none/, "the bar freezes where it is");
+    advance(60_000);
+    polling.resumePolling();
+    assert.equal(timers.size, 1);
+    assert.equal([...timers.values()][0].delay, 4_000, "7 s slide, 3 s shown before the pause");
+    polling.recoverPollingIfVisible();
+    assert.equal(timers.size, 1, "recovery never duplicates the schedule");
+});
