@@ -240,6 +240,24 @@ func (c *Config) checkCuration() error {
 			profile.Sources[i].Value = strings.TrimSpace(profile.Sources[i].Value)
 		}
 
+		seenPenaltyAlbums := make(map[string]struct{}, len(profile.AlbumPenalties))
+		for i := range profile.AlbumPenalties {
+			penalty := &profile.AlbumPenalties[i]
+			penalty.Album = strings.TrimSpace(penalty.Album)
+			if penalty.Album == "" {
+				return fmt.Errorf("curation profile %q album penalty %d album must not be empty", trimmedName, i)
+			}
+			if penalty.Factor <= 0 || penalty.Factor > 1 {
+				return fmt.Errorf("curation profile %q album penalty %d factor must be greater than 0 and at most 1", trimmedName, i)
+			}
+
+			lookupAlbum := strings.ToLower(penalty.Album)
+			if _, exists := seenPenaltyAlbums[lookupAlbum]; exists {
+				return fmt.Errorf("curation profile %q album penalty %d duplicates album %q", trimmedName, i, penalty.Album)
+			}
+			seenPenaltyAlbums[lookupAlbum] = struct{}{}
+		}
+
 		normalizedProfiles[trimmedName] = profile
 	}
 
diff --git a/internal/immich/immich_helpers.go b/internal/immich/immich_helpers.go
index 3883f1ca..7e89d955 100644
--- a/internal/immich/immich_helpers.go
+++ b/internal/immich/immich_helpers.go
@@ -747,9 +747,56 @@ func (a *Asset) hasValidAlbums(requestID, deviceID string) bool {
 		a.AlbumsThatContainAsset(requestID, deviceID)
 	}
 
-	return !slices.ContainsFunc(a.AppearsIn, func(album Album) bool {
+	if slices.ContainsFunc(a.AppearsIn, func(album Album) bool {
 		return slices.Contains(a.requestConfig.ExcludedAlbums, album.ID)
-	})
+	}) {
+		return false
+	}
+
+	var penalties []config.AlbumPenalty
+	for name, profile := range a.requestConfig.Curation.Profiles {
+		if strings.EqualFold(strings.TrimSpace(name), strings.TrimSpace(a.requestConfig.CurationProfile)) {
+			penalties = profile.AlbumPenalties
+			break
+		}
+	}
+
+	return acceptsAlbumPenaltyForAsset(a.AppearsIn, penalties, a.ID, requestID)
+}
+
+func albumPenaltyFactor(albums Albums, penalties []config.AlbumPenalty) float64 {
+	factor := 1.0
+	for _, penalty := range penalties {
+		if penalty.Factor <= 0 || penalty.Factor > factor {
+			continue
+		}
+		if slices.ContainsFunc(albums, func(album Album) bool {
+			return strings.EqualFold(album.ID, penalty.Album)
+		}) {
+			factor = penalty.Factor
+		}
+	}
+	return factor
+}
+
+func acceptsAlbumPenalty(albums Albums, penalties []config.AlbumPenalty, roll float64) bool {
+	return roll < albumPenaltyFactor(albums, penalties)
 }
+
+func albumPenaltyRoll(assetID, requestID string) float64 {
+	digest := sha256.Sum256([]byte(requestID + "\x00" + assetID))
+	numerator := uint64(digest[0])<<40 |
+		uint64(digest[1])<<32 |
+		uint64(digest[2])<<24 |
+		uint64(digest[3])<<16 |
+		uint64(digest[4])<<8 |
+		uint64(digest[5])
+	const denominator uint64 = 1 << 48
+	return float64(numerator) / float64(denominator)
+}
+
+func acceptsAlbumPenaltyForAsset(albums Albums, penalties []config.AlbumPenalty, assetID, requestID string) bool {
+	return acceptsAlbumPenalty(albums, penalties, albumPenaltyRoll(assetID, requestID))
+}
 
