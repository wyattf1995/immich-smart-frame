 	Weight float64 `json:"weight" yaml:"weight" mapstructure:"weight"`
 }
 
+// AlbumPenalty reduces, without excluding, assets that belong to an album.
+// Factor is the probability of accepting a matching candidate (0 < factor <= 1).
+type AlbumPenalty struct {
+	Album  string  `json:"album" yaml:"album" mapstructure:"album" redact:"true"`
+	Factor float64 `json:"factor" yaml:"factor" mapstructure:"factor"`
+}
+
 // CurationProfile is an explicitly weighted mix of Immich sources.
 type CurationProfile struct {
-	Sources []CuratedSource `json:"sources" yaml:"sources" mapstructure:"sources" default:"[]"`
+	Sources        []CuratedSource `json:"sources" yaml:"sources" mapstructure:"sources" default:"[]"`
+	AlbumPenalties []AlbumPenalty  `json:"albumPenalties" yaml:"album_penalties" mapstructure:"album_penalties" default:"[]"`
 }
 
 // CurationSettings contains reusable profiles addressable by name from a URL.
