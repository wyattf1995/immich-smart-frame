+func popDateCandidate(candidates *[]Asset) Asset {
+	last := len(*candidates) - 1
+	asset := (*candidates)[last]
+	(*candidates)[last] = Asset{}
+	*candidates = (*candidates)[:last]
+	return asset
+}
+
+func uniqueDateCandidates(candidates []Asset, limit int) []Asset {
+	if limit < 1 {
+		return nil
+	}
+	result := make([]Asset, 0, min(len(candidates), limit))
+	seen := make(map[string]struct{}, min(len(candidates), limit))
+	for _, candidate := range candidates {
+		if candidate.ID == "" {
+			continue
+		}
+		if _, exists := seen[candidate.ID]; exists {
+			continue
+		}
+		seen[candidate.ID] = struct{}{}
+		result = append(result, candidate)
+		if len(result) == limit {
+			break
+		}
+	}
+	return result
+}
