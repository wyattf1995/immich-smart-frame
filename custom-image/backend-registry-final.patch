+func (r *datePoolRegistry) acquire(key string) (*datePoolEntry, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	now := r.now()
+	for candidateKey, entry := range r.entries {
+		if entry.active == 0 && entry.pool.expired(now) {
+			delete(r.entries, candidateKey)
+		}
+	}
+	if entry, ok := r.entries[key]; ok {
+		entry.active++
+		entry.lastAccess = now
+		return entry, nil
+	}
+	if len(r.entries) >= r.maxEntries {
