+func (p *dateCandidatePool) takeOrRefill(ctx context.Context, ttl time.Duration, now func() time.Time, fetch datePoolFetch) (Asset, bool, error) {
+	for {
+		p.mu.Lock()
+		if !p.expiresAt.IsZero() && !now().Before(p.expiresAt) && !p.refreshing {
+			clear(p.candidates)
+			p.candidates = nil
+		}
+		if len(p.candidates) > 0 {
+			asset := popDateCandidate(&p.candidates)
+			p.mu.Unlock()
+			return asset, true, nil
+		}
+		if p.refreshing {
+			ready := p.ready
+			p.mu.Unlock()
+			select {
+			case <-ctx.Done():
+				return Asset{}, false, ctx.Err()
+			case <-ready:
+				continue
+			}
+		}
+
+		p.refreshing = true
+		p.ready = make(chan struct{})
+		ready := p.ready
+		p.mu.Unlock()
+
+		candidates, err := fetch(ctx)
+		candidates = uniqueDateCandidates(candidates, maxDateCandidates)
+
+		p.mu.Lock()
+		if err == nil {
+			p.candidates = candidates
+			p.expiresAt = now().Add(ttl)
+		}
+		p.refreshing = false
+		close(ready)
+		if err != nil {
+			p.mu.Unlock()
+			return Asset{}, false, err
+		}
