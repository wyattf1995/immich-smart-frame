diff --git a/internal/config/config_validation.go b/internal/config/config_validation.go
index 6982118..7219ee2 100644
--- a/internal/config/config_validation.go
+++ b/internal/config/config_validation.go
@@ -4,0 +5 @@ import (
+	"math"
@@ -211,0 +213,67 @@ func (c *Config) cleanupSlice(slice []string, placeholders ...string) []string {
+func normalizeCurationProfileLookup(name string) string {
+	return strings.ToLower(strings.TrimSpace(name))
+}
+
+func (c *Config) checkCuration() error {
+	c.CurationProfile = strings.TrimSpace(c.CurationProfile)
+	if len(c.Curation.Profiles) == 0 {
+		return nil
+	}
+
+	normalizedProfiles := make(map[string]CurationProfile, len(c.Curation.Profiles))
+	canonicalNames := make(map[string]string, len(c.Curation.Profiles))
+
+	for name, profile := range c.Curation.Profiles {
+		trimmedName := strings.TrimSpace(name)
+		if trimmedName == "" {
+			return fmt.Errorf("curation profile names must not be empty")
+		}
+
+		lookupName := normalizeCurationProfileLookup(trimmedName)
+		if existingName, exists := canonicalNames[lookupName]; exists {
+			return fmt.Errorf("curation profiles %q and %q collide after trim+casefold", existingName, trimmedName)
+		}
+		canonicalNames[lookupName] = trimmedName
+
+		for i := range profile.Sources {
+			profile.Sources[i].Type = strings.TrimSpace(profile.Sources[i].Type)
+			profile.Sources[i].Value = strings.TrimSpace(profile.Sources[i].Value)
+		}
+
+		normalizedProfiles[trimmedName] = profile
+	}
+
+	c.Curation.Profiles = normalizedProfiles
+	return nil
+}
+
+func clampClientImageDimension(dimension int) int {
+	switch {
+	case dimension <= 0:
+		return 0
+	case dimension > maxClientImageDimension:
+		return maxClientImageDimension
+	default:
+		return dimension
+	}
+}
+
+func (c *Config) sanitizeClientData() {
+	c.ClientData.Width = clampClientImageDimension(c.ClientData.Width)
+	c.ClientData.Height = clampClientImageDimension(c.ClientData.Height)
+	c.CurationProfile = strings.TrimSpace(c.CurationProfile)
+
+	if c.ClientData.Width == 0 || c.ClientData.Height == 0 {
+		return
+	}
+
+	totalPixels := int64(c.ClientData.Width) * int64(c.ClientData.Height)
+	if totalPixels <= maxClientImageTotalPixels {
+		return
+	}
+
+	scale := math.Sqrt(float64(maxClientImageTotalPixels) / float64(totalPixels))
+	c.ClientData.Width = max(1, int(math.Floor(float64(c.ClientData.Width)*scale)))
+	c.ClientData.Height = max(1, int(math.Floor(float64(c.ClientData.Height)*scale)))
+}
+
