+// recordServed marks an asset ID as handed out. Callers must hold p.mu.
+func (p *dateCandidatePool) recordServed(id string) {
+	if id == "" {
+		return
+	}
+	if p.served == nil {
+		p.served = make(map[string]struct{})
+	}
+	p.served[id] = struct{}{}
+	if len(p.served) >= servedDateLedgerCap {
+		p.served = nil
+	}
+}
+
+// mergeRefill combines the unserved remainder with freshly fetched candidates.
+// The remainder goes first so a fetched duplicate cannot displace an unserved
+// copy, and fetched assets already handed out this pass are skipped. When that
+// filters everything out the whole population has been served once, so the
+// ledger resets and the next pass begins. Callers must hold p.mu.
+func (p *dateCandidatePool) mergeRefill(remaining, fetched []Asset) []Asset {
+	merged := make([]Asset, 0, min(len(remaining)+len(fetched), maxDateCandidates))
+	seen := make(map[string]struct{}, cap(merged))
+	for _, candidate := range remaining {
+		if candidate.ID == "" {
+			continue
+		}
+		if _, exists := seen[candidate.ID]; exists {
+			continue
+		}
+		seen[candidate.ID] = struct{}{}
+		merged = append(merged, candidate)
+		if len(merged) == maxDateCandidates {
+			return merged
+		}
+	}
+	for _, candidate := range fetched {
+		if candidate.ID == "" {
+			continue
+		}
+		if _, exists := seen[candidate.ID]; exists {
+			continue
+		}
+		if _, alreadyServed := p.served[candidate.ID]; alreadyServed {
+			continue
+		}
+		seen[candidate.ID] = struct{}{}
+		merged = append(merged, candidate)
+		if len(merged) == maxDateCandidates {
+			return merged
+		}
+	}
+	if len(merged) == 0 && len(fetched) > 0 {
+		p.served = nil
+		return uniqueDateCandidates(fetched, maxDateCandidates)
+	}
+	return merged
+}
+
+func pickDateCandidate(candidates *[]Asset, sessionSpread bool) Asset {
+	if !sessionSpread {
+		return popDateCandidate(candidates)
+	}
+	return popSessionSpreadCandidate(candidates)
+}
+
+// popSessionSpreadCandidate draws a uniformly random capture hour first and
+// only then a candidate within it, so a burst shoot of thousands of frames in
+// one hour weighs the same per pick as a lone photo from another session.
+func popSessionSpreadCandidate(candidates *[]Asset) Asset {
+	hours := make([]int64, 0, len(*candidates))
+	groups := make(map[int64][]int, len(*candidates))
+	for index, candidate := range *candidates {
+		hour := candidate.LocalDateTime.Truncate(time.Hour).Unix()
+		if _, exists := groups[hour]; !exists {
+			hours = append(hours, hour)
+		}
+		groups[hour] = append(groups[hour], index)
+	}
+	indexes := groups[hours[rand.IntN(len(hours))]]
+	index := indexes[rand.IntN(len(indexes))]
+	asset := (*candidates)[index]
+	last := len(*candidates) - 1
+	(*candidates)[index] = (*candidates)[last]
+	(*candidates)[last] = Asset{}
+	*candidates = (*candidates)[:last]
+	return asset
+}
