new file mode 100644
index 0000000000000000000000000000000000000000..0accc74b0a928ee7b41070251c5fd99557c11179
--- /dev/null
+++ b/frontend/tests/offline-cache-contract.test.mjs
@@ -0,0 +1,23 @@
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+
+const read = (name) => readFile(new URL(`../../${name}`, import.meta.url), "utf8");
+const offline = await read("internal/routes/routes_offline.go");
+const assets = await read("internal/routes/routes_asset.go");
+const cache = await read("internal/routes/routes_cache.go");
+
+test("offline pool is scoped and invalidated without a long mutex hold", () => {
+  for (const marker of [
+    "OfflineManifestFilename", "cache.CurrentGeneration", "generation=", "origin=", "user=", "device=",
+    "profile=", "config_sha256=", "ensureOfflineCacheScope", "offlineCacheScopeToken",
+    "ErrOfflineScopeInvalidated", "writeOfflineExpirationIfScope",
+  ]) assert.match(offline, new RegExp(marker));
+  assert.match(offline, /InvalidateOfflineAssets/);
+  assert.doesNotMatch(offline, /defer offlineScopeMu\.Unlock\(\)/);
+});
+
+test("successful curation mutations and explicit flush invalidate the pool", () => {
+  assert.ok((assets.match(/InvalidateOfflineAssets\(\)/g) || []).length >= 5);
+  assert.match(cache, /InvalidateOfflineAssets\(\)/);
+});
diff --git a/internal/routes/routes_offline_cache_regression_test.go b/internal/routes/routes_offline_cache_regression_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..83b903438ede225f54c98e26ac93faca46318e30
--- /dev/null
+++ b/internal/routes/routes_offline_cache_regression_test.go
@@ -0,0 +1,57 @@
+package routes
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/damongolding/immich-kiosk/internal/cache"
+	"github.com/damongolding/immich-kiosk/internal/common"
+	"github.com/damongolding/immich-kiosk/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+func TestInvalidatedOfflineJobCannotRepopulatePool(t *testing.T) {
+	dir := t.TempDir()
+	oldWD, err := os.Getwd()
+	require.NoError(t, err)
+	require.NoError(t, os.Chdir(dir))
+	t.Cleanup(func() { require.NoError(t, os.Chdir(oldWD)) })
+	require.NoError(t, os.Mkdir(OfflineAssetsPath, 0o700))
+
+	requestConfig := config.Config{}
+	offlineScopeMu.Lock()
+	token := newOfflineCacheScopeToken(requestConfig, "test-device")
+	require.NoError(t, ensureOfflineCacheScopeExpected(token.manifest))
+	offlineScopeMu.Unlock()
+
+	cache.Flush()
+	InvalidateOfflineAssets()
+
+	filename := filepath.Join(OfflineAssetsPath, "stale-asset")
+	var offlineSize atomic.Int64
+	var createdFiles sync.Map
+	createdFiles.Store(filename, true)
+	err = saveMsgpackZstd(
+		context.Background(),
+		filename,
+		common.ViewData{},
+		&offlineSize,
+		0,
+		&createdFiles,
+		token,
+	)
+	require.ErrorIs(t, err, ErrOfflineScopeInvalidated)
+	_, statErr := os.Stat(filename)
+	require.ErrorIs(t, statErr, os.ErrNotExist)
+	require.Zero(t, offlineSize.Load())
+
+	err = writeOfflineExpirationIfScope(token, time.Now().Add(time.Hour))
+	require.ErrorIs(t, err, ErrOfflineScopeInvalidated)
+	_, statErr = os.Stat(filepath.Join(OfflineAssetsPath, OfflineExpirationFilename))
+	require.ErrorIs(t, statErr, os.ErrNotExist)
+}
