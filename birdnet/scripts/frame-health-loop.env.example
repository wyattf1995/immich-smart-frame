# Copy to a root-owned mode-0600 file outside this repository.
FRAME_HEALTH_PUBLISHER=/mnt/user/appdata/frame-review-soak-20260904/monitor/publish-frame-health.py
FRAME_HEALTH_WATCHDOG=/mnt/user/appdata/frame-review-soak-20260904/monitor/birdnet-watchdog.sh
FRAME_HEALTH_HA_URL=http://home-assistant.local:8123
# Dedicated root-owned mode-0600 scoped webhook ID; it has no HA read/admin scope.
FRAME_HEALTH_WEBHOOK_ID_FILE=/mnt/user/appdata/birdnet-go/secrets/frame-health-webhook-id
FRAME_HEALTH_CONTAINER_WEBHOOK_ID_FILE=/run/secrets/frame-health-webhook-id
FRAME_HEALTH_PYTHON_IMAGE=sha256:f3ac72983efcf1a310abe2ecb0ebeee84fefcb1a797668eac82697a43f8e3c5b
# The watchdog consumes this auth-file path; it never receives credential values.
BIRDNET_BIND_IP=127.0.0.1
BIRDNET_WATCHDOG_AUTH_FILE=/mnt/user/appdata/birdnet-go/secrets/frame-watchdog-auth.json
# Optional: WEB_PORT=8090
