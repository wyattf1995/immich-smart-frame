# Copy to .env and keep the copy out of version control.
# Replace this documentation address with the Unraid host's LAN address. Do not
# use 0.0.0.0; the frame needs LAN access, not an all-interface publication.
BIRDNET_BIND_IP=192.0.2.10

# Host port for the BirdNET-Go dashboard. The container listens on 8080.
WEB_PORT=8090
# Lightweight frame-specific page; its proxy reaches BirdNET-Go internally.
FRAME_VIEW_PORT=8091
TZ=America/Los_Angeles

# Readable runtime copy of the two frame-view assets. Keep the reviewed source
# beside Compose on /boot, then install it here because the FAT boot filesystem
# presents copied files as root-only inside the UID 101 NGINX container.
BIRDNET_FRAME_VIEW_DIR=/mnt/user/appdata/birdnet-go/frame-view

# The upstream image entrypoint uses these IDs when fixing bind-mount ownership.
# 99:100 is Unraid's standard nobody:users appdata ownership.
BIRDNET_UID=99
BIRDNET_GID=100

# Mutable state belongs on appdata, never beside Compose on the boot flash.
BIRDNET_CONFIG_DIR=/mnt/user/appdata/birdnet-go/config
BIRDNET_DATA_DIR=/mnt/user/appdata/birdnet-go/data

# Optional Nest camera audio bridge. The sample values are inert: keep the
# bridge's nest-audio profile stopped until all three values are set privately.
# HA_HOST is host[:port], without an http:// or ws:// scheme.
HA_HOST=192.0.2.30
HA_CAMERA_ENTITY=camera.backyard_camera

# Store a dedicated non-admin Home Assistant user's long-lived token in this
# owner-readable file. Never put the token itself in .env or Compose.
HA_TOKEN_FILE=/mnt/user/appdata/birdnet-go/secrets/HA_TOKEN
