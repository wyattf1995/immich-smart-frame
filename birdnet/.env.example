# Copy to .env and keep the copy out of version control.
# This address is the Unraid host's LAN address, not 0.0.0.0.
BIRDNET_BIND_IP=192.168.86.180

# Host port for the BirdNET-Go dashboard. The container listens on 8080.
WEB_PORT=8088
TZ=America/Los_Angeles

# The upstream image entrypoint uses these IDs when fixing bind-mount ownership.
# Match the owner/group you use for the Unraid appdata directory.
BIRDNET_UID=1000
BIRDNET_GID=1000
