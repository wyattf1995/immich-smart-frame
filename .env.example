# Immich's server URL as reachable from the Docker host.
IMMICH_URL=http://immich.local:2283

# Local deployment paths and names. Most users can keep these defaults.
KIOSK_CONFIG_FILE=./config/config.yaml
KIOSK_API_KEY_FILE=./secrets/immich_api_key
KIOSK_IMAGE=local/immich-kiosk:0.42.0-lenovo-curation1
KIOSK_CONTAINER_NAME=immich-kiosk
KIOSK_PORT=3000

# Pin the upstream source and identify the patched binary.
KIOSK_UPSTREAM_REF=v0.42.0
KIOSK_VERSION=0.42.0-lenovo-curation1

# Used for date ranges and metadata formatting.
TZ=Etc/UTC
